import models.effect.Effect@bxeffect;
import java.util.concurrent.CountDownLatch;
import java.util.concurrent.TimeUnit;
import java.net.URI;

class extends="testbox.system.BaseSpec" {
	function run() {
		describe( title: "ColdBox application runtime ownership", body: () => {
			it( "serves the example entry point through the full ColdBox response pipeline", () => {
				var accepted = sendRequest( "name=Ada", "/examples/coldbox/Index.bxm" );
				expect( accepted.status ).toBe( 200 );
				expect( accepted.body.greeting ).toBe( "Hello, Ada!" );
				var rejected = sendRequest( "name=", "/examples/coldbox/Index.bxm" );
				expect( rejected.status ).toBe( 400 );
				expect( rejected.body._tag ).toBe( "InvalidName" );
			} );

			it( "dispatches the real handler with injected services and expected HTTP outcomes", () => {
				var accepted = sendRequest( "name=Ada" );
				expect( accepted.status ).toBe( 200 );
				expect( accepted.body.greeting ).toBe( "Hello, Ada!" );
				var rejected = sendRequest( "name=" );
				expect( rejected.status ).toBe( 400 );
				expect( rejected.body._tag ).toBe( "InvalidName" );
			} );

			it( "closes old work before service teardown and replaces the runtime on native reinit", () => {
				var oldController = application.cbController;
				var managed = oldController.getWireBox().getInstance( "BXEffectRuntime" );
				var provider = oldController.getCacheBox().getCache( "default" );
				var entered = new CountDownLatch( 1 );
				var released = new CountDownLatch( 1 );
				var pending = futureNew();
				var rootFiber = managed.runFork( Effect::fromBoxFuture( () => { entered.countDown(); return pending; } )
					.ensuring( Effect::sync( () => {
						provider.set( "bxeffect/cleanup", "before framework shutdown" );
						released.countDown();
						return null;
					} ) ) );
				try {
					expect( entered.await( 5, TimeUnit::SECONDS ) ).toBeTrue();
					oldController.setSetting( "reinitPassword", hash( "test-reinit" ) );
					var accepted = sendRequest( "name=Grace&fwreinit=test-reinit" );
					expect( accepted.status ).toBe( 200 );
					expect( accepted.body.greeting ).toBe( "Hello, Grace!" );
					expect( managed.isClosed() ).toBeTrue();
					expect( released.getCount() ).toBe( 0 );
					expect( rootFiber.terminationFuture().get( 5000 ).cause().kind() ).toBe( "Interrupt" );
					var replacement = application.cbController.getWireBox().getInstance( "BXEffectRuntime" );
					expect( replacement.isClosed() ).toBeFalse();
				} finally {
					managed.close();
				}
			} );

			it( "forwards application end through ColdBox and closes the mapped runtime", () => {
				var managed = application.cbController.getWireBox().getInstance( "BXEffectRuntime" );
				try { new examples.coldbox.Application().onApplicationEnd( application ); }
				finally {
					structDelete( application, "cbBootstrap" );
				}
				expect( managed.isClosed() ).toBeTrue();
				expect( managed.runSyncExit( Effect::succeed( 1 ) ).cause().error()._tag ).toBe( "ManagedRuntimeClosed" );
			} );
		}, skip: !isDefined( "cgi.server_port" ) );
	}

	/**
	 * Sends a bounded real request to the loopback test host and decodes its JSON response.
	 * @queryString Query parameters for the actual example handler and native reinit check.
	 * @path Web entry point or the test dispatch fixture.
	 */
	private struct function sendRequest( required string queryString, string path = "/tests/frameworks/Dispatch.bxm" ) {
		var connection = URI::create( "http://127.0.0.1:#cgi.server_port##arguments.path#?#arguments.queryString#" ).toURL().openConnection();
		connection.setConnectTimeout( 5000 );
		connection.setReadTimeout( 20000 );
		try {
			var status = connection.getResponseCode();
			var responseStream = status >= 400 ? connection.getErrorStream() : connection.getInputStream();
			try { return { status: status, body: JSONDeserialize( new java.lang.String( responseStream.readAllBytes(), "UTF-8" ) ) }; }
			finally {
				responseStream.close();
			}
		} finally {
			connection.disconnect();
		}
	}
}
