import models.effect.Effect@bxeffect;
import models.effect.EffectRuntime@bxeffect;
import models.effect.Schedule@bxeffect;
import models.effect.observability.LoggingObserver@bxeffect;
import java.util.concurrent.atomic.AtomicBoolean;
import tests.resources.AsyncTestSupport;
import tests.resources.RecordingLogger;

class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "Runtime observer boundary", () => {

			it( "rejects invalid logging targets with an observability exception", () => {
				expect( () => LoggingObserver::make( [] ) )
					.toThrow( type: "bxeffect.observability.InvalidLoggingObserverTargetException" );
			} );

			it( "adapts observer events to an existing logger without affecting outcomes", () => {
				var logger = new RecordingLogger();
				var observer = LoggingObserver::make( logger, {
					"runtime:started" : "trace",
					"runtime:completed" : "debug"
				} );
				var runtime = new EffectRuntime( { observer: observer } );

				expect( runtime.runSync( Effect::succeed( 42 ) ) ).toBe( 42 );
				expect( logger.entries()[ 1 ].level ).toBe( "trace" );
				expect( logger.entries().last().level ).toBe( "debug" );
				expect( logger.entries()[ 1 ].message ).toInclude( "runtime:started" );
				expect( () => LoggingObserver::make( logger, { "*": "fatal" } ) )
					.toThrow( type: "bxeffect.observability.InvalidLoggingObserverLevelException" );
			} );

			it( "reports stable runtime, suspension, scope, and retry events", () => {
				var events = [];
				var runtime = new EffectRuntime( {
					observer : ( eventName, details ) => events.append( eventName )
				} );
				var attempts = 0;
				var retried = Effect::sync( () => {
					attempts++;
					return attempts;
				} ).flatMap( ( value ) => value == 1 ? Effect::fail( "retry" ) : Effect::succeed( value ) )
					.retry( Schedule::recurs( 1 ) );
				var program = Effect::fromBoxFuture( () => futureNew( "ready" ) )
					.flatMap( ( ignored ) => retried );

				expect( runtime.runSync( program ) ).toBe( 2 );
				expect( events[ 1 ] ).toBe( "runtime:started" );
				expect( listFind( events.toList(), "effect:suspended" ) > 0 ).toBeTrue();
				expect( listFind( events.toList(), "effect:resumed" ) > 0 ).toBeTrue();
				expect( listFind( events.toList(), "retry:scheduled" ) > 0 ).toBeTrue();
				expect( events[ events.len() - 1 ] ).toBe( "scope:closed" );
				expect( events[ events.len() ] ).toBe( "runtime:completed" );
			} );

			it( "preserves resume events and cleanup when a native future factory throws", () => {
				var failFactory = () => {
					throw( type: "bxeffect.testing.FutureFactoryDefectException", message: "factory failed" );
				};
				for ( var instructionKind in [ "AsyncFuture", "Sleep" ] ) {
					var events = [];
					var runtime = new EffectRuntime( {
						clock : { sleep: failFactory },
						observer : ( eventName, details ) => {
							if ( eventName == "effect:suspended" || eventName == "effect:resumed" ) {
								events.append( "#eventName#:#details.instruction#" );
							}
						}
					} );
					var program = instructionKind == "Sleep"
						? Effect::sleep( 1 )
						: Effect::fromBoxFuture( failFactory );
					var outcome = runtime.runSyncExit( program.ensuring(
						Effect::sync( () => events.append( "cleanup" ) )
					) );

					expect( outcome.isFailure() ).toBeTrue();
					expect( outcome.cause().kind() ).toBe( "Die" );
					expect( outcome.cause().defect().type ).toBe( "bxeffect.testing.FutureFactoryDefectException" );
					expect( events ).toBe( [ "effect:resumed:#instructionKind#", "cleanup" ] );
				}
			} );

			it( "contains observer failures without changing cleanup or outcomes", () => {
				var finalized = false;
				var runtime = new EffectRuntime( {
					observer : ( eventName, details ) => {
						throw( type: "bxeffect.testing.ObserverFailureException", message: "diagnostic failure" );
					}
				} );
				var program = Effect::succeed( "value" ).ensuring(
					Effect::sync( () => {
						finalized = true;
						return null;
					} )
				);

				expect( runtime.runSync( program ) ).toBe( "value" );
				expect( finalized ).toBeTrue();
			} );

			it( "reports Fiber completion, interruption, and terminal defects", () => {
				var events = [];
				var runtime = new EffectRuntime( {
					observer : ( eventName, details ) => events.append( {
						name : eventName,
						details : details
					} )
				} );

				var completedFiber = runtime.runFork( Effect::succeed( "ready" ) );
				expect( completedFiber.join() ).toBe( "ready" );

				var nestedFuture = futureNew();
				var nestedStarted = new AtomicBoolean( false );
				var interruptedFiber = runtime.runFork( Effect::fromBoxFuture( () => {
					nestedStarted.set( true );
					return nestedFuture;
				} ) );
				AsyncTestSupport::awaitCondition( () => nestedStarted.get() );
				interruptedFiber.interrupt();
				interruptedFiber.await();
				AsyncTestSupport::awaitCondition( () => countEvents( events, "fiber:interrupted" ) == 1 );

				var defectExit = runtime.runSyncExit( Effect::sync( () => {
					throw( type: "bxeffect.testing.ObserverTestDefectException", message: "broken" );
				} ) );

				expect( countEvents( events, "fiber:completed" ) ).toBe( 1 );
				expect( defectExit.isFailure() ).toBeTrue();
				expect( countEvents( events, "defect:unhandled" ) ).toBe( 1 );

				expect( runtime.runSync( Effect::sync( () => {
					throw( type: "bxeffect.testing.ObserverRecoveredDefectException", message: "recovered" );
				} ).catchCause( ( ignoredCause ) => Effect::succeed( "recovered" ) ) ) )
					.toBe( "recovered" );
				expect( countEvents( events, "defect:unhandled" ) ).toBe( 1 );
			} );

		} );
	}

	private numeric function countEvents( required array events, required string eventName ) {
		var count = 0;
		for ( var event in arguments.events ) {
			if ( event.name == arguments.eventName ) {
				count++;
			}
		}
		return count;
	}

}
