import models.effect.Effect@bxeffect;
import models.effect.EffectRuntime@bxeffect;
import models.effect.Schedule@bxeffect;
import models.effect.context.ServiceTag@bxeffect;
import models.effect.testing.TestClock@bxeffect;
import tests.resources.AsyncTestSupport;
import java.lang.System;

class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "Runtime Clock and TestClock", () => {

			it( "honors a live delay through the native delayed executor", () => {
				var startedAt = System.nanoTime();
				expect( Effect::runSync( Effect::sleep( 80 ) ) ).toBeNull();
				expect( ( System.nanoTime() - startedAt ) / 1000000 ).toBeGTE( 75 );
			} );

			it( "does not time out work before the live deadline", () => {
				var outcome = Effect::runFutureExit( Effect::sleep( 20 ).as( "ready" ).timeout( 500 ) ).get( 3000 );
				expect( outcome.isSuccess() ).toBeTrue();
				expect( outcome.value() ).toBe( "ready" );
				var startedAt = System.nanoTime();
				var timedOut = Effect::runFutureExit( Effect::sleep( 1000 ).timeout( 80 ) ).get( 3000 );
				expect( ( System.nanoTime() - startedAt ) / 1000000 ).toBeGTE( 75 );
				expect( timedOut.cause().kind() ).toBe( "Fail" );
				expect( timedOut.cause().error()._tag ).toBe( "TimeoutError" );
			} );

			it( "completes zero sleeps and count-only recurrence without advancing time", () => {
				var clock = new TestClock();
				var completed = clock.sleep( 0 );
				expect( completed.isDone() ).toBeTrue();
				expect( completed.get( 1000 ) ).toBeNull();
				expect( clock.pendingCount() ).toBe( 0 );
				var runtime = new EffectRuntime( { clock: clock } );
				var repeats = 0;
				var repeated = runtime.runFutureExit( Effect::sync( () => ++repeats ).repeat( Schedule::recurs( 2 ) ) ).get( 3000 );
				expect( repeated.value() ).toBe( 3 );
				var attempts = 0;
				var retried = runtime.runFutureExit( Effect::suspend( () =>
					++attempts < 3 ? Effect::fail( "again" ) : Effect::succeed( attempts )
				).retry( Schedule::recurs( 2 ) ) ).get( 3000 );
				expect( retried.value() ).toBe( 3 );
				expect( clock.now() ).toBe( 0 );
			} );

			it( "skips fixed schedule backlogs after one immediate restart", () => {
				for ( var policy in [
					Schedule::fixed( 10 ),
					Schedule::fixed( 10 ).or( Schedule::recurs( 0 ) ),
					Schedule::fixed( 10 ).jittered( 1, 1 )
				] ) {
					var clock = new TestClock();
					var starts = new java.util.concurrent.CopyOnWriteArrayList();
					var runtime = new EffectRuntime( { clock: clock } );
					var program = Effect::sync( () => {
						starts.add( clock.now() );
						if ( starts.size() == 1 ) { clock.advance( 35 ); }
						return null;
					} ).repeat( policy.and( Schedule::recurs( 2 ) ) );
					var fiber = runtime.runFork( program );
					try {
						awaitPending( clock, 1 );
						expect( starts.toArray() ).toBe( [ 0, 35 ] );
						clock.advance( 10 );
						expect( fiber._terminationFuture().get( 3000 ).isSuccess() ).toBeTrue();
						expect( starts.toArray() ).toBe( [ 0, 35, 45 ] );
					} finally {
						fiber.interrupt();
						fiber._terminationFuture().get( 3000 );
					}
				}
			} );

			it( "completes TestClock sleepers only when time advances", () => {
				var clock = new TestClock();
				var later = clock.sleep( 20 );
				var earlier = clock.sleep( 1, "seconds" );

				expect( clock.pendingCount() ).toBe( 2 );
				expect( clock.advance( 20 ) ).toBe( 1 );
				expect( later.isDone() ).toBeTrue();
				expect( earlier.isDone() ).toBeFalse();
				expect( clock.advance( 980 ) ).toBe( 1 );
				expect( earlier.isDone() ).toBeTrue();
				expect( clock.now() ).toBe( 1000 );
			} );

			it( "coordinates concurrent sleeper registration and advancement", () => {
				var clock = new TestClock();
				var runtime = new EffectRuntime( { clock: clock } );
				var fibers = [];
				for ( var index = 1; index <= 32; index++ ) {
					fibers.append( runtime.runFork( Effect::sleep( 100 ).as( index ) ) );
				}

				awaitPending( clock, 32 );
				expect( clock.advance( 100 ) ).toBe( 32 );
				for ( var index = 1; index <= fibers.len(); index++ ) {
					expect( fibers[ index ].join() ).toBe( index );
				}
				expect( clock.pendingCount() ).toBe( 0 );
			} );

			it( "runs Effect sleep through the configured TestClock", () => {
				var clock = new TestClock();
				var runtime = new EffectRuntime( { clock: clock } );
				var fiber = runtime.runFork( Effect::sleep( 10 ).as( "done" ) );

				awaitPending( clock, 1 );
				clock.advance( 10 );
				expect( fiber.join() ).toBe( "done" );
			} );

			it( "distinguishes fixed recurrence starts from spaced completion delays", () => {
				var fixedClock = new TestClock();
				var fixedStarts = [];
				var fixedRuntime = new EffectRuntime( { clock: fixedClock } );
				var fixedFiber = fixedRuntime.runFork(
					timedWork( fixedClock, fixedStarts )
						.repeat( Schedule::fixed( 10 ).and( Schedule::recurs( 1 ) ) )
				);

				awaitPending( fixedClock, 1 );
				fixedClock.advance( 8 );
				awaitPending( fixedClock, 1 );
				fixedClock.advance( 2 );
				awaitPending( fixedClock, 1 );
				fixedClock.advance( 8 );
				fixedFiber.join();

				var spacedClock = new TestClock();
				var spacedStarts = [];
				var spacedRuntime = new EffectRuntime( { clock: spacedClock } );
				var spacedFiber = spacedRuntime.runFork(
					timedWork( spacedClock, spacedStarts )
						.repeat( Schedule::spaced( 10 ).and( Schedule::recurs( 1 ) ) )
				);

				awaitPending( spacedClock, 1 );
				spacedClock.advance( 8 );
				awaitPending( spacedClock, 1 );
				spacedClock.advance( 10 );
				awaitPending( spacedClock, 1 );
				spacedClock.advance( 8 );
				spacedFiber.join();

				expect( fixedStarts ).toBe( [ 0, 10 ] );
				expect( spacedStarts ).toBe( [ 0, 18 ] );
			} );

			it( "drives retry delays through the configured TestClock", () => {
				var clock = new TestClock();
				var runtime = new EffectRuntime( { clock: clock } );
				var attempts = 0;
				var program = Effect::sync( () => {
					attempts++;
					return attempts;
				} ).flatMap( ( attemptNumber ) =>
					attemptNumber == 1 ? Effect::fail( "retry" ) : Effect::succeed( attemptNumber )
				).retry( Schedule::spaced( 10 ) );
				var fiber = runtime.runFork( program );

				awaitPending( clock, 1 );
				clock.advance( 10 );
				expect( fiber.join() ).toBe( 2 );
				expect( attempts ).toBe( 2 );
			} );

			it( "does not retry after a waiting Fiber is interrupted", () => {
				var clock = new TestClock();
				var runtime = new EffectRuntime( { clock: clock } );
				var attempts = 0;
				var program = Effect::sync( () => {
					attempts++;
					return null;
				} ).flatMap( ( ignored ) => Effect::fail( "retry" ) )
					.retry( Schedule::spaced( 100 ) );
				var fiber = runtime.runFork( program );

				awaitPending( clock, 1 );
				fiber.interrupt();
				var exit = fiber.await();

				expect( exit.isFailure() ).toBeTrue();
				expect( exit.cause().kind() ).toBe( "Interrupt" );
				expect( attempts ).toBe( 1 );
			} );

			it( "cancels an active TestClock sleep without resuming user work", () => {
				var clock = new TestClock();
				var runtime = new EffectRuntime( { clock: clock } );
				var resumed = false;
				var fiber = runtime.runFork(
					Effect::sleep( 100 ).tap( ( ignored ) => Effect::sync( () => {
						resumed = true;
						return null;
					} ) )
				);

				awaitPending( clock, 1 );
				fiber.interrupt();
				var exit = fiber.await();
				clock.advance( 100 );

				expect( exit.isFailure() ).toBeTrue();
				expect( exit.cause().kind() ).toBe( "Interrupt" );
				expect( clock.pendingCount() ).toBe( 0 );
				expect( resumed ).toBeFalse();
			} );

			it( "drives timeout through the configured TestClock", () => {
				var clock = new TestClock();
				var runtime = new EffectRuntime( { clock: clock } );
				var fiber = runtime.runFork( Effect::sleep( 100 ).timeout( 10 ) );

				awaitPending( clock, 2 );
				clock.advance( 10 );
				var exit = fiber.await();

				expect( exit.isFailure() ).toBeTrue();
				expect( exit.cause().kind() ).toBe( "Fail" );
				expect( exit.cause().error()._tag ).toBe( "TimeoutError" );
			} );

			it( "restores outer Context after timeout interrupts provided work", () => {
				var clock = new TestClock();
				var runtime = new EffectRuntime( { clock: clock } );
				var label = ServiceTag::of( "app/TimeoutContextLabel" );
				var program = Effect::sleep( 100 )
					.timeout( 10 )
					.provideService( label, "inner" )
					.catchAll( ( timeoutError ) => Effect::service( label ) )
					.provideService( label, "outer" );
				var fiber = runtime.runFork( program );

				awaitPending( clock, 2 );
				clock.advance( 10 );
				expect( fiber.join() ).toBe( "outer" );
			} );

		} );
	}

	private function awaitPending( required TestClock clock, required numeric expectedCount ) {
		var clockToCheck = arguments.clock;
		var countToAwait = arguments.expectedCount;
		AsyncTestSupport::awaitCondition(
			() => clockToCheck.pendingCount() >= countToAwait
		);
		expect( clockToCheck.pendingCount() ).toBe( countToAwait );
	}

	private function timedWork( required TestClock clock, required array starts ) {
		var clockToRead = arguments.clock;
		var startsToRecord = arguments.starts;
		return Effect::sync( () => {
			startsToRecord.append( clockToRead.now() );
			return null;
		} ).flatMap( ( ignored ) => Effect::sleep( 8 ) );
	}

}
