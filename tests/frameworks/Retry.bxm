<bx:script>
counter = cache().getOrSet( "bxeffect/http-retry/" & url.key, () => new java.util.concurrent.atomic.AtomicInteger(), 60 );
number = counter.incrementAndGet();
bx:header statusCode=( number == 1 ? 503 : 200 );
bx:content type="application/json";
writeOutput( JSONSerialize( { attempt: number } ) );
</bx:script>
