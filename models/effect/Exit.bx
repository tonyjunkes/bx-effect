import bxModules.bxEffect.models.effect.Cause;

/**
 * The complete result of running an Effect.
 * Success carries a value; failure carries a Cause preserving expected errors,
 * defects, and interruption. Inspect the branch before using payload accessors.
 */
class {

	variables.exitKind = "";
	variables.exitValue = null;

	/**
	 * Stores a complete runtime outcome; prefer the named constructors.
	 *
	 * @exitKind Internal Success or Failure discriminator.
	 * @exitValue Success value or complete failure Cause.
	 * @return This Exit.
	 */
	any function init( required string exitKind, any exitValue ) {
		variables.exitKind = arguments.exitKind;
		if ( structKeyExists( arguments, "exitValue" ) ) {
			variables.exitValue = arguments.exitValue;
		}
		return this;
	}

	/**
	 * Wraps the successful result of execution.
	 *
	 * @value Value carried by this operation; may be null.
	 * @return A successful Exit.
	 */
	static any function success( any value ) {
		return new Exit( exitKind: "Success", exitValue: arguments.value );
	}

	/**
	 * Wraps the complete failure tree without losing failure channels.
	 *
	 * @failureCause Complete Cause to preserve, including composite structure.
	 * @return A failed Exit.
	 */
	static any function failure( required Cause failureCause ) {
		return new Exit( exitKind: "Failure", exitValue: arguments.failureCause );
	}

	/**
	 * Tests the outcome branch.
	 *
	 * @return Whether execution succeeded.
	 */
	boolean function isSuccess() {
		return variables.exitKind == "Success";
	}

	/**
	 * Tests the outcome branch.
	 *
	 * @return Whether execution failed for any Cause.
	 */
	boolean function isFailure() {
		return variables.exitKind == "Failure";
	}

	/**
	 * Reads the stored payload; callers should check isSuccess before using it as a success value.
	 *
	 * @return The payload, which is a Cause on failure.
	 */
	any function value() {
		return variables.exitValue;
	}

	/**
	 * Reads the stored payload; callers should check isFailure before using it as a Cause.
	 *
	 * @return The payload, which is the success value on success.
	 */
	any function cause() {
		return variables.exitValue;
	}

	/**
	 * Calls the success handler with its value or the failure handler with the complete Cause.
	 *
	 * @onSuccess Callback receiving the success value.
	 * @onFailure Callback receiving the complete failure Cause.
	 * @return The selected handler result.
	 */
	any function match( required function onSuccess, required function onFailure ) {
		return isSuccess()
			? arguments.onSuccess( variables.exitValue )
			: arguments.onFailure( variables.exitValue );
	}

}
