import bxModules.bxEffect.models.effect.context.Context;

/**
 * Owns Effect finalizers for one runtime execution.
 *
 * Finalizers are returned in LIFO order on close. A closed Scope rejects new
 * finalizers so resource acquisition cannot silently leak after completion.
 * Child admission closes separately so shutdown can await child finalization
 * before the runtime drains and executes the finalizer entries.
 */
class {

	variables.finalizers = new java.util.concurrent.ConcurrentLinkedDeque();
	variables.children = new java.util.concurrent.ConcurrentLinkedDeque();
	variables.closed = new java.util.concurrent.atomic.AtomicBoolean( false );
	variables.acceptingChildren = new java.util.concurrent.atomic.AtomicBoolean( true );
	variables.lock = new java.util.concurrent.locks.ReentrantLock();

	/**
	 * Registers cleanup and its Context atomically; closed Scopes reject registration.
	 *
	 * @finalizer Zero-argument callback returning the cleanup Effect.
	 * @finalizerContext Context captured at the cleanup boundary or registration site.
	 * @return This Scope.
	 */
	Scope function addFinalizer( required function finalizer, required Context finalizerContext ) {
		var finalizerToAdd = arguments.finalizer;
		var contextToAdd = arguments.finalizerContext;
		withOpenScope( () => variables.finalizers.push( {
			finalizer : finalizerToAdd,
			context : contextToAdd
		} ) );
		return this;
	}

	/**
	 * Registers a successfully acquired resource with its release callback and Context.
	 *
	 * @release Callback receiving the acquired resource and returning its cleanup Effect.
	 * @resource Successfully acquired value captured for use or release.
	 * @finalizerContext Context captured at the cleanup boundary or registration site.
	 * @return This Scope.
	 */
	Scope function addRelease(
		required function release,
		any resource,
		required Context finalizerContext
	) {
		var releaseToAdd = arguments.release;
		var resourceToAdd = arguments.resource;
		var contextToAdd = arguments.finalizerContext;
		withOpenScope( () => variables.finalizers.push( {
			kind : "Release",
			release : releaseToAdd,
			resource : resourceToAdd,
			context : contextToAdd
		} ) );
		return this;
	}

	/**
	 * Admits an existing Fiber while child admission remains open.
	 *
	 * @fiber Existing child Fiber to admit into the Scope.
	 * @return This Scope.
	 */
	Scope function addChild( required any fiber ) {
		var childToAdd = arguments.fiber;
		withChildAdmission( () => variables.children.add( childToAdd ) );
		return this;
	}

	/**
	 * Creates and registers a child under the admission lock to prevent escape during shutdown.
	 *
	 * @factory Zero-argument callback that starts and returns the new child Fiber.
	 * @return The newly admitted Fiber.
	 */
	any function _forkChild( required function factory ) {
		var childFactory = arguments.factory;
		return withChildAdmission( () => {
			var childFiber = childFactory();
			variables.children.add( childFiber );
			var childToRemove = childFiber;
			childFiber._terminationFuture().then( ( ignored ) => {
				variables.children.remove( childToRemove );
				return null;
			} );
			return childFiber;
		} );
	}

	/**
	 * Requests best-effort interruption of current children without closing admission or awaiting termination.
	 *
	 * @return This Scope.
	 */
	Scope function interruptChildren() {
		for ( var childFiber in variables.children ) {
			if ( !childFiber.isDone() ) {
				childFiber.interrupt();
			}
		}
		return this;
	}

	/**
	 * Stops child admission, interrupts admitted children, and waits for interpreter finalization.
	 *
	 * @return This Scope.
	 */
	Scope function _shutdownChildren() {
		variables.lock.lock();
		try {
			variables.acceptingChildren.set( false );
			var childrenToStop = [];
			for ( var childFiber in variables.children ) {
				childrenToStop.append( childFiber );
			}
		} finally {
			variables.lock.unlock();
		}

		for ( var childFiber in childrenToStop ) {
			if ( !childFiber.isDone() ) {
				childFiber.interrupt();
			}
		}
		for ( var childFiber in childrenToStop ) {
			// Never wait while holding the admission lock: child cleanup may need it.
			childFiber._awaitTermination();
		}
		return this;
	}

	/**
	 * Atomically closes admission and drains finalizer entries in LIFO order; the caller executes those entries.
	 *
	 * @return Finalizer entries on first close, otherwise an empty array.
	 */
	array function close() {
		variables.lock.lock();
		try {
			if ( variables.closed.get() ) {
				return [];
			}

			variables.closed.set( true );
			variables.acceptingChildren.set( false );
			var finalizersToRun = [];
			var nextFinalizer = variables.finalizers.poll();
			while ( !isNull( nextFinalizer ) ) {
				finalizersToRun.append( nextFinalizer );
				nextFinalizer = variables.finalizers.poll();
			}
			variables.children.clear();
			return finalizersToRun;
		} finally {
			variables.lock.unlock();
		}
	}

	/**
	 * Reads finalizer-registration closure state.
	 *
	 * @return Whether close has run.
	 */
	boolean function isClosed() {
		return variables.closed.get();
	}

	/**
	 * Runs a registration operation under the lock or throws ScopeClosedException.
	 *
	 * @operation Zero-argument callback executed while the Scope lock and admission check are held.
	 * @return The operation result.
	 */
	private any function withOpenScope( required function operation ) {
		variables.lock.lock();
		try {
			if ( variables.closed.get() ) {
				throw(
					type: "bxeffect.ScopeClosedException",
					message: "Cannot add work to a closed Scope"
				);
			}
			return arguments.operation();
		} finally {
			variables.lock.unlock();
		}
	}

	/**
	 * Runs child creation/admission under the lock or throws ScopeClosedException if closing.
	 *
	 * @operation Zero-argument callback executed while the Scope lock and admission check are held.
	 * @return The operation result.
	 */
	private any function withChildAdmission( required function operation ) {
		variables.lock.lock();
		try {
			if ( variables.closed.get() || !variables.acceptingChildren.get() ) {
				throw(
					type: "bxeffect.ScopeClosedException",
					message: "Cannot add work to a closing or closed Scope"
				);
			}
			return arguments.operation();
		} finally {
			variables.lock.unlock();
		}
	}

}
