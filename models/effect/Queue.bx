import bxModules.bxEffect.models.effect.Effect;
import ortus.boxlang.runtime.dynamic.Attempt;

/**
 * An Effect-aware FIFO queue with explicit shutdown semantics.
 *
 * Mutable queue state is guarded by JDK ReentrantLock conditions. Blocking
 * operations run as interruptible runtime instructions, never worker futures.
 * Shutdown rejects offers and wakes waiters, but existing values remain
 * available until drained. poll/size/isShutdown inspect state immediately;
 * offer/take/shutdown describe lazy Effects.
 */
class {

	variables.capacity = -1;
	variables.items = new java.util.ArrayDeque();
	variables.lock = new java.util.concurrent.locks.ReentrantLock();
	variables.notEmpty = variables.lock.newCondition();
	variables.notFull = variables.lock.newCondition();
	variables.shutdown = false;

	/**
	 * Creates an application-owned FIFO buffer with explicit shutdown.
	 *
	 * @capacity Positive whole buffer capacity; internal constructors also accept -1 for unbounded.
	 */
	Queue function init( numeric capacity = -1 ) {
		if (
			arguments.capacity == 0
			|| arguments.capacity < -1
			|| int( arguments.capacity ) != arguments.capacity
		) {
			throw(
				type: "bxeffect.InvalidQueueCapacityException",
				message: "Queue capacity must be a positive whole number or unbounded"
			);
		}
		variables.capacity = arguments.capacity;
		return this;
	}

	/**
	 * Creates a Queue whose offers wait when its positive capacity is reached.
	 *
	 * @capacity Positive whole maximum number of buffered values per consumer.
	 */
	static Queue function bounded( required numeric capacity ) {
		if ( arguments.capacity <= 0 || int( arguments.capacity ) != arguments.capacity ) {
			throw(
				type: "bxeffect.InvalidQueueCapacityException",
				message: "Queue capacity must be a positive whole number"
			);
		}
		return new Queue( arguments.capacity );
	}

	/**
	 * Creates a Queue without capacity backpressure.
	 */
	static Queue function unbounded() {
		return new Queue();
	}

	/**
	 * Describes an interruptible offer; offers after shutdown fail with QueueShutdown.
	 *
	 * @value Non-null message; null is rejected as a defect at execution.
	 */
	Effect function offer( any value ) {
		return Effect::offerQueueInstruction( this, arguments.value );
	}

	/**
	 * Describes an interruptible FIFO take; a shut down Queue drains before failing with QueueShutdown.
	 */
	Effect function take() {
		return Effect::takeQueueInstruction( this );
	}

	/**
	 * Immediately removes the oldest buffered value, including after shutdown, without waiting.
	 */
	Attempt function poll() {
		variables.lock.lock();
		try {
			if ( variables.items.isEmpty() ) {
				return attempt();
			}
			var entry = variables.items.removeFirst();
			variables.notFull.signal();
			return attempt( entry.value );
		} finally {
			variables.lock.unlock();
		}
	}

	/**
	 * Describes idempotent shutdown, waking waiters while retaining buffered values for draining.
	 */
	Effect function shutdown() {
		return Effect::sync( () => shutdownNative() );
	}

	/**
	 * Reads the shutdown flag under the Queue lock.
	 */
	boolean function isShutdown() {
		variables.lock.lock();
		try {
			return variables.shutdown;
		} finally {
			variables.lock.unlock();
		}
	}

	/**
	 * Reads the buffered item count under the Queue lock.
	 */
	numeric function size() {
		variables.lock.lock();
		try {
			return variables.items.size();
		} finally {
			variables.lock.unlock();
		}
	}

	/**
	 * Waits under the Queue lock for capacity and enqueues one value unless interrupted or closed.
	 *
	 * @value Non-null message; null is rejected as a defect at execution.
	 * @controlState Optional FiberControl; null means no Fiber cancellation tracking.
	 */
	struct function offerNative( any value, any controlState = null ) {
		if ( isNull( arguments.value ) ) {
			throw( type: "bxeffect.InvalidQueueValueException", message: "Queue values must be non-null; poll uses Attempt for absence" );
		}
		variables.lock.lockInterruptibly();
		try {
			while ( !variables.shutdown && isFull() ) {
				// Conditions can wake spuriously or lose capacity to another producer.
				// Recheck both capacity and shutdown under the lock on every wake.
				if ( wasInterrupted( arguments.controlState ) ) {
					return { isShutdown: false, isInterrupted: true };
				}
				variables.notFull.await();
			}
			if ( wasInterrupted( arguments.controlState ) ) {
				return { isShutdown: false, isInterrupted: true };
			}
			if ( variables.shutdown ) {
				return { isShutdown: true, isInterrupted: false };
			}
			variables.items.addLast( { value: arguments.value } );
			// Keep the message envelope private to native buffer operations.
			variables.notEmpty.signal();
			return { isShutdown: false, isInterrupted: false };
		} finally {
			variables.lock.unlock();
		}
	}

	/**
	 * Waits under the Queue lock for an item or shutdown, preserving buffered values for draining.
	 *
	 * @controlState Optional FiberControl; null means no Fiber cancellation tracking.
	 */
	struct function takeNative( any controlState = null ) {
		variables.lock.lockInterruptibly();
		try {
			while ( variables.items.isEmpty() && !variables.shutdown ) {
				if ( wasInterrupted( arguments.controlState ) ) {
					return { isShutdown: false, isInterrupted: true };
				}
				variables.notEmpty.await();
			}
			if ( wasInterrupted( arguments.controlState ) ) {
				return { isShutdown: false, isInterrupted: true };
			}
			if ( variables.items.isEmpty() ) {
				return { isShutdown: true, isInterrupted: false };
			}
			// Shutdown ends takes only after the buffer is empty.
			var entry = variables.items.removeFirst();
			variables.notFull.signal();
			return { isShutdown: false, isInterrupted: false, value: entry.value };
		} finally {
			variables.lock.unlock();
		}
	}

	/**
	 * Checks capacity while the caller holds the Queue lock.
	 */
	private boolean function isFull() {
		return variables.capacity > 0 && variables.items.size() >= variables.capacity;
	}

	/**
	 * Checks optional Fiber cancellation state.
	 *
	 * @controlState Optional FiberControl; null means no Fiber cancellation tracking.
	 */
	private boolean function wasInterrupted( any controlState = null ) {
		return !isNull( arguments.controlState ) && arguments.controlState.isInterrupted();
	}

	/**
	 * Closes admission atomically and wakes both producers and consumers.
	 */
	private boolean function shutdownNative() {
		variables.lock.lock();
		try {
			if ( variables.shutdown ) {
				return false;
			}
			variables.shutdown = true;
			variables.notEmpty.signalAll();
			variables.notFull.signalAll();
			return true;
		} finally {
			variables.lock.unlock();
		}
	}

}
