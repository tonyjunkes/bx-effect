/**
 * Describes why an Effect failed.
 *
 * Cause values are immutable by contract. Expected errors, defects, and
 * interruption remain distinct all the way to an Exit.
 */
class {

	variables.causeKind = "";
	variables.causeValue = null;
	variables.leftCause = null;
	variables.rightCause = null;

	Cause function init(
		required string causeKind,
		any causeValue,
		any leftCause,
		any rightCause
	) {
		variables.causeKind = arguments.causeKind;
		if ( structKeyExists( arguments, "causeValue" ) ) {
			variables.causeValue = arguments.causeValue;
		}
		if ( structKeyExists( arguments, "leftCause" ) ) {
			variables.leftCause = arguments.leftCause;
		}
		if ( structKeyExists( arguments, "rightCause" ) ) {
			variables.rightCause = arguments.rightCause;
		}
		return this;
	}

	static function fail( required any error ) {
		return new Cause( causeKind: "Fail", causeValue: arguments.error );
	}

	static function die( required any defect ) {
		return new Cause( causeKind: "Die", causeValue: arguments.defect );
	}

	static function interrupt( required any fiberId ) {
		return new Cause( causeKind: "Interrupt", causeValue: arguments.fiberId );
	}

	static function sequential( required Cause left, required Cause right ) {
		return new Cause(
			causeKind: "Sequential",
			leftCause: arguments.left,
			rightCause: arguments.right
		);
	}

	static function parallel( required Cause left, required Cause right ) {
		return new Cause(
			causeKind: "Parallel",
			leftCause: arguments.left,
			rightCause: arguments.right
		);
	}

	string function kind() {
		return variables.causeKind;
	}

	any function error() {
		return variables.causeKind == "Fail" ? variables.causeValue : null;
	}

	any function defect() {
		return variables.causeKind == "Die" ? variables.causeValue : null;
	}

	any function fiberId() {
		return variables.causeKind == "Interrupt" ? variables.causeValue : null;
	}

	any function left() {
		return variables.leftCause;
	}

	any function right() {
		return variables.rightCause;
	}

	boolean function isFailure() {
		return containsKind( "Fail" );
	}

	boolean function isDefect() {
		return containsKind( "Die" );
	}

	boolean function isInterrupted() {
		return containsKind( "Interrupt" );
	}

	array function failures() {
		return collectValues( "Fail" );
	}

	array function defects() {
		return collectValues( "Die" );
	}

	/**
	 * Transforms only expected failures while preserving defect, interruption,
	 * sequential, and parallel structure.
	 */
	Cause function mapFailures( required function mapper ) {
		var pending = [ { node: this, visited: false } ];
		var mapped = [];
		while ( pending.len() > 0 ) {
			var frame = pending.pop();
			var currentCause = frame.node;
			if ( frame.visited ) {
				var mappedRight = mapped.pop();
				var mappedLeft = mapped.pop();
				mapped.append( currentCause.kind() == "Sequential"
					? Cause::sequential( mappedLeft, mappedRight )
					: Cause::parallel( mappedLeft, mappedRight )
				);
				continue;
			}

			if ( currentCause.kind() == "Sequential" || currentCause.kind() == "Parallel" ) {
				pending.append( { node: currentCause, visited: true } );
				pending.append( { node: currentCause.right(), visited: false } );
				pending.append( { node: currentCause.left(), visited: false } );
			} else {
				mapped.append( currentCause.kind() == "Fail"
					? Cause::fail( arguments.mapper( currentCause.error() ) )
					: currentCause
				);
			}
		}
		return mapped[ 1 ];
	}

	string function pretty() {
		var rendered = new java.lang.StringBuilder();
		var pending = [ { kind: "Cause", value: this } ];
		while ( pending.len() > 0 ) {
			var frame = pending.pop();
			if ( frame.kind == "Text" ) {
				rendered.append( frame.value );
				continue;
			}

			var currentCause = frame.value;
			switch ( currentCause.kind() ) {
				case "Fail":
					rendered.append( "Expected failure: " & renderValue( currentCause.error() ) );
					break;
				case "Die":
					rendered.append( "Defect: " & renderValue( currentCause.defect() ) );
					break;
				case "Interrupt":
					rendered.append( "Interrupted fiber: " & renderValue( currentCause.fiberId() ) );
					break;
				case "Sequential":
				case "Parallel":
					rendered.append( currentCause.kind() & "(" );
					pending.append( { kind: "Text", value: ")" } );
					pending.append( { kind: "Cause", value: currentCause.right() } );
					pending.append( { kind: "Text", value: ", " } );
					pending.append( { kind: "Cause", value: currentCause.left() } );
					break;
				default:
					rendered.append( "Unknown cause" );
			}
		}
		return rendered.toString();
	}

	private array function collectValues( required string targetKind ) {
		var values = [];
		var pending = [ this ];

		while ( pending.len() > 0 ) {
			var current = pending.pop();
			if ( current.kind() == arguments.targetKind ) {
				values.append( arguments.targetKind == "Fail" ? current.error() : current.defect() );
			} else if ( current.kind() == "Sequential" || current.kind() == "Parallel" ) {
				pending.append( current.right() );
				pending.append( current.left() );
			}
		}

		return values;
	}

	private boolean function containsKind( required string targetKind ) {
		var pending = [ this ];
		while ( pending.len() > 0 ) {
			var currentCause = pending.pop();
			if ( currentCause.kind() == arguments.targetKind ) {
				return true;
			}
			if ( currentCause.kind() == "Sequential" || currentCause.kind() == "Parallel" ) {
				pending.append( currentCause.right() );
				pending.append( currentCause.left() );
			}
		}
		return false;
	}

	private string function renderValue( required any value ) {
		if ( isStruct( arguments.value ) && structKeyExists( arguments.value, "message" ) ) {
			return arguments.value.message;
		}
		try {
			return arguments.value.toString();
		} catch ( any ignored ) {
			return JSONSerialize( arguments.value );
		}
	}

}
