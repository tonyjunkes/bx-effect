import java.util.ArrayDeque;

/**
 * Describes why an Effect failed.
 *
 * Cause values are immutable by contract. Expected errors, defects, and
 * interruption remain distinct all the way to an Exit.
 */
class {

	variables.causeKind = "";
	variables.causeValue = null;
	variables.leftCause = null;
	variables.rightCause = null;

	/**
	 * Stores an internal leaf or composite Cause; prefer the named constructors.
	 *
	 * @causeKind Internal Fail, Die, Interrupt, Sequential, or Parallel discriminator.
	 * @causeValue Leaf payload: expected error, defect, or Fiber identifier.
	 * @leftCause First child of a composite Cause; absent for a leaf.
	 * @rightCause Second child of a composite Cause; absent for a leaf.
	 */
	Cause function init(
		required string causeKind,
		any causeValue,
		any leftCause,
		any rightCause
	) {
		variables.causeKind = arguments.causeKind;
		if ( structKeyExists( arguments, "causeValue" ) ) {
			variables.causeValue = arguments.causeValue;
		}
		if ( structKeyExists( arguments, "leftCause" ) ) {
			variables.leftCause = arguments.leftCause;
		}
		if ( structKeyExists( arguments, "rightCause" ) ) {
			variables.rightCause = arguments.rightCause;
		}
		return this;
	}

	/**
	 * Creates an expected-error leaf.
	 *
	 * @error Expected application error value.
	 */
	static Cause function fail( required any error ) {
		return new Cause( causeKind: "Fail", causeValue: arguments.error );
	}

	/**
	 * Creates a defect leaf for an unexpected failure.
	 *
	 * @defect Unexpected failure value retained in the defect channel.
	 */
	static Cause function die( required any defect ) {
		return new Cause( causeKind: "Die", causeValue: arguments.defect );
	}

	/**
	 * Creates an interruption leaf identifying the affected Fiber.
	 *
	 * @fiberId Logical Fiber identifier used in interruption and diagnostics.
	 */
	static Cause function interrupt( required any fiberId ) {
		return new Cause( causeKind: "Interrupt", causeValue: arguments.fiberId );
	}

	/**
	 * Combines failures in execution order, such as a program followed by failed cleanup.
	 *
	 * @left First Cause branch, retained in order.
	 * @right Second Cause branch, retained in order.
	 */
	static Cause function sequential( required Cause left, required Cause right ) {
		return new Cause(
			causeKind: "Sequential",
			leftCause: arguments.left,
			rightCause: arguments.right
		);
	}

	/**
	 * Combines independent branch failures in the supplied order.
	 *
	 * @left First Cause branch, retained in order.
	 * @right Second Cause branch, retained in order.
	 */
	static Cause function parallel( required Cause left, required Cause right ) {
		return new Cause(
			causeKind: "Parallel",
			leftCause: arguments.left,
			rightCause: arguments.right
		);
	}

	/**
	 * Reads the node discriminator without traversing children.
	 */
	string function kind() {
		return variables.causeKind;
	}

	/**
	 * Reads an expected-error leaf.
	 */
	any function error() {
		return variables.causeKind == "Fail" ? variables.causeValue : null;
	}

	/**
	 * Reads a defect leaf.
	 */
	any function defect() {
		return variables.causeKind == "Die" ? variables.causeValue : null;
	}

	/**
	 * Reads an interruption leaf.
	 */
	any function fiberId() {
		return variables.causeKind == "Interrupt" ? variables.causeValue : null;
	}

	/**
	 * Reads the first branch of a composite.
	 */
	any function left() {
		return variables.leftCause;
	}

	/**
	 * Reads the second branch of a composite.
	 */
	any function right() {
		return variables.rightCause;
	}

	/**
	 * Searches the whole tree for an expected-error leaf.
	 */
	boolean function isFailure() {
		return containsKind( "Fail" );
	}

	/**
	 * Searches the whole tree for a defect leaf.
	 */
	boolean function isDefect() {
		return containsKind( "Die" );
	}

	/**
	 * Searches the whole tree for an interruption leaf.
	 */
	boolean function isInterrupted() {
		return containsKind( "Interrupt" );
	}

	/**
	 * Collects expected errors without flattening other channels into errors.
	 */
	array function failures() {
		return collectValues( "Fail" );
	}

	/**
	 * Collects defects from the whole tree.
	 */
	array function defects() {
		return collectValues( "Die" );
	}

	/**
	 * Rebuilds expected-error leaves iteratively while retaining all other nodes and tree structure.
	 *
	 * @mapper Callback receiving each expected error and returning its replacement; other leaves are untouched.
	 */
	Cause function mapFailures( required function mapper ) {
		var pending = new ArrayDeque();
		pending.addLast( { node: this, visited: false } );
		// The visited frame rebuilds its parent only after both children have
		// been mapped. Push right before left to preserve left-to-right order.
		var mapped = new ArrayDeque();
		while ( !pending.isEmpty() ) {
			var frame = pending.removeLast();
			var currentCause = frame.node;
			if ( frame.visited ) {
				var mappedRight = mapped.removeLast();
				var mappedLeft = mapped.removeLast();
				mapped.addLast( currentCause.kind() == "Sequential"
					? Cause::sequential( mappedLeft, mappedRight )
					: Cause::parallel( mappedLeft, mappedRight )
				);
				continue;
			}

			if ( currentCause.kind() == "Sequential" || currentCause.kind() == "Parallel" ) {
				pending.addLast( { node: currentCause, visited: true } );
				pending.addLast( { node: currentCause.right(), visited: false } );
				pending.addLast( { node: currentCause.left(), visited: false } );
			} else {
				mapped.addLast( currentCause.kind() == "Fail"
					? Cause::fail( arguments.mapper( currentCause.error() ) )
					: currentCause
				);
			}
		}
		return mapped.removeLast();
	}

	/**
	 * Renders the complete tree iteratively, including sequential and parallel structure.
	 */
	string function pretty() {
		var rendered = sb{""};
		var pending = new ArrayDeque();
		pending.addLast( { kind: "Cause", value: this } );
		// Text frames hold delimiters so even deeply nested trees render without
		// recursive string concatenation or recursive calls.
		while ( !pending.isEmpty() ) {
			var frame = pending.removeLast();
			if ( frame.kind == "Text" ) {
				rendered.append( frame.value );
				continue;
			}

			var currentCause = frame.value;
			switch ( currentCause.kind() ) {
				case "Fail":
					rendered.append( "Expected failure: " & renderValue( currentCause.error() ) );
					break;
				case "Die":
					rendered.append( "Defect: " & renderValue( currentCause.defect() ) );
					break;
				case "Interrupt":
					rendered.append( "Interrupted fiber: " & renderValue( currentCause.fiberId() ) );
					break;
				case "Sequential":
				case "Parallel":
					rendered.append( currentCause.kind() & "(" );
					pending.addLast( { kind: "Text", value: ")" } );
					pending.addLast( { kind: "Cause", value: currentCause.right() } );
					pending.addLast( { kind: "Text", value: ", " } );
					pending.addLast( { kind: "Cause", value: currentCause.left() } );
					break;
				default:
					rendered.append( "Unknown cause" );
			}
		}
		return rendered.toString();
	}

	/**
	 * Traverses leaves iteratively in left-to-right order.
	 *
	 * @targetKind Cause node kind to locate in the tree.
	 */
	private array function collectValues( required string targetKind ) {
		var values = [];
		var pending = new ArrayDeque();
		pending.addLast( this );

		while ( !pending.isEmpty() ) {
			var current = pending.removeLast();
			if ( current.kind() == arguments.targetKind ) {
				values.append( arguments.targetKind == "Fail" ? current.error() : current.defect() );
			} else if ( current.kind() == "Sequential" || current.kind() == "Parallel" ) {
				pending.addLast( current.right() );
				pending.addLast( current.left() );
			}
		}

		return values;
	}

	/**
	 * Searches iteratively and stops at the first matching node.
	 *
	 * @targetKind Cause node kind to locate in the tree.
	 */
	private boolean function containsKind( required string targetKind ) {
		var pending = new ArrayDeque();
		pending.addLast( this );
		while ( !pending.isEmpty() ) {
			var currentCause = pending.removeLast();
			if ( currentCause.kind() == arguments.targetKind ) {
				return true;
			}
			if ( currentCause.kind() == "Sequential" || currentCause.kind() == "Parallel" ) {
				pending.addLast( currentCause.right() );
				pending.addLast( currentCause.left() );
			}
		}
		return false;
	}

	/**
	 * Prefers an error message, then string conversion, then JSON serialization.
	 *
	 * @value Value carried by this operation; may be null.
	 */
	private string function renderValue( required any value ) {
		if ( isStruct( arguments.value ) && structKeyExists( arguments.value, "message" ) ) {
			return arguments.value.message;
		}
		try {
			return arguments.value.toString();
		} catch ( any ignored ) {
			return JSONSerialize( arguments.value );
		}
	}

}
