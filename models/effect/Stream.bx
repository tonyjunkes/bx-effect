import bxModules.bxEffect.models.effect.Cause;
import bxModules.bxEffect.models.effect.Effect;
import bxModules.bxEffect.models.effect.internal.StreamCursor;

/**
 * A lazy, reusable description of effectful values consumed through
 * demand-driven native-array batches.
 *
 * Operators build descriptions; runCollect/runForEach/runFold/runDrain build
 * Effects rather than execute them. Each execution opens a private cursor and
 * closes it before outer continuations or recovery. Sources are sequential,
 * with no implicit read-ahead; Queue and PubSub hubs remain application-owned.
 */
class {

	variables.opener = null;
	variables.concatParts = [];

	/**
	 * Stores a fresh-cursor factory without opening it or pulling values.
	 *
	 * @opener Zero-argument factory returning an Effect that acquires a fresh private cursor.
	 */
	Stream function init( required function opener ) {
		variables.opener = arguments.opener;
		return this;
	}

	/**
	 * Describes a Stream that ends on its first pull.
	 */
	static Stream function empty() {
		return new Stream( () => Effect::succeed( new StreamCursor(
			() => Effect::succeed( attempt() )
		) ) );
	}

	/**
	 * Describes a Stream containing one value.
	 *
	 * @value Value carried by this operation; may be null.
	 */
	static Stream function succeed( any value ) {
		return Stream::fromArray( [ arguments.value ] );
	}

	/**
	 * Describes an expected failure when the Stream is pulled.
	 *
	 * @error Expected application error value.
	 */
	static Stream function fail( required any error ) {
		var failureValue = arguments.error;
		return new Stream( () => Effect::succeed( new StreamCursor(
			() => Effect::fail( failureValue )
		) ) );
	}

	/**
	 * Copies the array structure and emits it as one batch for each fresh consumption.
	 *
	 * @values Input values in encounter order.
	 */
	static Stream function fromArray( required array values ) {
		var sourceValues = copyArray( arguments.values );
		return new Stream( () => {
			var emitted = false;
			return Effect::succeed( new StreamCursor( () => {
				if ( emitted ) {
					return Effect::succeed( attempt() );
				}
				emitted = true;
				return sourceValues.len() == 0
					? Effect::succeed( attempt() )
					: Effect::succeed( attempt( sourceValues ) );
			} ) );
		} );
	}

	/**
	 * Executes an Effect on the first pull of each consumption and emits its success once.
	 *
	 * @program Effect to execute within this operation's boundary.
	 */
	static Stream function fromEffect( required Effect program ) {
		var sourceProgram = arguments.program;
		return new Stream( () => {
			var emitted = false;
			return Effect::succeed( new StreamCursor( () => {
				if ( emitted ) {
					return Effect::succeed( attempt() );
				}
				emitted = true;
				return sourceProgram.map( ( value ) => attempt( [ value ] ) );
			} ) );
		} );
	}

	/**
	 * Defers creating a Stream until each consumer opens it.
	 *
	 * @factory Zero-argument callback returning the Stream for this consumption.
	 */
	static Stream function suspend( required function factory ) {
		var streamFactory = arguments.factory;
		return new Stream( () => Effect::suspend( () => streamFactory().openCursor() ) );
	}

	/**
	 * Generates values on demand from an effectful state transition.
	 *
	 * @initialState Starting unfold state, captured separately for each cursor's progression.
	 * @step Callback receiving state and returning an Effect of Attempt<{ value, state }>.
	 */
	static Stream function unfoldEffect( any initialState, required function step ) {
		var startingState = arguments.initialState;
		var stepFunction = arguments.step;
		return new Stream( () => {
			var cursorState = { value: startingState, done: false };
			return Effect::succeed( new StreamCursor( () => {
				if ( cursorState.done ) {
					return Effect::succeed( attempt() );
				}
				return Effect::suspend( () => stepFunction( cursorState.value ) ).map(
					( nextAttempt ) => {
						if ( !nextAttempt.isPresent() ) {
							cursorState.done = true;
							return attempt();
						}
						var next = nextAttempt.get();
						if (
							!isStruct( next )
							|| !structKeyExists( next, "value" )
							|| !structKeyExists( next, "state" )
						) {
							throw(
								type: "bxeffect.InvalidStreamUnfoldStepException",
								message: "Stream.unfoldEffect() step must yield { value, state }"
							);
						}
						cursorState.value = next.state;
						return attempt( [ next.value ] );
					}
				);
			} ) );
		} );
	}

	/**
	 * Acquires per-consumer resources with both early cursor release and an idempotent Scope fallback.
	 *
	 * @acquire Effect producing the resource; failed acquisition does not register release.
	 * @release Callback receiving the acquired resource and returning its cleanup Effect.
	 * @use Callback receiving the resource and returning the Stream to consume.
	 */
	static Stream function acquireRelease(
		required Effect acquire,
		required function release,
		required function use
	) {
		var acquireProgram = arguments.acquire;
		var releaseFunction = arguments.release;
		var useFunction = arguments.use;
		return new Stream( () => {
			var released = new java.util.concurrent.atomic.AtomicBoolean( false );
			// Cursor close releases early; Scope cleanup is the acquisition fallback.
			// Both paths share one claim, including when release itself fails.
			var releaseOnce = ( resource ) => Effect::suspend( () =>
				released.compareAndSet( false, true ) ? releaseFunction( resource ) : Effect::succeed( null )
			);
			return Effect::acquireRelease( acquireProgram, releaseOnce ).flatMap( ( resource ) =>
				Effect::suspend( () => useFunction( resource ).openCursor() ).foldCause(
					( acquisitionCause ) => Effect::haltInstruction( acquisitionCause ).ensuring( releaseOnce( resource ) ),
					( innerCursor ) => Effect::succeed( new StreamCursor(
						() => innerCursor.pull(),
						() => innerCursor.close().ensuring( releaseOnce( resource ) )
					) )
				)
			);
		} );
	}

	/**
	 * Consumes Queue values without owning or shutting down the Queue.
	 *
	 * @queueSource Application-owned Queue; this operation does not transfer ownership.
	 */
	static Stream function fromQueue( required any queueSource ) {
		var sourceQueue = arguments.queueSource;
		return new Stream( () => Effect::succeed( new StreamCursor(
			() => sourceQueue.take()
				.map( ( value ) => attempt( [ value ] ) )
				.catchTag( "QueueShutdown", ( ignored ) => Effect::succeed( attempt() ) )
		) ) );
	}

	/**
	 * Acquires one subscription per consumption and unsubscribes when its cursor closes.
	 *
	 * @pubSubSource Parent PubSub hub coordinating subscription state and waits.
	 */
	static Stream function fromPubSub( required any pubSubSource ) {
		var sourcePubSub = arguments.pubSubSource;
		return new Stream( () => Effect::acquireRelease(
			sourcePubSub.subscribe(), ( subscription ) => subscription.unsubscribe().asVoid()
		).map(
			( subscription ) => new StreamCursor(
				() => subscription.take()
					.map( ( value ) => attempt( [ value ] ) )
					.catchTag( "PubSubShutdown", ( ignored ) => Effect::succeed( attempt() ) )
					.catchTag( "SubscriptionShutdown", ( ignored ) => Effect::succeed( attempt() ) ),
				() => subscription.unsubscribe().asVoid()
			)
		) );
	}

	/**
	 * Transforms each pulled value; mapper exceptions become defects during consumption.
	 *
	 * @mapper Callback receiving a success value and returning its replacement.
	 */
	Stream function map( required function mapper ) {
		var mapValue = arguments.mapper;
		return transformCursor( ( sourceCursor ) => new StreamCursor(
			() => sourceCursor.pull().map( ( batchAttempt ) => {
				if ( !batchAttempt.isPresent() ) {
					return attempt();
				}
				var mappedValues = [];
				for ( var value in batchAttempt.get() ) {
					mappedValues.append( mapValue( value ) );
				}
				return attempt( mappedValues );
			} ),
			() => sourceCursor.close()
		) );
	}

	/**
	 * Transforms values with Effects sequentially, without implicit read-ahead.
	 *
	 * @mapper Callback receiving a value and returning an Effect producing its replacement.
	 */
	Stream function mapEffect( required function mapper ) {
		var mapValue = arguments.mapper;
		return transformCursor( ( sourceCursor ) => new StreamCursor(
			() => sourceCursor.pull().flatMap( ( batchAttempt ) =>
				!batchAttempt.isPresent()
					? Effect::succeed( attempt() )
					: Effect::forEach( batchAttempt.get(), ( value, index ) =>
						mapValue( value )
					).map( ( mappedValues ) => attempt( mappedValues ) )
			),
			() => sourceCursor.close()
		) );
	}

	/**
	 * Retains matching values and continues pulling past batches with no matches.
	 *
	 * @predicate Callback receiving a value and returning whether to retain it.
	 */
	Stream function filter( required function predicate ) {
		var keepValue = arguments.predicate;
		return transformCursor( ( sourceCursor ) => new StreamCursor(
			() => filterPull( sourceCursor, keepValue ),
			() => sourceCursor.close()
		) );
	}

	/**
	 * Runs an Effect for each value and retains the value if observation succeeds.
	 *
	 * @observer Callback receiving a success value and returning an observation Effect.
	 */
	Stream function tap( required function observer ) {
		var observeValue = arguments.observer;
		return mapEffect( ( value ) => Effect::suspend( () => observeValue( value ) ).as( value ) );
	}

	/**
	 * Limits output to a non-negative whole count and avoids further upstream pulls once satisfied.
	 *
	 * @count Non-negative whole number of elements.
	 */
	Stream function take( required numeric count ) {
		validateCount( arguments.count, "take" );
		var requested = arguments.count;
		return transformCursor( ( sourceCursor ) => {
			var takeState = { remaining: requested };
			return new StreamCursor(
				() => takePull( sourceCursor, takeState ),
				() => sourceCursor.close()
			);
		} );
	}

	/**
	 * Emits values until the first predicate failure, excluding that value.
	 *
	 * @predicate Callback receiving each value and deciding whether to continue.
	 */
	Stream function takeWhile( required function predicate ) {
		var keepValue = arguments.predicate;
		return transformCursor( ( sourceCursor ) => {
			var progress = { done: false };
			return new StreamCursor( () => {
				if ( progress.done ) {
					return Effect::succeed( attempt() );
				}
				return sourceCursor.pull().map( ( batchAttempt ) => {
					if ( !batchAttempt.isPresent() ) {
						progress.done = true;
						return attempt();
					}
					var kept = [];
					for ( var value in batchAttempt.get() ) {
						if ( !keepValue( value ) ) {
							progress.done = true;
							break;
						}
						kept.append( value );
					}
					return kept.len() == 0 ? attempt() : attempt( kept );
				} );
			}, () => sourceCursor.close() );
		} );
	}

	/**
	 * Emits the initial value, then every sequential accumulator value.
	 * Treat initial and reducer results as immutable values. Use Stream.suspend
	 * to allocate a fresh mutable seed when the application needs mutation.
	 *
	 * @initial Initial accumulator emitted before pulling the source.
	 * @reducer Callback receiving the current accumulator and next source value.
	 */
	Stream function scan( required any initial, required function reducer ) {
		var seed = arguments.initial;
		var reduceValue = arguments.reducer;
		return transformCursor( ( sourceCursor ) => {
			var progress = { first: true, value: seed };
			return new StreamCursor( () => {
				if ( progress.first ) {
					progress.first = false;
					return Effect::succeed( attempt( [ progress.value ] ) );
				}
				return sourceCursor.pull().map( ( batchAttempt ) => {
					if ( !batchAttempt.isPresent() ) {
						return attempt();
					}
					var accumulated = [];
					for ( var value in batchAttempt.get() ) {
						progress.value = reduceValue( progress.value, value );
						accumulated.append( progress.value );
					}
					return attempt( accumulated );
				} );
			}, () => sourceCursor.close() );
		} );
	}

	/**
	 * Emits native arrays of at most size values; normal completion emits a final partial group.
	 *
	 * @size Positive whole number of values per group.
	 */
	Stream function grouped( required numeric size ) {
		validateCount( arguments.size, "grouped" );
		if ( arguments.size == 0 ) {
			throw( type: "bxeffect.InvalidStreamCountException", message: "Stream.grouped() requires a positive whole size" );
		}
		var groupSize = arguments.size;
		return transformCursor( ( sourceCursor ) => {
			var progress = { batch: [], index: 1, group: [], done: false };
			return new StreamCursor(
				() => groupedPull( sourceCursor, progress, groupSize ),
				() => sourceCursor.close()
			);
		} );
	}

	/**
	 * Fills one bounded group across source batches without requesting the following group.
	 *
	 * @sourceCursor Private cursor supplying the source batches.
	 * @state Mutable progress belonging to this consumption.
	 * @size Positive whole number of values per group.
	 */
	private static Effect function groupedPull( required any sourceCursor, required struct state, required numeric size ) {
		var cursorToPull = arguments.sourceCursor;
		var progress = arguments.state;
		var groupSize = arguments.size;
		while ( progress.index <= progress.batch.len() && progress.group.len() < groupSize ) {
			progress.group.append( progress.batch[ progress.index++ ] );
		}
		if ( progress.group.len() == groupSize || progress.done ) {
			var emitted = progress.group;
			progress.group = [];
			return Effect::succeed( emitted.len() == 0 ? attempt() : attempt( [ emitted ] ) );
		}
		return cursorToPull.pull().flatMap( ( batchAttempt ) => {
			progress.done = !batchAttempt.isPresent();
			progress.batch = progress.done ? [] : batchAttempt.get();
			progress.index = 1;
			return Effect::suspend( () => groupedPull( cursorToPull, progress, groupSize ) );
		} );
	}

	/**
	 * Skips a non-negative whole count before emitting remaining values.
	 *
	 * @count Non-negative whole number of elements.
	 */
	Stream function drop( required numeric count ) {
		validateCount( arguments.count, "drop" );
		var requested = arguments.count;
		return transformCursor( ( sourceCursor ) => {
			var dropState = { remaining: requested };
			return new StreamCursor(
				() => dropPull( sourceCursor, dropState ),
				() => sourceCursor.close()
			);
		} );
	}

	/**
	 * Consumes Streams in order, closing each cursor before opening the next.
	 *
	 * @other Value to compose or compare with this instance.
	 */
	Stream function concat( required Stream other ) {
		var parts = [ this, arguments.other ];
		var combined = new Stream( () => openConcatParts( flattenConcatParts( parts ) ) );
		return combined.rememberConcatChildren( parts );
	}

	/**
	 * Consumes one mapped inner Stream fully before advancing the outer values.
	 *
	 * @mapper Callback receiving a success value and returning the next Stream.
	 */
	Stream function flatMap( required function mapper ) {
		var outerStream = this;
		var mapValue = arguments.mapper;
		return new Stream( () => outerStream.openCursor().map( ( outerCursor ) => {
			var flatMapState = {
				outer : outerCursor,
				inner : null,
				pending : [],
				index : 1
			};
			return new StreamCursor(
				() => flatMapPull( flatMapState, mapValue ),
				() => isNull( flatMapState.inner )
					? flatMapState.outer.close()
					: flatMapState.inner.close().ensuring( flatMapState.outer.close() )
			);
		} ) );
	}

	/**
	 * Replaces a single expected failure with a recovery Stream; other Causes pass through.
	 *
	 * @handler Callback receiving the single expected error and returning a recovery Stream.
	 */
	Stream function catchAll( required function handler ) {
		var errorHandler = arguments.handler;
		return recoverWith(
			( failureCause ) => errorHandler( failureCause.error() ),
			( failureCause ) => failureCause.kind() == "Fail"
		);
	}

	/**
	 * Replaces any opening or pull Cause with a recovery Stream after successful source cleanup.
	 *
	 * @handler Callback receiving the complete Cause and returning a recovery Stream.
	 */
	Stream function catchCause( required function handler ) {
		return recoverWith( arguments.handler, ( ignored ) => true );
	}

	/**
	 * Runs the finalizer when opening fails or the consumer closes, retaining cleanup failures.
	 *
	 * @finalizer Effect to execute as cleanup on every outcome.
	 */
	Stream function ensuring( required Effect finalizer ) {
		var sourceStream = this;
		var finalizerProgram = arguments.finalizer;
		return new Stream( () => sourceStream.openCursor()
			.catchCause( ( openingCause ) => Effect::haltInstruction( openingCause ).ensuring( finalizerProgram ) )
			.map( ( sourceCursor ) => new StreamCursor(
				() => sourceCursor.pull(),
				() => sourceCursor.close().ensuring( finalizerProgram )
			) )
		);
	}

	/**
	 * Supplies a Context or Layer during opening, every pull, and cursor cleanup.
	 *
	 * @provisioning Context or Layer supplying local service bindings.
	 */
	Stream function provide( required any provisioning ) {
		var sourceStream = this;
		var provided = arguments.provisioning;
		// Pull and close happen after the opening Effect has restored its Context,
		// so each cursor operation needs its own provisioning boundary.
		return new Stream( () => sourceStream.openCursor().provide( provided ).map(
			( sourceCursor ) => new StreamCursor(
				() => sourceCursor.pull().provide( provided ),
				() => sourceCursor.close().provide( provided )
			)
		) );
	}

	/**
	 * Describes consumption of all values into an array; execution begins only at an Effect runtime boundary.
	 */
	Effect function runCollect() {
		return runWithCursor( ( sourceCursor ) => {
			var collected = [];
			return collectPulls( sourceCursor, collected );
		} );
	}

	/**
	 * Describes sequential effectful consumption with cursor cleanup on every outcome.
	 *
	 * @handler Callback receiving each value and returning an Effect; handler results are discarded.
	 */
	Effect function runForEach( required function handler ) {
		var consumeValue = arguments.handler;
		return runWithCursor( ( sourceCursor ) => consumePulls( sourceCursor, consumeValue ) );
	}

	/**
	 * Describes synchronous reduction across pulled values with cleanup on every outcome.
	 *
	 * @initial Initial reduction accumulator.
	 * @reducer Synchronous callback receiving accumulator and value and returning the next accumulator.
	 */
	Effect function runFold( any initial, required function reducer ) {
		var initialValue = arguments.initial;
		var reduceValue = arguments.reducer;
		return runWithCursor( ( sourceCursor ) => {
			var foldState = { value: initialValue };
			return foldPulls( sourceCursor, foldState, reduceValue );
		} );
	}

	/**
	 * Describes consumption of all values while discarding the output.
	 */
	Effect function runDrain() {
		return runForEach( ( ignored ) => Effect::succeed( null ) );
	}

	/**
	 * Builds a runtime-private fresh-cursor acquisition Effect.
	 */
	Effect function openCursor() {
		return Effect::suspend( () => variables.opener() );
	}

	/**
	 * Reads immediate concatenation children without exposing the stored array.
	 */
	array function concatChildren() {
		return copyArray( variables.concatParts );
	}

	/**
	 * Stores private construction metadata on a newly created concatenation.
	 *
	 * @parts Ordered immediate children for sequential concatenation.
	 */
	Stream function rememberConcatChildren( required array parts ) {
		variables.concatParts = copyArray( arguments.parts );
		return this;
	}

	/**
	 * Flattens a concatenation graph iteratively without opening any source.
	 *
	 * @parts Immediate child descriptions in encounter order.
	 */
	private static array function flattenConcatParts( required array parts ) {
		var pending = new java.util.ArrayDeque();
		for ( var index = arguments.parts.len(); index >= 1; index-- ) {
			pending.addLast( arguments.parts[ index ] );
		}
		var leaves = [];
		while ( !pending.isEmpty() ) {
			var current = pending.removeLast();
			var children = current.concatChildren();
			if ( children.len() == 0 ) {
				leaves.append( current );
			} else {
				for ( var index = children.len(); index >= 1; index-- ) {
					pending.addLast( children[ index ] );
				}
			}
		}
		return leaves;
	}

	/**
	 * Wraps each newly opened source cursor with a transformation.
	 *
	 * @transformation Callback receiving a newly opened cursor and returning its wrapper cursor.
	 */
	private Stream function transformCursor( required function transformation ) {
		var sourceStream = this;
		var transform = arguments.transformation;
		return new Stream( () => sourceStream.openCursor().map( transform ) );
	}

	/**
	 * Installs recovery for both opening and pulling with per-consumption recovery state.
	 *
	 * @handler Callback receiving the eligible Cause and returning a recovery Stream.
	 * @predicate Callback receiving a Cause and returning whether it is eligible for recovery.
	 */
	private Stream function recoverWith( required function handler, required function predicate ) {
		var sourceStream = this;
		var recoveryHandler = arguments.handler;
		var shouldRecover = arguments.predicate;
		return new Stream( () => sourceStream.openCursor().foldCause(
			( openingCause ) => shouldRecover( openingCause )
				? Effect::suspend( () => recoveryHandler( openingCause ).openCursor() )
				: Effect::haltInstruction( openingCause ),
			( sourceCursor ) => {
				var recoveryState = {
					cursor : sourceCursor,
					recovered : false
				};
				return Effect::succeed( new StreamCursor(
					() => recoverPull( recoveryState, recoveryHandler, shouldRecover ),
					() => recoveryState.cursor.close()
				) );
			}
		) );
	}

	/**
	 * Pairs fresh cursor acquisition with use-boundary release before outer continuations resume.
	 *
	 * @consumer Callback receiving a fresh cursor and returning the consumption Effect.
	 */
	private Effect function runWithCursor( required function consumer ) {
		// Release belongs to the consumption boundary, not merely the root Scope:
		// following Effect work and outer recovery must see a closed cursor.
		return Effect::acquireUseRelease(
			openCursor(), arguments.consumer,
			( sourceCursor ) => sourceCursor.close()
		);
	}

	/**
	 * Skips filtered-out batches through suspended continuations to remain stack-safe.
	 *
	 * @sourceCursor Private cursor belonging to this consumption only.
	 * @predicate Callback receiving a value and returning whether to retain it.
	 */
	private static Effect function filterPull( required any sourceCursor, required function predicate ) {
		var cursorToPull = arguments.sourceCursor;
		var keepValue = arguments.predicate;
		return cursorToPull.pull().flatMap( ( batchAttempt ) => {
			if ( !batchAttempt.isPresent() ) {
				return Effect::succeed( attempt() );
			}
			var kept = [];
			for ( var value in batchAttempt.get() ) {
				if ( keepValue( value ) ) {
					kept.append( value );
				}
			}
			// No matches in this batch is not end-of-stream. Suspend the next
			// pull so arbitrarily many rejected batches remain stack-safe.
			return kept.len() > 0
				? Effect::succeed( attempt( kept ) )
				: Effect::suspend( () => filterPull( cursorToPull, keepValue ) );
		} );
	}

	/**
	 * Emits only the remaining requested values and tracks demand per cursor.
	 *
	 * @sourceCursor Private cursor belonging to this consumption only.
	 * @state Mutable progress state owned by this cursor or consumption only.
	 */
	private static Effect function takePull( required any sourceCursor, required struct state ) {
		var cursorToPull = arguments.sourceCursor;
		var stateToUse = arguments.state;
		if ( stateToUse.remaining == 0 ) {
			return Effect::succeed( attempt() );
		}
		return cursorToPull.pull().map( ( batchAttempt ) => {
			if ( !batchAttempt.isPresent() ) {
				stateToUse.remaining = 0;
				return attempt();
			}
			var batch = batchAttempt.get();
			var emitCount = min( stateToUse.remaining, batch.len() );
			var emitted = [];
			for ( var index = 1; index <= emitCount; index++ ) {
				emitted.append( batch[ index ] );
			}
			stateToUse.remaining -= emitCount;
			return attempt( emitted );
		} );
	}

	/**
	 * Skips complete batches lazily, then emits the unskipped tail.
	 *
	 * @sourceCursor Private cursor belonging to this consumption only.
	 * @state Mutable progress state owned by this cursor or consumption only.
	 */
	private static Effect function dropPull( required any sourceCursor, required struct state ) {
		var cursorToPull = arguments.sourceCursor;
		var stateToUse = arguments.state;
		return cursorToPull.pull().flatMap( ( batchAttempt ) => {
			if ( !batchAttempt.isPresent() ) {
				return Effect::succeed( attempt() );
			}
			var batch = batchAttempt.get();
			if ( stateToUse.remaining >= batch.len() ) {
				stateToUse.remaining -= batch.len();
				return Effect::suspend( () => dropPull( cursorToPull, stateToUse ) );
			}
			var emitted = [];
			for ( var index = stateToUse.remaining + 1; index <= batch.len(); index++ ) {
				emitted.append( batch[ index ] );
			}
			stateToUse.remaining = 0;
			return Effect::succeed( attempt( emitted ) );
		} );
	}

	/**
	 * Opens only the first normalized leaf and tracks the current cursor.
	 *
	 * @parts Ordered normalized Stream leaves for sequential concatenation.
	 */
	private static Effect function openConcatParts( required array parts ) {
		var streams = arguments.parts;
		return streams[ 1 ].openCursor().map( ( firstCursor ) => {
			var concatState = {
				streams : streams,
				index : 1,
				current : firstCursor
			};
			return new StreamCursor(
				() => concatPartsPull( concatState ),
				() => isNull( concatState.current )
					? Effect::succeed( null )
					: concatState.current.close()
			);
		} );
	}

	/**
	 * Closes exhausted leaves before lazily opening the next one.
	 *
	 * @state Mutable progress state owned by this cursor or consumption only.
	 */
	private static Effect function concatPartsPull( required struct state ) {
		var stateToUse = arguments.state;
		if ( isNull( stateToUse.current ) ) {
			if ( stateToUse.index >= stateToUse.streams.len() ) {
				return Effect::succeed( attempt() );
			}
			stateToUse.index++;
			return stateToUse.streams[ stateToUse.index ].openCursor().flatMap( ( nextCursor ) => {
				stateToUse.current = nextCursor;
				return Effect::suspend( () => concatPartsPull( stateToUse ) );
			} );
		}
		return stateToUse.current.pull().flatMap( ( batchAttempt ) => {
			if ( batchAttempt.isPresent() ) {
				return Effect::succeed( batchAttempt );
			}
			var completedCursor = stateToUse.current;
			stateToUse.current = null;
			return completedCursor.close().flatMap(
				( ignored ) => Effect::suspend( () => concatPartsPull( stateToUse ) )
			);
		} );
	}

	/**
	 * Drains the active inner cursor before advancing buffered outer values or pulling another batch.
	 *
	 * @state Mutable progress state owned by this cursor or consumption only.
	 * @mapper Callback receiving an outer value and returning an inner Stream.
	 */
	private static Effect function flatMapPull( required struct state, required function mapper ) {
		var stateToUse = arguments.state;
		var mapValue = arguments.mapper;
		if ( !isNull( stateToUse.inner ) ) {
			return stateToUse.inner.pull().flatMap( ( innerAttempt ) => {
				if ( innerAttempt.isPresent() ) {
					return Effect::succeed( innerAttempt );
				}
				var completedInner = stateToUse.inner;
				stateToUse.inner = null;
				return completedInner.close().flatMap(
					( ignored ) => Effect::suspend( () => flatMapPull( stateToUse, mapValue ) )
				);
			} );
		}
		if ( stateToUse.index <= stateToUse.pending.len() ) {
			var outerValue = stateToUse.pending[ stateToUse.index ];
			stateToUse.index++;
			return Effect::suspend( () => mapValue( outerValue ).openCursor() ).flatMap(
				( innerCursor ) => {
					stateToUse.inner = innerCursor;
					return Effect::suspend( () => flatMapPull( stateToUse, mapValue ) );
				}
			);
		}
		return stateToUse.outer.pull().flatMap( ( outerAttempt ) => {
			if ( !outerAttempt.isPresent() ) {
				return Effect::succeed( attempt() );
			}
			stateToUse.pending = outerAttempt.get();
			stateToUse.index = 1;
			return Effect::suspend( () => flatMapPull( stateToUse, mapValue ) );
		} );
	}

	/**
	 * Closes a failed cursor before opening recovery; cleanup failure preserves both Causes and prevents recovery.
	 *
	 * @state Mutable progress state owned by this cursor or consumption only.
	 * @handler Callback receiving the eligible Cause and returning a recovery Stream.
	 * @predicate Callback receiving a Cause and returning whether it is eligible for recovery.
	 */
	private static Effect function recoverPull(
		required struct state,
		required function handler,
		required function predicate
	) {
		var stateToUse = arguments.state;
		var recoveryHandler = arguments.handler;
		var shouldRecover = arguments.predicate;
		return stateToUse.cursor.pull().catchCause( ( pullCause ) => {
			if ( stateToUse.recovered || !shouldRecover( pullCause ) ) {
				return Effect::haltInstruction( pullCause );
			}
			stateToUse.recovered = true;
			// Claim recovery before opening its replacement so this operator cannot
			// repeatedly recover a failure from the recovery Stream itself.
			var failedCursor = stateToUse.cursor;
			return failedCursor.close().exit().flatMap( ( closeExit ) => {
				// A failed release prevents replacement acquisition and retains the
				// original pull Cause followed by the cleanup Cause.
				if ( closeExit.isFailure() ) {
					return Effect::haltInstruction( Cause::sequential( pullCause, closeExit.cause() ) );
				}
				return Effect::suspend( () => recoveryHandler( pullCause ).openCursor() ).flatMap(
					( recoveryCursor ) => {
						stateToUse.cursor = recoveryCursor;
						return recoveryCursor.pull();
					}
				);
			} );
		} );
	}

	/**
	 * Appends batches and suspends the next pull to avoid recursive execution.
	 *
	 * @sourceCursor Private cursor belonging to this consumption only.
	 * @collected Private array receiving values in encounter order.
	 */
	private static Effect function collectPulls( required any sourceCursor, required array collected ) {
		var cursorToPull = arguments.sourceCursor;
		var valuesToCollect = arguments.collected;
		return cursorToPull.pull().flatMap( ( batchAttempt ) => {
			if ( !batchAttempt.isPresent() ) {
				return Effect::succeed( valuesToCollect );
			}
			for ( var value in batchAttempt.get() ) {
				valuesToCollect.append( value );
			}
			return Effect::suspend( () => collectPulls( cursorToPull, valuesToCollect ) );
		} );
	}

	/**
	 * Runs each batch's handlers sequentially before requesting more values.
	 *
	 * @sourceCursor Private cursor belonging to this consumption only.
	 * @handler Callback receiving each value and returning an Effect; handler results are discarded.
	 */
	private static Effect function consumePulls( required any sourceCursor, required function handler ) {
		var cursorToPull = arguments.sourceCursor;
		var consumeValue = arguments.handler;
		return cursorToPull.pull().flatMap( ( batchAttempt ) =>
			!batchAttempt.isPresent()
				? Effect::succeed( null )
				: Effect::forEach(
					batchAttempt.get(),
					( value, index ) => consumeValue( value ),
					{ concurrency: 1, discard: true }
				).flatMap(
					( ignored ) => Effect::suspend( () => consumePulls( cursorToPull, consumeValue ) )
				)
		);
	}

	/**
	 * Updates the private accumulator per value and suspends between pulls.
	 *
	 * @sourceCursor Private cursor belonging to this consumption only.
	 * @state Mutable progress state owned by this cursor or consumption only.
	 * @reducer Synchronous callback receiving accumulator and value and returning the next accumulator.
	 */
	private static Effect function foldPulls(
		required any sourceCursor,
		required struct state,
		required function reducer
	) {
		var cursorToPull = arguments.sourceCursor;
		var stateToUse = arguments.state;
		var reduceValue = arguments.reducer;
		return cursorToPull.pull().flatMap( ( batchAttempt ) => {
			if ( !batchAttempt.isPresent() ) {
				return Effect::succeed( stateToUse.value );
			}
			for ( var value in batchAttempt.get() ) {
				stateToUse.value = reduceValue( stateToUse.value, value );
			}
			return Effect::suspend( () => foldPulls(
				cursorToPull,
				stateToUse,
				reduceValue
			) );
		} );
	}

	/**
	 * Copies array structure while preserving element references.
	 *
	 * @values Input values in encounter order.
	 */
	private static array function copyArray( required array values ) {
		var copied = [];
		for ( var value in arguments.values ) {
			copied.append( value );
		}
		return copied;
	}

	/**
	 * Rejects negative or fractional take/drop counts.
	 *
	 * @count Non-negative whole number of elements.
	 * @operation Operation name used in validation or shutdown diagnostics.
	 */
	private static void function validateCount( required numeric count, required string operation ) {
		if ( arguments.count < 0 || arguments.count != int( arguments.count ) ) {
			throw(
				type: "bxeffect.InvalidStreamCountException",
				message: "Stream.#arguments.operation#() requires a non-negative whole number"
			);
		}
	}

}
