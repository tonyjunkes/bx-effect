import ortus.boxlang.runtime.async.BoxFuture;
/**
 * Published deterministic Clock. Positive sleeps complete when time moves.
 * Starts at zero milliseconds and implements the runtime Clock contract without
 * TestBox dependencies. Tests advance time explicitly; no scheduler runs here.
 */
class {

	variables.currentMillis = 0;
	variables.pending = [];
	variables.lock = new java.util.concurrent.locks.ReentrantLock();

	/**
	 * Registers a deterministic wait; positive delays require advance, while zero completes immediately.
	 *
	 * @duration Non-negative delay or elapsed amount in the supplied unit.
	 * @unit Time unit; defaults to milliseconds when omitted.
	 * @return A native BoxFuture completing with null at its due time.
	 */
	BoxFuture function sleep( required numeric duration, string unit = "milliseconds" ) {
		var delayMillis = toMillis( arguments.duration, arguments.unit );
		if ( delayMillis == 0 ) {
			var completed = futureNew();
			completed.complete( null );
			return completed;
		}
		var delayed = futureNew();
		variables.lock.lock();
		try {
			variables.pending.append( {
				dueAt : variables.currentMillis + delayMillis,
				future : delayed
			} );
		} finally {
			variables.lock.unlock();
		}
		return delayed;
	}

	/**
	 * Moves simulated time forward, removes canceled waits, and completes due futures outside the lock.
	 *
	 * @duration Non-negative delay or elapsed amount in the supplied unit.
	 * @unit Time unit; defaults to milliseconds when omitted.
	 * @return The number of due futures selected for completion.
	 */
	numeric function advance( required numeric duration, string unit = "milliseconds" ) {
		var futuresToComplete = [];
		variables.lock.lock();
		try {
			variables.currentMillis += toMillis( arguments.duration, arguments.unit );
			var remaining = [];
			for ( var pendingSleep in variables.pending ) {
				if ( pendingSleep.future.isDone() || pendingSleep.future.isCancelled() ) {
					continue;
				}
				if ( pendingSleep.dueAt <= variables.currentMillis ) {
					futuresToComplete.append( pendingSleep.future );
				} else {
					remaining.append( pendingSleep );
				}
			}
			variables.pending = remaining;
		} finally {
			variables.lock.unlock();
		}
		for ( var pendingFuture in futuresToComplete ) {
			// Completion may invoke dependent callbacks that schedule another sleep.
			// Keep those callbacks outside the lock and this advance's pending scan.
			pendingFuture.complete( null );
		}
		return futuresToComplete.len();
	}

	/**
	 * Reads simulated time under the Clock lock.
	 *
	 * @return Milliseconds elapsed from the initial zero time.
	 */
	numeric function now() {
		variables.lock.lock();
		try {
			return variables.currentMillis;
		} finally {
			variables.lock.unlock();
		}
	}

	/**
	 * Prunes completed/canceled waits and counts outstanding sleeps.
	 *
	 * @return The number of pending sleeps.
	 */
	numeric function pendingCount() {
		variables.lock.lock();
		try {
			var remaining = [];
			for ( var pendingSleep in variables.pending ) {
				if ( !pendingSleep.future.isDone() && !pendingSleep.future.isCancelled() ) {
					remaining.append( pendingSleep );
				}
			}
			variables.pending = remaining;
			return remaining.len();
		} finally {
			variables.lock.unlock();
		}
	}

	/**
	 * Validates a non-negative duration and converts supported time units.
	 *
	 * @duration Non-negative delay or elapsed amount in the supplied unit.
	 * @unit Required time unit to convert to milliseconds.
	 * @return Milliseconds; invalid input throws InvalidDurationException or InvalidTimeUnitException.
	 */
	private numeric function toMillis( required numeric duration, required string unit ) {
		if ( arguments.duration < 0 ) {
			throw( type: "bxeffect.InvalidDurationException", message: "TestClock requires a non-negative duration" );
		}

		switch ( lCase( arguments.unit ) ) {
			case "millisecond":
			case "milliseconds":
			case "ms":
				return arguments.duration;
			case "second":
			case "seconds":
			case "s":
				return arguments.duration * 1000;
			case "minute":
			case "minutes":
			case "m":
				return arguments.duration * 60000;
			case "hour":
			case "hours":
			case "h":
				return arguments.duration * 3600000;
			case "day":
			case "days":
			case "d":
				return arguments.duration * 86400000;
		}

		throw( type: "bxeffect.InvalidTimeUnitException", message: "Unsupported TestClock unit [#arguments.unit#]" );
	}

}
