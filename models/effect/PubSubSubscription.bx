import ortus.boxlang.runtime.dynamic.Attempt;
import bxModules.bxEffect.models.effect.Effect;

/**
 * One explicit PubSub consumer. It receives values accepted while it remains
 * active and delegates coordinated waits to its parent PubSub.
 */
class {

	variables.pubSubSource = null;
	variables.items = new java.util.ArrayDeque();
	variables.shutdown = new java.util.concurrent.atomic.AtomicBoolean( false );

	/**
	 * Creates the internal consumer buffer; the parent hub is responsible for registration.
	 *
	 * @pubSubSource Parent PubSub hub coordinating subscription state and waits.
	 */
	PubSubSubscription function init( required any pubSubSource ) {
		variables.pubSubSource = arguments.pubSubSource;
		return this;
	}

	/**
	 * Describes an interruptible take coordinated by the parent hub.
	 */
	Effect function take() {
		return Effect::takeSubscriptionInstruction( this );
	}

	/**
	 * Immediately removes one available value through the parent hub.
	 */
	Attempt function poll() {
		return variables.pubSubSource.pollNative( this );
	}

	/**
	 * Describes idempotent removal from the parent hub and discards unread values.
	 */
	Effect function unsubscribe() {
		var parentPubSub = variables.pubSubSource;
		var subscriptionSource = this;
		return Effect::sync( () => parentPubSub.unsubscribeNative( subscriptionSource ) );
	}

	/**
	 * Checks local unsubscribe and parent hub shutdown state.
	 */
	boolean function isShutdown() {
		return variables.shutdown.get() || variables.pubSubSource.isShutdown();
	}

	/**
	 * Delegates an internal blocking take to the parent hub.
	 *
	 * @controlState Optional FiberControl; null means no Fiber cancellation tracking.
	 */
	struct function takeNative( any controlState = null ) {
		return variables.pubSubSource.takeNative( this, arguments.controlState );
	}

	/**
	 * Appends one wrapped value; the caller must hold the parent hub lock.
	 *
	 * @value Value carried by this operation; may be null.
	 */
	void function enqueueNative( any value ) {
		variables.items.addLast( { value: arguments.value } );
	}

	/**
	 * Checks the buffer; the caller must hold the parent hub lock.
	 */
	boolean function isEmptyNative() {
		return variables.items.isEmpty();
	}

	/**
	 * Counts buffered entries; the caller must hold the parent hub lock.
	 */
	numeric function sizeNative() {
		return variables.items.size();
	}

	/**
	 * Removes the oldest entry; the caller must hold the parent hub lock and ensure nonemptiness.
	 */
	any function dequeueNative() {
		return variables.items.removeFirst();
	}

	/**
	 * Marks closure and discards buffered entries; the caller must hold the parent hub lock.
	 */
	void function shutdownNative() {
		variables.shutdown.set( true );
		variables.items.clear();
	}

}
