import ortus.boxlang.runtime.async.BoxFuture;
import bxModules.bxEffect.models.effect.Cause;
import bxModules.bxEffect.models.effect.Clock;
import bxModules.bxEffect.models.effect.Effect;
import bxModules.bxEffect.models.effect.Exit;
import bxModules.bxEffect.models.effect.Fiber;
import bxModules.bxEffect.models.effect.context.Context;
import bxModules.bxEffect.models.effect.internal.FiberControl;
import bxModules.bxEffect.models.effect.internal.LayerMemo;
import bxModules.bxEffect.models.effect.internal.ThrowablePolicy;
import bxModules.bxEffect.models.effect.Scope;
import java.util.ArrayDeque;

/**
 * Iterative Effect interpreter. Async waits intentionally occur on BoxLang's
 * io-tasks virtual-thread executor; runFuture callers remain non-blocking.
 *
 * Each root execution owns a Scope and Layer memo. Child interpreters inherit
 * Context values and share root ownership; only the owner shuts down children
 * and drains Scope finalizers. Observer callbacks are diagnostic-only.
 */
class {

	variables.executorName = null;
	variables.clock = null;
	variables.observer = null;

	/**
	 * Configures the execution boundary without starting any program.
	 *
	 * @options Optional executor name, Clock object, and diagnostic observer callback/object.
	 * @return This runtime.
	 */
	EffectRuntime function init( struct options = {} ) {
		variables.executorName = structKeyExists( arguments.options, "executor" )
			? arguments.options.executor
			: null;
		variables.clock = structKeyExists( arguments.options, "clock" )
			? arguments.options.clock
			: new Clock();
		variables.observer = structKeyExists( arguments.options, "observer" )
			? arguments.options.observer
			: null;
		return this;
	}

	/**
	 * Runs immediately, waits for root cleanup, and throws EffectFailureException for a failed Exit.
	 *
	 * @program Effect to execute within this operation's boundary.
	 * @return The success value.
	 */
	any function runSync( required Effect program ) {
		var effectExit = runSyncExit( arguments.program );
		if ( effectExit.isSuccess() ) {
			return effectExit.value();
		}

		throw(
			type: "bxeffect.EffectFailureException",
			message: effectExit.cause().pretty(),
			extendedInfo: effectExit.cause()
		);
	}

	/**
	 * Runs immediately with an empty Context and a fresh root Scope.
	 *
	 * @program Effect to execute within this operation's boundary.
	 * @return The complete Exit after cleanup.
	 */
	any function runSyncExit( required Effect program ) {
		return _runSyncExitWithContext( arguments.program, Context::empty() );
	}

	/**
	 * Starts execution on the configured executor without blocking the caller.
	 *
	 * @program Effect to execute within this operation's boundary.
	 * @return A native BoxFuture yielding the value or failing with EffectFailureException.
	 */
	BoxFuture function runFuture( required Effect program ) {
		var programToRun = arguments.program;
		return futureNew( () => runSync( programToRun ), executor() );
	}

	/**
	 * Starts execution asynchronously with an empty Context and a fresh root Scope.
	 *
	 * @program Effect to execute within this operation's boundary.
	 * @return A native BoxFuture yielding the complete Exit.
	 */
	BoxFuture function runFutureExit( required Effect program ) {
		return _runFutureExitWithContext( arguments.program, Context::empty() );
	}

	/**
	 * Starts a root Fiber with an empty Context and a fresh Scope.
	 *
	 * @program Effect to execute within this operation's boundary.
	 * @return A Fiber handle.
	 */
	Fiber function runFork( required Effect program ) {
		return _runForkWithContext( arguments.program, Context::empty() );
	}

	/**
	 * Starts internal interpretation with explicit Context and optional shared ownership.
	 *
	 * @program Effect to execute within this operation's boundary.
	 * @initialContext Service bindings at the start of interpretation.
	 * @controlState Optional FiberControl; null means no Fiber cancellation tracking.
	 * @sharedScope Optional externally owned Scope; null creates a fresh owned root Scope.
	 * @sharedLayerMemo Runtime-private build memo shared with child Fibers; null creates one when optional.
	 * @return A native BoxFuture yielding the Exit.
	 */
	BoxFuture function _runFutureExitWithContext(
		required Effect program,
		required Context initialContext,
		any controlState = null,
		any sharedScope = null,
		any sharedLayerMemo = null
	) {
		var programToRun = arguments.program;
		var contextToUse = arguments.initialContext;
		var controlToUse = arguments.controlState;
		var scopeToUse = arguments.sharedScope;
		var layerMemoToUse = arguments.sharedLayerMemo;
		return futureNew(
			() => _runSyncExitWithContext(
				programToRun,
				contextToUse,
				controlToUse,
				scopeToUse,
				layerMemoToUse
			),
			executor()
		);
	}

	/**
	 * Resolves and caches the explicit or activated-module executor name.
	 *
	 * @return The BoxLang named executor.
	 */
	string function executor() {
		if ( isNull( variables.executorName ) ) {
			variables.executorName = resolveDefaultExecutor();
		}
		return variables.executorName;
	}

	/**
	 * Reads the runtime's live or injected Clock.
	 *
	 * @return The configured Clock object.
	 */
	any function clock() {
		return variables.clock;
	}

	/**
	 * Resolves the activated module's default executor with a defensive fallback.
	 *
	 * @return The configured executor name, or io-tasks.
	 */
	private string function resolveDefaultExecutor() {
		var fallbackExecutor = "io-tasks";
		try {
			var moduleService = getBoxRuntime().getModuleService();
			if ( !moduleService.hasModule( "bxEffect" ) ) {
				return fallbackExecutor;
			}

			var moduleSettings = moduleService.getModuleSettings( "bxEffect" );
			return structKeyExists( moduleSettings, "defaultExecutor" )
				? moduleSettings.defaultExecutor
				: fallbackExecutor;
		} catch ( any error ) {
			ThrowablePolicy::rethrowIfFatal( error );
			return fallbackExecutor;
		}
	}

	/**
	 * Starts a Fiber with separate public completion and actual termination futures.
	 *
	 * @program Effect to execute within this operation's boundary.
	 * @initialContext Service bindings at the start of interpretation.
	 * @sharedScope Optional externally owned Scope; null creates a fresh owned root Scope.
	 * @sharedLayerMemo Runtime-private build memo shared with child Fibers; null creates one when optional.
	 * @return A Fiber using the supplied Context and optional shared Scope/memo.
	 */
	Fiber function _runForkWithContext(
		required Effect program,
		required Context initialContext,
		any sharedScope = null,
		any sharedLayerMemo = null
	) {
		var fiberId = createUUID();
		var controlState = new FiberControl( fiberId );
		var programToRun = arguments.program;
		var contextToUse = arguments.initialContext;
		var scopeToUse = arguments.sharedScope;
		var layerMemoToUse = arguments.sharedLayerMemo;
		notifyObserver( "fiber:started", { fiberId: fiberId } );
		var terminationFuture = futureNew();
		// Public cancellation may resolve runtimeFuture before its worker exits.
		// Owners wait on this separate signal before releasing shared resources.
		var runtimeFuture = futureNew(
			() => {
				try {
					var completedExit = _runSyncExitWithContext(
						programToRun,
						contextToUse,
						controlState,
						scopeToUse,
						layerMemoToUse
					);
					terminationFuture.complete( completedExit );
					return completedExit;
				} catch ( any error ) {
					terminationFuture.complete( Exit::failure( Cause::die( error ) ) );
					throw( object: error );
				}
			},
			executor()
		);
		return new Fiber(
			future: runtimeFuture,
			fiberId: fiberId,
			control: controlState,
			terminationFuture: terminationFuture
		);
	}

	/**
	 * Interprets instruction nodes with an explicit continuation stack,
	 * restoring Context and unwinding cleanup on every outcome.
	 *
	 * @program Effect to execute within this operation's boundary.
	 * @initialContext Service bindings at the start of interpretation.
	 * @controlState Optional FiberControl; null means no Fiber cancellation tracking.
	 * @sharedScope Optional externally owned Scope; null creates a fresh owned root Scope.
	 * @sharedLayerMemo Runtime-private build memo shared with child Fibers; null creates one when optional.
	 * @return The complete Exit; only an owning invocation closes the Scope.
	 */
	any function _runSyncExitWithContext(
		required Effect program,
		required Context initialContext,
		any controlState = null,
		any sharedScope = null,
		any sharedLayerMemo = null
	) {
		notifyObserver( "runtime:started", {} );
		var current = arguments.program._instruction();
		// Frames represent work to resume after the current node. Pushing and
		// popping them here keeps deep map/flatMap chains off the JVM call stack.
		var continuations = new ArrayDeque();
		var runtimeContext = arguments.initialContext;
		var ownsScope = isNull( arguments.sharedScope );
		var runtimeScope = ownsScope ? new Scope() : arguments.sharedScope;
		var runtimeLayerMemo = isNull( arguments.sharedLayerMemo )
			? new LayerMemo()
			: arguments.sharedLayerMemo;
		var interruptionObserved = false;

		while ( true ) {
			// Successful acquisition must install release before cancellation wins.
			// Only administrative handoff frames bypass this check, never user work.
			if (
				!interruptionObserved
				&& !isNull( arguments.controlState )
				&& arguments.controlState.isInterrupted()
				&& !isResourceHandoff( current, continuations )
			) {
				interruptionObserved = true;
				if ( current.kind != "Halt" || !current.cause.isInterrupted() ) {
					current = haltInstruction( Cause::interrupt( arguments.controlState.fiberId() ) );
				}
			}
			switch ( current.kind ) {
				case "Succeed":
					if ( continuations.isEmpty() ) {
						return finishExit(
							Exit::success( current.value ),
							runtimeScope,
							ownsScope,
							arguments.controlState
						);
					}
					var successFrame = continuations.removeLast();
					if ( successFrame.kind == "RestoreContext" ) {
						runtimeContext = successFrame.context;
						break;
					}
					if ( successFrame.kind == "RegisterUseFinalizer" ) {
						continuations.addLast( {
							kind : "Ensuring",
							handler : resourceReleaseHandler( successFrame.release, current.value )
						} );
						current = resourceUseInstruction( successFrame.use, current.value );
						break;
					}
						if ( successFrame.kind == "RegisterFinalizer" ) {
							var acquiredResource = current.value;
							var releaseFunction = successFrame.release;
							try {
								runtimeScope.addRelease( releaseFunction, acquiredResource, runtimeContext );
							} catch ( any error ) {
								ThrowablePolicy::rethrowIfFatal( error );
								var registrationCause = Cause::die( error );
								// The Scope rejected ownership after acquisition succeeded;
								// release here and retain both registration and cleanup failures.
								var releaseExit = executeFrameFinalizer(
									resourceReleaseHandler( releaseFunction, acquiredResource ),
									Exit::failure( registrationCause ), runtimeContext
								);
								current = haltInstruction( releaseExit.isFailure()
									? Cause::sequential( registrationCause, releaseExit.cause() )
									: registrationCause );
							}
							break;
						}
						if ( successFrame.kind == "ProvideLayer" ) {
							continuations.addLast( {
								kind : "RestoreContext",
								context : runtimeContext
							} );
							runtimeContext = runtimeContext.merge( current.value );
							current = successFrame.effect._instruction();
							break;
						}
						if ( successFrame.kind == "CompleteLayerBuild" ) {
							try {
								var layerOutputs = current.value._outputsFrom( successFrame.baseContext );
								// Memoize only explicit writes: a waiter may have different
								// inherited bindings that must not be replaced by the owner's.
								runtimeLayerMemo.completeSuccess(
									successFrame.outcomeFuture,
									layerOutputs
								);
							} catch ( any error ) {
								current = interruptionOrDefectInstruction( error, arguments.controlState );
								runtimeLayerMemo.completeFailure(
									successFrame.layerId, successFrame.outcomeFuture, current.cause
								);
							}
							break;
						}
						if ( successFrame.kind == "Retry" ) {
							break;
						}
						if ( successFrame.kind == "RetryResume" || successFrame.kind == "RepeatResume" ) {
							continuations.addLast( {
								kind : successFrame.kind == "RetryResume" ? "Retry" : "Repeat",
								effect : successFrame.effect,
								schedule : successFrame.schedule,
								recurrence : successFrame.recurrence,
								scheduledAt : isNull( successFrame.scheduledAt )
									? variables.clock.now()
									: successFrame.scheduledAt
							} );
							current = successFrame.effect._instruction();
							break;
						}
						if ( successFrame.kind == "Repeat" ) {
							try {
								var repeatDecision = successFrame.schedule.next(
									successFrame.recurrence,
									current.value,
									successFrame.scheduledAt,
									variables.clock.now()
								);
								if ( repeatDecision.continue ) {
									continuations.addLast( {
										kind : "RepeatResume",
										effect : successFrame.effect,
										schedule : successFrame.schedule,
										recurrence : successFrame.recurrence + 1,
										scheduledAt : repeatDecision.nextScheduledAt
									} );
									current = {
										kind : "Sleep",
										duration : repeatDecision.delay,
										unit : repeatDecision.unit
									};
								}
							} catch ( any error ) {
								current = interruptionOrDefectInstruction( error, arguments.controlState );
							}
							break;
						}
						if ( successFrame.kind == "Ensuring" ) {
						var finalizerExit = executeFrameFinalizer(
							successFrame.handler,
							Exit::success( current.value ),
							runtimeContext
						);
						if ( finalizerExit.isFailure() ) {
							current = haltInstruction( finalizerExit.cause() );
						}
						break;
					}
					try {
						current = successFrame.kind == "Map"
							? { kind: "Succeed", value: successFrame.mapper( current.value ) }
							: successFrame.kind == "FlatMap"
								? successFrame.mapper( current.value )._instruction()
								: successFrame.onSuccess( current.value )._instruction();
					} catch ( any error ) {
						current = interruptionOrDefectInstruction( error, arguments.controlState );
					}
					break;

				case "Fail":
					current = haltInstruction( Cause::fail( current.error ) );
					break;

				case "Halt":
					var recovered = false;
					// Unwind success-only frames, but still restore bindings and run
					// finalizers before reaching an enclosing recovery continuation.
					while ( !continuations.isEmpty() ) {
						var failureFrame = continuations.removeLast();
						if ( failureFrame.kind == "CompleteLayerBuild" ) {
							runtimeLayerMemo.completeFailure(
								failureFrame.layerId,
								failureFrame.outcomeFuture,
								current.cause
							);
							continue;
						}
						if ( failureFrame.kind == "RestoreContext" ) {
							runtimeContext = failureFrame.context;
							continue;
						}
						if ( failureFrame.kind == "Ensuring" ) {
							var cleanupExit = executeFrameFinalizer(
								failureFrame.handler,
								Exit::failure( current.cause ),
								runtimeContext
							);
							if ( cleanupExit.isFailure() ) {
								current = haltInstruction(
									Cause::sequential( current.cause, cleanupExit.cause() )
								);
							}
							continue;
						}
						if ( failureFrame.kind == "Retry" ) {
							if ( current.cause.kind() != "Fail" ) {
								continue;
							}
							try {
								var retryDecision = failureFrame.schedule.next(
									failureFrame.recurrence,
									current.cause.error(),
									failureFrame.scheduledAt,
									variables.clock.now()
								);
								if ( retryDecision.continue ) {
									notifyObserver( "retry:scheduled", {
										recurrence : failureFrame.recurrence,
										delay : retryDecision.delay,
										unit : retryDecision.unit
									} );
									continuations.addLast( {
										kind : "RetryResume",
										effect : failureFrame.effect,
										schedule : failureFrame.schedule,
										recurrence : failureFrame.recurrence + 1,
										scheduledAt : retryDecision.nextScheduledAt
									} );
									current = {
										kind : "Sleep",
										duration : retryDecision.delay,
										unit : retryDecision.unit
									};
									recovered = true;
									break;
								}
							} catch ( any error ) {
								current = interruptionOrDefectInstruction( error, arguments.controlState );
								recovered = true;
								break;
							}
							continue;
						}
						if ( failureFrame.kind == "FoldCause" ) {
							try {
								current = failureFrame.onFailure( current.cause )._instruction();
							} catch ( any error ) {
								current = interruptionOrDefectInstruction( error, arguments.controlState );
							}
							recovered = true;
							break;
						}
					}
					if ( !recovered ) {
						return finishExit(
							Exit::failure( current.cause ),
							runtimeScope,
							ownsScope,
							arguments.controlState
						);
					}
					break;

				case "Sync":
					try {
						current = {
							kind : "Succeed",
							value : current.thunk()
						};
					} catch ( any error ) {
						current = interruptionOrDefectInstruction( error, arguments.controlState );
					}
					break;

				case "Try":
					try {
						current = {
							kind : "Succeed",
							value : current.thunk()
						};
					} catch ( any error ) {
						if ( !isNull( arguments.controlState ) && arguments.controlState.isInterrupted() ) {
							current = interruptionOrDefectInstruction( error, arguments.controlState );
							break;
						}
						ThrowablePolicy::rethrowIfFatal( error );
						try {
							current = {
								kind : "Fail",
								error : current.errorMapper( error )
							};
						} catch ( any mapperError ) {
							current = interruptionOrDefectInstruction( mapperError, arguments.controlState );
						}
					}
					break;

				case "Suspend":
					try {
						current = current.thunk()._instruction();
					} catch ( any error ) {
						current = interruptionOrDefectInstruction( error, arguments.controlState );
					}
					break;

				case "AsyncFuture":
				case "Sleep":
					current = awaitFutureInstruction( current, arguments.controlState );
					break;

				case "SemaphoreAcquire":
					// Register only around known native waits. The finally block must
					// clear this before the executor thread returns to arbitrary code.
					var semaphoreThread = registerBlockingThread( arguments.controlState );
					try {
						current.permitSource._acquireNative();
						current = {
							kind : "Succeed",
							value : null
						};
					} catch ( any error ) {
						current = interruptionOrDefectInstruction( error, arguments.controlState );
					} finally {
						clearBlockingThread( arguments.controlState, semaphoreThread );
					}
					break;

				case "QueueOffer":
					var queueOfferThread = registerBlockingThread( arguments.controlState );
					try {
						var offerOutcome = current.queueSource._offerNative(
							current.value,
							arguments.controlState
						);
						current = offerOutcome.isInterrupted
							? haltInstruction( Cause::interrupt( arguments.controlState.fiberId() ) )
							: offerOutcome.isShutdown
							? {
								kind : "Fail",
								error : queueShutdownError( "offer" )
							}
							: {
								kind : "Succeed",
								value : null
							};
					} catch ( any error ) {
						current = interruptionOrDefectInstruction( error, arguments.controlState );
					} finally {
						clearBlockingThread( arguments.controlState, queueOfferThread );
					}
					break;

				case "QueueTake":
					var queueTakeThread = registerBlockingThread( arguments.controlState );
					try {
						var takeOutcome = current.queueSource._takeNative( arguments.controlState );
						current = takeOutcome.isInterrupted
							? haltInstruction( Cause::interrupt( arguments.controlState.fiberId() ) )
							: takeOutcome.isShutdown
							? {
								kind : "Fail",
								error : queueShutdownError( "take" )
							}
							: {
								kind : "Succeed",
								value : takeOutcome.value
							};
					} catch ( any error ) {
						current = interruptionOrDefectInstruction( error, arguments.controlState );
					} finally {
						clearBlockingThread( arguments.controlState, queueTakeThread );
					}
					break;

				case "PubSubPublish":
					var publishThread = registerBlockingThread( arguments.controlState );
					try {
						var publishOutcome = current.pubSubSource._publishNative(
							current.value,
							arguments.controlState
						);
						current = publishOutcome.isInterrupted
							? haltInstruction( Cause::interrupt( arguments.controlState.fiberId() ) )
							: publishOutcome.isShutdown
								? {
									kind : "Fail",
									error : pubSubShutdownError( "publish" )
								}
								: {
									kind : "Succeed",
									value : null
								};
					} catch ( any error ) {
						current = interruptionOrDefectInstruction( error, arguments.controlState );
					} finally {
						clearBlockingThread( arguments.controlState, publishThread );
					}
					break;

				case "PubSubSubscribe":
					var subscribeThread = registerBlockingThread( arguments.controlState );
					try {
						var subscribeOutcome = current.pubSubSource._subscribeNative(
							arguments.controlState
						);
						current = subscribeOutcome.isInterrupted
							? haltInstruction( Cause::interrupt( arguments.controlState.fiberId() ) )
							: subscribeOutcome.isShutdown
								? {
									kind : "Fail",
									error : pubSubShutdownError( "subscribe" )
								}
								: {
									kind : "Succeed",
									value : subscribeOutcome.subscription
								};
					} catch ( any error ) {
						current = interruptionOrDefectInstruction( error, arguments.controlState );
					} finally {
						clearBlockingThread( arguments.controlState, subscribeThread );
					}
					break;

				case "PubSubTake":
					var pubSubTakeThread = registerBlockingThread( arguments.controlState );
					try {
						var subscriptionOutcome = current.subscriptionSource._takeNative(
							arguments.controlState
						);
						current = subscriptionOutcome.isInterrupted
							? haltInstruction( Cause::interrupt( arguments.controlState.fiberId() ) )
							: subscriptionOutcome.isPubSubShutdown
								? {
									kind : "Fail",
									error : pubSubShutdownError( "take" )
								}
								: subscriptionOutcome.isSubscriptionShutdown
									? {
										kind : "Fail",
										error : subscriptionShutdownError( "take" )
									}
									: {
										kind : "Succeed",
										value : subscriptionOutcome.value
									};
					} catch ( any error ) {
						current = interruptionOrDefectInstruction( error, arguments.controlState );
					} finally {
						clearBlockingThread( arguments.controlState, pubSubTakeThread );
					}
					break;

				case "Fork":
					try {
						var childProgram = current.effect;
						var childContext = runtimeContext;
						var childScope = runtimeScope;
						var childLayerMemo = runtimeLayerMemo;
						var childFiber = runtimeScope._forkChild( () => _runForkWithContext(
							childProgram,
							childContext,
							childScope,
							childLayerMemo
						) );
						current = {
							kind : "Succeed",
							value : childFiber
						};
					} catch ( any error ) {
						current = interruptionOrDefectInstruction( error, arguments.controlState );
					}
					break;

				case "All":
					try {
						var allResult = awaitAll(
							current.effects,
							runtimeContext,
							runtimeScope,
							runtimeLayerMemo,
							current.options,
							arguments.controlState
						);
						current = allResult.isSuccess
							? { kind: "Succeed", value: allResult.values }
							: haltInstruction( allResult.cause );
					} catch ( any error ) {
						current = interruptionOrDefectInstruction( error, arguments.controlState );
					}
					break;

				case "Race":
					try {
						var winnerExit = awaitAny(
							current.effects,
							runtimeContext,
							runtimeScope,
							runtimeLayerMemo,
							arguments.controlState
						);
						current = winnerExit.isSuccess()
							? { kind: "Succeed", value: winnerExit.value() }
							: haltInstruction( winnerExit.cause() );
					} catch ( any error ) {
						current = interruptionOrDefectInstruction( error, arguments.controlState );
					}
					break;

				case "FirstSuccess":
					try {
						var successfulExit = awaitFirstSuccess(
							current.effects,
							runtimeContext,
							runtimeScope,
							runtimeLayerMemo,
							arguments.controlState
						);
						current = successfulExit.isSuccess()
							? { kind: "Succeed", value: successfulExit.value() }
							: haltInstruction( successfulExit.cause() );
					} catch ( any error ) {
						current = interruptionOrDefectInstruction( error, arguments.controlState );
					}
					break;

				case "AccessService":
					try {
						current = {
							kind : "Succeed",
							value : runtimeContext.get( current.tag )
						};
					} catch ( any error ) {
						current = interruptionOrDefectInstruction( error, arguments.controlState );
					}
					break;

					case "ProvideContext":
					continuations.addLast( {
						kind : "RestoreContext",
						context : runtimeContext
					} );
					runtimeContext = runtimeContext.merge( current.context );
						current = current.effect._instruction();
						break;

					case "ProvideLayer":
						try {
							continuations.addLast( {
								kind : "ProvideLayer",
								effect : current.effect
							} );
							current = Effect::_buildLayer(
								current.layer,
								Context::empty()
							)._instruction();
						} catch ( any error ) {
							current = interruptionOrDefectInstruction( error, arguments.controlState );
						}
						break;

					case "BuildLayer":
						try {
							var layerIdentity = current.layer._identity();
							var layerBuild = runtimeLayerMemo.begin( layerIdentity );
							if ( layerBuild.owner ) {
								continuations.addLast( {
									kind : "CompleteLayerBuild",
									layerId : layerIdentity,
									baseContext : current.baseContext,
									outcomeFuture : layerBuild.outcomeFuture
								} );
								current = current.layer.build( current.baseContext )._instruction();
							} else {
								current = {
									kind : "AwaitLayerBuild",
									baseContext : current.baseContext,
									outcomeFuture : layerBuild.outcomeFuture
								};
							}
						} catch ( any error ) {
							current = interruptionOrDefectInstruction( error, arguments.controlState );
						}
						break;

					case "AwaitLayerBuild":
						var waiterFuture = null;
						try {
							waiterFuture = current.outcomeFuture.then( ( outcome ) => outcome );
							// Cancel this dependent waiter, never the shared build future.
							if ( !isNull( arguments.controlState ) ) {
								arguments.controlState.setActiveFuture( waiterFuture );
							}
							var layerOutcome = waiterFuture.get();
							current = layerOutcome.isSuccess()
								? { kind: "Succeed", value: current.baseContext.merge( layerOutcome.value() ) }
								: haltInstruction( layerOutcome.cause() );
						} catch ( any error ) {
							current = interruptionOrDefectInstruction( error, arguments.controlState );
						} finally {
							if ( !isNull( waiterFuture ) && !isNull( arguments.controlState ) ) {
								arguments.controlState.clearActiveFuture( waiterFuture );
							}
						}
						break;

				case "AcquireRelease":
					continuations.addLast( {
						kind : "RegisterFinalizer",
						release : current.release
					} );
					current = current.acquire._instruction();
					break;

				case "AcquireUseRelease":
					continuations.addLast( {
						kind : "RegisterUseFinalizer",
						use : current.use,
						release : current.release
					} );
					current = current.acquire._instruction();
					break;

				case "Ensuring":
					continuations.addLast( {
						kind : "Ensuring",
						handler : current.handler
					} );
					current = current.effect._instruction();
					break;

				case "FlatMap":
				case "Map":
					continuations.addLast( {
						kind : current.kind,
						mapper : current.mapper
					} );
					current = current.effect._instruction();
					break;

				case "FoldCause":
					continuations.addLast( {
						kind : "FoldCause",
						onFailure : current.onFailure,
						onSuccess : current.onSuccess
					} );
					current = current.effect._instruction();
					break;

				case "Retry":
				case "Repeat":
					continuations.addLast( {
						kind : current.kind,
						effect : current.effect,
						schedule : current.schedule,
						recurrence : 0,
						scheduledAt : variables.clock.now()
					} );
					current = current.effect._instruction();
					break;

				default:
					try {
						throw(
							type: "bxeffect.UnknownInstructionException",
							message: "Unknown Effect instruction [#current.kind#]"
						);
					} catch ( any error ) {
						current = interruptionOrDefectInstruction( error, arguments.controlState );
					}
			}
		}
	}

	/**
	 * Executes a sleep/future factory and registers its native wait for Fiber cancellation.
	 *
	 * @instruction Internal instruction node consumed by EffectRuntime; treat as read-only.
	 * @controlState Optional FiberControl; null means no Fiber cancellation tracking.
	 * @return A Succeed or Halt instruction.
	 */
	private struct function awaitFutureInstruction( required struct instruction, any controlState = null ) {
		var instructionKind = arguments.instruction.kind;
		var nativeFuture = null;
		try {
			nativeFuture = instructionKind == "Sleep"
				? variables.clock.sleep( arguments.instruction.duration, arguments.instruction.unit )
				: arguments.instruction.futureFactory();
			if ( !isNull( arguments.controlState ) ) {
				arguments.controlState.setActiveFuture( nativeFuture );
			}
			notifyObserver( "effect:suspended", { instruction: instructionKind } );
			return { kind: "Succeed", value: nativeFuture.get() };
		} catch ( any error ) {
			return interruptionOrDefectInstruction( error, arguments.controlState );
		} finally {
			notifyObserver( "effect:resumed", { instruction: instructionKind } );
			if ( !isNull( nativeFuture ) && !isNull( arguments.controlState ) ) {
				arguments.controlState.clearActiveFuture( nativeFuture );
			}
		}
	}

	/**
	 * Preserves an existing Cause in an interpreter failure node.
	 *
	 * @failureCause Complete Cause to preserve, including composite structure.
	 * @return A Halt instruction.
	 */
	private struct function haltInstruction( required Cause failureCause ) {
		return {
			kind : "Halt",
			cause : arguments.failureCause
		};
	}

	/**
	 * Rethrows fatal platform conditions and normalizes other thrown values as defects.
	 *
	 * @throwableValue Thrown value or native throwable wrapper to inspect.
	 * @return A Halt instruction with a Die Cause.
	 */
	private struct function defectInstruction( required any throwableValue ) {
		ThrowablePolicy::rethrowIfFatal( arguments.throwableValue );
		return haltInstruction( Cause::die( arguments.throwableValue ) );
	}

	/**
	 * Gives requested Fiber interruption precedence over normalization of a thrown wait error.
	 *
	 * @throwableValue Thrown value or native throwable wrapper to inspect.
	 * @controlState Optional FiberControl; null means no Fiber cancellation tracking.
	 * @return A Halt instruction.
	 */
	private struct function interruptionOrDefectInstruction(
		required any throwableValue,
		any controlState = null
	) {
		if ( !isNull( arguments.controlState ) && arguments.controlState.isInterrupted() ) {
			return haltInstruction( Cause::interrupt( arguments.controlState.fiberId() ) );
		}
		return defectInstruction( arguments.throwableValue );
	}

	/**
	 * Registers the current thread only for a known interruptible native instruction.
	 *
	 * @controlState Optional FiberControl; null means no Fiber cancellation tracking.
	 * @return The registered thread, or null without cancellation state.
	 */
	private any function registerBlockingThread( any controlState = null ) {
		if ( isNull( arguments.controlState ) ) {
			return null;
		}
		var workerThread = java.lang.Thread::currentThread();
		arguments.controlState.setActiveThread( workerThread );
		return workerThread;
	}

	/**
	 * Clears the matching registration when an interruptible instruction exits.
	 *
	 * @controlState Optional FiberControl; null means no Fiber cancellation tracking.
	 * @workerThread Worker registered only during a known interruptible native instruction.
	 * @return No value.
	 */
	private void function clearBlockingThread( any controlState = null, any workerThread = null ) {
		if ( !isNull( arguments.controlState ) && !isNull( arguments.workerThread ) ) {
			arguments.controlState.clearActiveThread( arguments.workerThread );
		}
	}

	/**
	 * Allows administrative success frames to register cleanup before pending cancellation is observed.
	 *
	 * @instruction Internal instruction node consumed by EffectRuntime; treat as read-only.
	 * @continuations Interpreter continuation deque with the next frame at its tail.
	 * @return Whether cancellation observation must be deferred for this step.
	 */
	private boolean function isResourceHandoff( required struct instruction, required any continuations ) {
		if ( arguments.instruction.kind != "Succeed" || arguments.continuations.isEmpty() ) {
			return false;
		}
		var frameKind = arguments.continuations.peekLast().kind;
		return frameKind == "RegisterFinalizer"
			|| frameKind == "RegisterUseFinalizer"
			|| frameKind == "RestoreContext";
	}

	/**
	 * Captures an acquired resource in a lazy exit handler.
	 *
	 * @release Callback receiving the acquired resource and returning its cleanup Effect.
	 * @resource Successfully acquired value captured for use or release.
	 * @return A handler returning the release Effect.
	 */
	private function function resourceReleaseHandler( required function release, any resource ) {
		var releaseResource = arguments.release;
		var ownedResource = arguments.resource;
		return ( ignoredExit ) => Effect::suspend( () => releaseResource( ownedResource ) );
	}

	/**
	 * Defers invoking the use callback until its release continuation is installed.
	 *
	 * @use Callback receiving the resource and returning the Effect to run before release.
	 * @resource Successfully acquired value captured for use or release.
	 * @return A Suspend instruction.
	 */
	private struct function resourceUseInstruction( required function use, any resource ) {
		var useResource = arguments.use;
		var ownedResource = arguments.resource;
		return { kind: "Suspend", thunk: () => useResource( ownedResource ) };
	}

	/**
	 * Constructs the expected error for a closed Queue operation.
	 *
	 * @operation Operation name used in validation or shutdown diagnostics.
	 * @return A QueueShutdown tagged struct.
	 */
	private struct function queueShutdownError( required string operation ) {
		return {
			_tag : "QueueShutdown",
			operation : arguments.operation,
			message : "Queue is shut down"
		};
	}

	/**
	 * Constructs the expected error for a closed hub operation.
	 *
	 * @operation Operation name used in validation or shutdown diagnostics.
	 * @return A PubSubShutdown tagged struct.
	 */
	private struct function pubSubShutdownError( required string operation ) {
		return {
			_tag : "PubSubShutdown",
			operation : arguments.operation,
			message : "PubSub is shut down"
		};
	}

	/**
	 * Constructs the expected error for an unsubscribed consumer operation.
	 *
	 * @operation Operation name used in validation or shutdown diagnostics.
	 * @return A SubscriptionShutdown tagged struct.
	 */
	private struct function subscriptionShutdownError( required string operation ) {
		return {
			_tag : "SubscriptionShutdown",
			operation : arguments.operation,
			message : "PubSub subscription is shut down"
		};
	}

	/**
	 * Stops owned children, runs LIFO cleanup, retains all cleanup Causes, and reports terminal diagnostics.
	 *
	 * @initialExit Program outcome before Scope cleanup is added.
	 * @activeScope Scope whose child lifetime and finalizers are being completed.
	 * @closeScope Whether this invocation owns and must close the Scope; defaults to true.
	 * @controlState Optional FiberControl; null means no Fiber cancellation tracking.
	 * @return The final Exit.
	 */
	private any function finishExit(
		required any initialExit,
		required Scope activeScope,
		boolean closeScope = true,
		any controlState = null
	) {
		var completedExit = arguments.initialExit;
		if ( arguments.closeScope ) {
			notifyObserver( "scope:closing", { exit: completedExit } );
			arguments.activeScope._shutdownChildren();
			// Children may still use root resources during their own finalization.
			// Drain releases only after every admitted child interpreter has stopped.
			for ( var finalizerEntry in arguments.activeScope.close() ) {
				var finalizerExit = runFinalizerEntry( finalizerEntry );
				if ( finalizerExit.isFailure() ) {
					completedExit = completedExit.isSuccess()
						? Exit::failure( finalizerExit.cause() )
						: Exit::failure(
							Cause::sequential( completedExit.cause(), finalizerExit.cause() )
						);
				}
			}
			notifyObserver( "scope:closed", { exit: completedExit } );
		}
		notifyTerminalEvents( completedExit, arguments.controlState );
		notifyObserver( "runtime:completed", { exit: completedExit } );
		return completedExit;
	}

	/**
	 * Closes an explicitly owned Scope using the same cleanup ordering as a root run.
	 *
	 * @initialExit Program outcome before Scope cleanup is added.
	 * @activeScope Scope whose child lifetime and finalizers are being completed.
	 * @return The Exit including cleanup failures.
	 */
	any function _closeScopeWithExit( required any initialExit, required Scope activeScope ) {
		return finishExit( arguments.initialExit, arguments.activeScope, true );
	}

	/**
	 * Reports Fiber termination and only defects still present at the runtime boundary.
	 *
	 * @completedExit Execution outcome to publish, unwrap, or combine with cleanup.
	 * @controlState Optional FiberControl; null means no Fiber cancellation tracking.
	 * @return No value.
	 */
	private void function notifyTerminalEvents( required any completedExit, any controlState = null ) {
		if ( !isNull( arguments.controlState ) ) {
			notifyObserver(
				arguments.completedExit.isFailure() && arguments.completedExit.cause().isInterrupted()
					? "fiber:interrupted"
					: "fiber:completed",
				{
					fiberId : arguments.controlState.fiberId(),
					exit : arguments.completedExit
				}
			);
		}
		if ( arguments.completedExit.isFailure() && arguments.completedExit.cause().isDefect() ) {
			notifyObserver( "defect:unhandled", {
				cause : arguments.completedExit.cause(),
				defects : arguments.completedExit.cause().defects()
			} );
		}
	}

	/**
	 * Dispatches diagnostics without letting nonfatal observer errors alter program outcomes.
	 *
	 * @eventName Runtime diagnostic event name.
	 * @details Event-specific diagnostic fields; defaults to an empty struct.
	 * @return No value.
	 */
	private void function notifyObserver( required string eventName, struct details = {} ) {
		if ( isNull( variables.observer ) ) {
			return;
		}

		try {
			if ( isObject( variables.observer ) && structKeyExists( variables.observer, "onEvent" ) ) {
				variables.observer.onEvent( arguments.eventName, arguments.details );
			} else {
				variables.observer( arguments.eventName, arguments.details );
			}
		} catch ( any observerError ) {
			ThrowablePolicy::rethrowIfFatal( observerError );
		}
	}

	/**
	 * Calls an exit handler in its captured Context through finalizer execution.
	 *
	 * @handler Callback receiving the completed Exit and returning the cleanup Effect.
	 * @completedExit Execution outcome to publish, unwrap, or combine with cleanup.
	 * @finalizerContext Context captured at the cleanup boundary or registration site.
	 * @return The cleanup Exit.
	 */
	private any function executeFrameFinalizer(
		required function handler,
		required any completedExit,
		required Context finalizerContext
	) {
		var exitHandler = arguments.handler;
		var exitValue = arguments.completedExit;
		var contextToUse = arguments.finalizerContext;
		return runFinalizer(
			() => exitHandler( exitValue ),
			contextToUse
		);
	}

	/**
	 * Runs a finalizer in a fresh runtime without inheriting the interrupted Fiber control.
	 *
	 * @finalizer Zero-argument callback returning the cleanup Effect.
	 * @finalizerContext Context captured at the cleanup boundary or registration site.
	 * @return The cleanup Exit, including nonfatal callback defects.
	 */
	private any function runFinalizer( required function finalizer, required Context finalizerContext ) {
		try {
			return new EffectRuntime( { executor: executor(), clock: variables.clock } )._runSyncExitWithContext(
				arguments.finalizer(),
				arguments.finalizerContext
			);
		} catch ( any error ) {
			ThrowablePolicy::rethrowIfFatal( error );
			return Exit::failure( Cause::die( error ) );
		}
	}

	/**
	 * Executes a stored release or finalizer with its registration Context.
	 *
	 * @finalizerEntry Stored callback/resource entry with its captured Context.
	 * @return The cleanup Exit.
	 */
	private any function runFinalizerEntry( required struct finalizerEntry ) {
		try {
			var finalizerProgram = structKeyExists( arguments.finalizerEntry, "kind" )
				? arguments.finalizerEntry.release( arguments.finalizerEntry.resource )
				: arguments.finalizerEntry.finalizer();
			return new EffectRuntime( { executor: executor(), clock: variables.clock } )._runSyncExitWithContext(
				finalizerProgram,
				arguments.finalizerEntry.context
			);
		} catch ( any error ) {
			ThrowablePolicy::rethrowIfFatal( error );
			return Exit::failure( Cause::die( error ) );
		}
	}

	/**
	 * Maintains a bounded set of children and collects outcomes by input index.
	 *
	 * @programs Child Effects in input order.
	 * @inheritedContext Service bindings inherited by each child Fiber.
	 * @parentScope Root Scope that atomically admits and owns the children.
	 * @sharedLayerMemo Runtime-private build memo shared with child Fibers; null creates one when optional.
	 * @options Validated concurrency and mode settings controlling child admission and failure collection.
	 * @controlState Optional FiberControl; null means no Fiber cancellation tracking.
	 * @return A success struct with values, or a failure struct with cause.
	 */
	private struct function awaitAll(
		required array programs,
		required Context inheritedContext,
		required Scope parentScope,
		required LayerMemo sharedLayerMemo,
		required struct options,
		any controlState = null
	) {
		if ( arguments.programs.len() == 0 ) {
			return { isSuccess: true, values: [] };
		}

		var concurrencyLimit = arguments.options.concurrency == "unbounded"
			? arguments.programs.len()
			: arguments.options.concurrency;
		var nextIndex = 1;
		var running = [];
		var exitsByIndex = {};

		while ( nextIndex <= arguments.programs.len() && running.len() < concurrencyLimit ) {
			running.append( startIndexedChild(
				arguments.programs[ nextIndex ],
				nextIndex,
				arguments.inheritedContext,
				arguments.parentScope,
				arguments.sharedLayerMemo
			) );
			nextIndex++;
		}

		while ( running.len() > 0 ) {
			var completedResult = awaitOne( awaitIndexedFactories( running ), arguments.controlState );
			var completedExit = completedResult.exit;
			running = removeIndexedFiber( running, completedResult.fiberId );

			if ( completedExit.isFailure() && arguments.options.mode == "failFast" ) {
				interruptIndexedFibers( running );
				return { isSuccess: false, cause: completedExit.cause() };
			}

			exitsByIndex[ completedResult.index ] = completedExit;
			if ( nextIndex <= arguments.programs.len() ) {
				running.append( startIndexedChild(
					arguments.programs[ nextIndex ],
					nextIndex,
					arguments.inheritedContext,
					arguments.parentScope,
					arguments.sharedLayerMemo
				) );
				nextIndex++;
			}
		}

		var combinedCause = null;
		for ( var index = 1; index <= arguments.programs.len(); index++ ) {
			// Completion order varies; input indices keep accumulated Causes stable.
			if ( exitsByIndex[ index ].isFailure() ) {
				combinedCause = isNull( combinedCause )
					? exitsByIndex[ index ].cause()
					: Cause::parallel( combinedCause, exitsByIndex[ index ].cause() );
			}
		}
		if ( !isNull( combinedCause ) ) {
			return { isSuccess: false, cause: combinedCause };
		}

		var values = [];
		for ( var index = 1; index <= arguments.programs.len(); index++ ) {
			values.append( exitsByIndex[ index ].value() );
		}
		return { isSuccess: true, values: values };
	}

	/**
	 * Waits for the first child completion, then interrupts and awaits children.
	 *
	 * @programs Child Effects in input order.
	 * @inheritedContext Service bindings inherited by each child Fiber.
	 * @parentScope Root Scope that atomically admits and owns the children.
	 * @sharedLayerMemo Runtime-private build memo shared with child Fibers; null creates one when optional.
	 * @controlState Optional FiberControl; null means no Fiber cancellation tracking.
	 * @return The winning Exit.
	 */
	private any function awaitAny(
		required array programs,
		required Context inheritedContext,
		required Scope parentScope,
		required LayerMemo sharedLayerMemo,
		any controlState = null
	) {
		var childFibers = forkChildren(
			arguments.programs,
			arguments.inheritedContext,
			arguments.parentScope,
			arguments.sharedLayerMemo
		);
		var completedResult = awaitOne( awaitFactories( childFibers ), arguments.controlState );
		var winnerExit = completedResult.exit;
		interruptFibers( childFibers );
		return winnerExit;
	}

	/**
	 * Waits for the first success, or accumulates every failure by input index.
	 *
	 * @programs Child Effects in input order.
	 * @inheritedContext Service bindings inherited by each child Fiber.
	 * @parentScope Root Scope that atomically admits and owns the children.
	 * @sharedLayerMemo Runtime-private build memo shared with child Fibers; null creates one when optional.
	 * @controlState Optional FiberControl; null means no Fiber cancellation tracking.
	 * @return The winning success Exit or a parallel failure Exit.
	 */
	private any function awaitFirstSuccess(
		required array programs,
		required Context inheritedContext,
		required Scope parentScope,
		required LayerMemo sharedLayerMemo,
		any controlState = null
	) {
		var pendingFibers = [];
		for ( var index = 1; index <= arguments.programs.len(); index++ ) {
			pendingFibers.append( startIndexedChild(
				arguments.programs[ index ],
				index,
				arguments.inheritedContext,
				arguments.parentScope,
				arguments.sharedLayerMemo
			) );
		}
		var failuresByIndex = {};

		while ( pendingFibers.len() > 0 ) {
			var completedResult = awaitOne( awaitIndexedFactories( pendingFibers ), arguments.controlState );
			var completedExit = completedResult.exit;
			pendingFibers = removeIndexedFiber( pendingFibers, completedResult.fiberId );

			if ( completedExit.isSuccess() ) {
				interruptIndexedFibers( pendingFibers );
				return completedExit;
			}
			failuresByIndex[ completedResult.index ] = completedExit.cause();
		}

		var combinedCause = null;
		for ( var index = 1; index <= arguments.programs.len(); index++ ) {
			combinedCause = isNull( combinedCause )
				? failuresByIndex[ index ]
				: Cause::parallel( combinedCause, failuresByIndex[ index ] );
		}
		return Exit::failure( combinedCause );
	}

	/**
	 * Atomically admits a child to the parent Scope and attaches input-order metadata.
	 *
	 * @program Effect to execute within this operation's boundary.
	 * @index One-based input position retained across asynchronous completion.
	 * @inheritedContext Service bindings inherited by each child Fiber.
	 * @parentScope Root Scope that atomically admits and owns the children.
	 * @sharedLayerMemo Runtime-private build memo shared with child Fibers; null creates one when optional.
	 * @return A struct containing index, fiber, and its completion future.
	 */
	private struct function startIndexedChild(
		required Effect program,
		required numeric index,
		required Context inheritedContext,
		required Scope parentScope,
		required LayerMemo sharedLayerMemo
	) {
		var programToRun = arguments.program;
		var contextToUse = arguments.inheritedContext;
		var scopeToUse = arguments.parentScope;
		var layerMemoToUse = arguments.sharedLayerMemo;
		var childFiber = arguments.parentScope._forkChild( () => _runForkWithContext(
			programToRun,
			contextToUse,
			scopeToUse,
			layerMemoToUse
		) );
		var childIndex = arguments.index;
		var childId = childFiber.id();
		return {
			index : childIndex,
			fiber : childFiber,
			completion : childFiber._completionFuture().then( ( completedExit ) => {
				index : childIndex,
				fiberId : childId,
				exit : completedExit
			} )
		};
	}

	/**
	 * Removes a completed child from the local waiting set without mutating the supplied array.
	 *
	 * @indexedFibers Child records containing their input index, Fiber, and completion future.
	 * @fiberId Logical Fiber identifier used in interruption and diagnostics.
	 * @return The remaining indexed children.
	 */
	private array function removeIndexedFiber( required array indexedFibers, required string fiberId ) {
		var remaining = [];
		for ( var indexedFiber in arguments.indexedFibers ) {
			if ( indexedFiber.fiber.id() != arguments.fiberId ) {
				remaining.append( indexedFiber );
			}
		}
		return remaining;
	}

	/**
	 * Requests interruption for all pending indexed children before waiting for each to terminate.
	 *
	 * @indexedFibers Child records containing their input index, Fiber, and completion future.
	 * @return No value.
	 */
	private void function interruptIndexedFibers( required array indexedFibers ) {
		for ( var indexedFiber in arguments.indexedFibers ) {
			if ( !indexedFiber.fiber.isDone() ) {
				indexedFiber.fiber.interrupt();
			}
		}
		for ( var indexedFiber in arguments.indexedFibers ) {
			indexedFiber.fiber._awaitTermination();
		}
	}

	/**
	 * Requests interruption for all pending children before waiting for each to terminate.
	 *
	 * @childFibers Child Fiber handles participating in this operation.
	 * @return No value.
	 */
	private void function interruptFibers( required array childFibers ) {
		for ( var childFiber in arguments.childFibers ) {
			if ( !childFiber.isDone() ) {
				childFiber.interrupt();
			}
		}
		for ( var childFiber in arguments.childFibers ) {
			childFiber._awaitTermination();
		}
	}

	/**
	 * Starts children with inherited Context and shared root ownership.
	 *
	 * @programs Child Effects in input order.
	 * @inheritedContext Service bindings inherited by each child Fiber.
	 * @parentScope Root Scope that atomically admits and owns the children.
	 * @sharedLayerMemo Runtime-private build memo shared with child Fibers; null creates one when optional.
	 * @return An array of admitted Fibers.
	 */
	private array function forkChildren(
		required array programs,
		required Context inheritedContext,
		required Scope parentScope,
		required LayerMemo sharedLayerMemo
	) {
		var children = [];
		for ( var childProgram in arguments.programs ) {
			var programToRun = childProgram;
			var contextToUse = arguments.inheritedContext;
			var scopeToUse = arguments.parentScope;
			var layerMemoToUse = arguments.sharedLayerMemo;
			var childFiber = arguments.parentScope._forkChild( () => _runForkWithContext(
				programToRun,
				contextToUse,
				scopeToUse,
				layerMemoToUse
			) );
			children.append( childFiber );
		}
		return children;
	}

	/**
	 * Builds completion views carrying each child's identity.
	 *
	 * @childFibers Child Fiber handles participating in this operation.
	 * @return An array of native completion futures.
	 */
	private array function awaitFactories( required array childFibers ) {
		var factories = [];
		for ( var childFiber in arguments.childFibers ) {
			factories.append( completionForFiber( childFiber ) );
		}
		return factories;
	}

	/**
	 * Attaches logical identity to a dependent completion view.
	 *
	 * @childFiber Child whose completion is being observed.
	 * @return A native BoxFuture yielding fiberId and exit.
	 */
	private BoxFuture function completionForFiber( required Fiber childFiber ) {
		var fiberToAwait = arguments.childFiber;
		var fiberId = fiberToAwait.id();
		return fiberToAwait._completionFuture().then( ( completedExit ) => {
			fiberId : fiberId,
			exit : completedExit
		} );
	}

	/**
	 * Selects completion futures from indexed child records.
	 *
	 * @indexedFibers Child records containing their input index, Fiber, and completion future.
	 * @return An array of native completion futures.
	 */
	private array function awaitIndexedFactories( required array indexedFibers ) {
		var factories = [];
		for ( var indexedFiber in arguments.indexedFibers ) {
			factories.append( indexedFiber.completion );
		}
		return factories;
	}

	/**
	 * Waits on native asyncAny while registering its future for cancellation.
	 *
	 * @completions Native completion futures supplied to asyncAny.
	 * @controlState Optional FiberControl; null means no Fiber cancellation tracking.
	 * @return The first completed value.
	 */
	private any function awaitOne( required array completions, any controlState = null ) {
		var completionFuture = asyncAny( arguments.completions );
		if ( !isNull( arguments.controlState ) ) {
			arguments.controlState.setActiveFuture( completionFuture );
		}
		try {
			return completionFuture.get();
		} finally {
			if ( !isNull( arguments.controlState ) ) {
				arguments.controlState.clearActiveFuture( completionFuture );
			}
		}
	}

}
