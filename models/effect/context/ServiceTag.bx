/**
 * A stable, namespaced identity for a Context service.
 */
import ortus.boxlang.runtime.scopes.Key as NativeKey;

class {

	variables.tagKey = "";

	/**
	 * Stores a nonblank service key; whitespace is validated but not trimmed from the stored key.
	 *
	 * @tagKey Nonblank stable service key, preserved as supplied.
	 */
	ServiceTag function init( required string tagKey ) {
		if ( arguments.tagKey.trim().len() == 0 ) {
			throw(
				type: "bxeffect.context.InvalidServiceTagException",
				message: "A ServiceTag key must not be blank"
			);
		}
		variables.tagKey = arguments.tagKey;
		return this;
	}

	/**
	 * Creates a service identity from a nonblank key.
	 *
	 * @key Nonblank stable service key.
	 */
	static ServiceTag function of( required string key ) {
		return new ServiceTag( arguments.key );
	}

	/**
	 * Reads the service lookup key.
	 */
	string function key() {
		return variables.tagKey;
	}

	/**
	 * Compares another tag-like object's key using native BoxLang key identity.
	 *
	 * @other Value to compose or compare with this instance.
	 */
	boolean function equals( required any other ) {
		return isObject( arguments.other )
			&& structKeyExists( arguments.other, "key" )
			&& structKeyExists( arguments.other, "hashCode" )
			&& NativeKey::of( variables.tagKey ).equals( NativeKey::of( arguments.other.key() ) );
	}

	/**
	 * Hashes the same native BoxLang key used by equality and Context lookup.
	 */
	numeric function hashCode() {
		return NativeKey::of( variables.tagKey ).hashCode();
	}

	/**
	 * Formats the service identity for diagnostics.
	 */
	string function toString() {
		return "ServiceTag(" & variables.tagKey & ")";
	}

}
