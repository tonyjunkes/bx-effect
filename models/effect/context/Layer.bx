import bxModules.bxEffect.models.effect.Effect;
import bxModules.bxEffect.models.effect.context.Context;
import bxModules.bxEffect.models.effect.context.ServiceTag;

/**
 * A composable recipe for building Context services.
 *
 * `scoped()` is a semantic alias for a resource-producing Layer. The supplied
 * Effect registers its release action with the enclosing runtime Scope.
 * Recipes are ordered builder closures, not a declared dependency graph.
 * Runtime provisioning shares builds by Layer instance identity within a root
 * lifetime; direct build calls invoke the recipe without that memo boundary.
 */
class {

	variables.builder = null;
	variables.layerId = "";

	/**
	 * Stores a service-building recipe and assigns its runtime-local memoization identity.
	 *
	 * @builder Callback receiving a base Context and returning an Effect that produces a Context.
	 */
	Layer function init( required function builder ) {
		variables.builder = arguments.builder;
		variables.layerId = createUUID();
		return this;
	}

	/**
	 * Describes a binding for an already available service.
	 *
	 * @tag ServiceTag identifying the binding.
	 * @service Service implementation stored by reference.
	 */
	static Layer function succeed( required ServiceTag tag, any service ) {
		var providedTag = arguments.tag;
		var providedService = arguments.service;
		return new Layer( ( baseContext ) =>
			Effect::succeed( baseContext.add( providedTag, providedService ) )
		);
	}

	/**
	 * Describes a service built by an Effect using the input Context.
	 *
	 * @tag ServiceTag identifying the binding.
	 * @effectProducingService Effect yielding the service; resource Effects register release with the runtime Scope.
	 */
	static Layer function effect( required ServiceTag tag, required Effect effectProducingService ) {
		var providedTag = arguments.tag;
		var serviceProgram = arguments.effectProducingService;
		return new Layer( ( baseContext ) => serviceProgram
			.provide( baseContext )
			.map( ( service ) => baseContext.add( providedTag, service ) )
		);
	}

	/**
	 * Aliases effect for a resource-producing Effect; acquisition must register its own release.
	 *
	 * @tag ServiceTag identifying the binding.
	 * @effectProducingService Effect yielding the service; resource Effects register release with the runtime Scope.
	 */
	static Layer function scoped( required ServiceTag tag, required Effect effectProducingService ) {
		return Layer::effect( arguments.tag, arguments.effectProducingService );
	}

	/**
	 * Composes recipes in input order so later Layers can use and override earlier services.
	 *
	 * @layers Ordered Layer recipes; later builders receive earlier outputs.
	 */
	static Layer function merge( required array layers ) {
		var layersToMerge = [];
		for ( var suppliedLayer in arguments.layers ) {
			layersToMerge.append( suppliedLayer );
		}
		return new Layer( ( baseContext ) => Layer::buildMerged( baseContext, layersToMerge ) );
	}

	/**
	 * Invokes the stored builder with the supplied Context; runtime provisioning supplies memoization.
	 *
	 * @baseContext Input service bindings available to the Layer build.
	 */
	any function build( required Context baseContext ) {
		return variables.builder( arguments.baseContext );
	}

	/**
	 * Builds this Layer during program execution and restores outer bindings afterward.
	 *
	 * @program Effect to execute within this operation's boundary.
	 */
	Effect function provide( required Effect program ) {
		return Effect::provideLayerInstruction( arguments.program, this );
	}

	/**
	 * Reads the stable identity used by runtime-private build sharing.
	 */
	string function identity() {
		return variables.layerId;
	}

	/**
	 * Builds an iterative Effect chain for the ordered recipes.
	 *
	 * @baseContext Input service bindings available to the Layer build.
	 * @layers Ordered Layer recipes; later builders receive earlier outputs.
	 */
	private static Effect function buildMerged( required Context baseContext, required array layers ) {
		var buildProgram = Effect::succeed( arguments.baseContext );
		for ( var layerValue in arguments.layers ) {
			buildProgram = appendLayer( buildProgram, layerValue );
		}
		return buildProgram;
	}

	/**
	 * Adds a memoized build step using the preceding Context.
	 *
	 * @accumulated Effect yielding the Context built by preceding Layers.
	 * @nextLayer Next recipe to build with the accumulated Context.
	 */
	private static Effect function appendLayer( required Effect accumulated, required Layer nextLayer ) {
		var layerToBuild = arguments.nextLayer;
		return arguments.accumulated.flatMap(
			( buildContext ) => Effect::buildLayerInstruction( layerToBuild, buildContext )
		);
	}

}
