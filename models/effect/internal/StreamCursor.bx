import bxModules.bxEffect.models.effect.Effect;

/**
 * Runtime-private, single-consumption Stream cursor.
 *
 * Pulls yield Effects of native Attempt<Array>; absence marks normal completion.
 * Close is lazy and idempotent, including failed cleanup. Mutable progress is
 * private to one consumer; this cursor is not a concurrent broadcast source.
 */
class {

	variables.pullFactory = null;
	variables.closeFactory = null;
	variables.closed = new java.util.concurrent.atomic.AtomicBoolean( false );
	variables.pending = [];
	variables.pendingIndex = 1;

	/**
	 * Stores per-consumption pull and close factories with an initially open state.
	 *
	 * @pullFactory Factory receiving maximum demand and returning an Effect of native Attempt<Array>; empty means completion.
	 * @closeFactory Zero-argument cleanup Effect factory; defaults to a successful no-op.
	 */
	StreamCursor function init(
		required function pullFactory,
		function closeFactory = () => Effect::succeed( null )
	) {
		variables.pullFactory = arguments.pullFactory;
		variables.closeFactory = arguments.closeFactory;
		return this;
	}

	/**
	 * Defers a bounded batch request, retaining oversized source batches for subsequent demand.
	 *
	 * @demand Maximum number of values requested by this pull; defaults to the whole available batch.
	 */
	Effect function pull( numeric demand = 2147483647 ) {
		var requested = arguments.demand;
		return Effect::suspend( () => {
			if ( variables.closed.get() || requested <= 0 ) {
				return Effect::succeed( attempt() );
			}
			if ( variables.pendingIndex <= variables.pending.len() ) {
				return Effect::succeed( emitPending( requested ) );
			}
			return variables.pullFactory( requested ).map( ( batchAttempt ) => {
				if ( !batchAttempt.isPresent() ) {
					return attempt();
				}
				variables.pending = batchAttempt.get();
				variables.pendingIndex = 1;
				return emitPending( requested );
			} );
		} );
	}

	/**
	 * Emits at most the requested count and clears references to an exhausted batch.
	 *
	 * @demand Maximum number of values requested by this pull.
	 */
	private any function emitPending( required numeric demand ) {
		var available = variables.pending.len() - variables.pendingIndex + 1;
		if ( variables.pendingIndex == 1 && available <= arguments.demand ) {
			var wholeBatch = variables.pending;
			variables.pending = [];
			return attempt( wholeBatch );
		}
		var emitted = [];
		var count = min( available, arguments.demand );
		for ( var index = 1; index <= count; index++ ) {
			emitted.append( variables.pending[ variables.pendingIndex++ ] );
		}
		if ( variables.pendingIndex > variables.pending.len() ) {
			variables.pending = [];
			variables.pendingIndex = 1;
		}
		return attempt( emitted );
	}

	/**
	 * Defers an atomic close claim so the cleanup factory runs at most once, even if it fails.
	 */
	Effect function close() {
		return Effect::suspend( () => {
			if ( !variables.closed.compareAndSet( false, true ) ) {
				return Effect::succeed( null );
			}
			variables.pending = [];
			return variables.closeFactory();
		} );
	}

}
