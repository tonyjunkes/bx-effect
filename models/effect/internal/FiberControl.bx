/**
 * Mutable, runtime-private cancellation state for one logical Fiber.
 *
 * This is deliberately not part of the public Effect value model. It lets a
 * Fiber request cancellation of both its outer runtime future and the native
 * BoxFuture currently awaited by the iterative interpreter.
 */
class {

	variables.activeFuture = new java.util.concurrent.atomic.AtomicReference();
	variables.activeThread = new java.util.concurrent.atomic.AtomicReference();
	variables.fiberId = "";
	variables.interrupted = new java.util.concurrent.atomic.AtomicBoolean( false );

	function init( required string fiberId ) {
		variables.fiberId = arguments.fiberId;
		return this;
	}

	function setActiveFuture( required any future ) {
		variables.activeFuture.set( arguments.future );
		if ( variables.interrupted.get() ) {
			cancelActiveFuture();
		}
		return this;
	}

	function clearActiveFuture( required any future ) {
		variables.activeFuture.compareAndSet( arguments.future, null );
		return this;
	}

	function setActiveThread( required any workerThread ) {
		variables.activeThread.set( arguments.workerThread );
		if ( variables.interrupted.get() ) {
			interruptActiveThread();
		}
		return this;
	}

	function clearActiveThread( required any workerThread ) {
		variables.activeThread.compareAndSet( arguments.workerThread, null );
		return this;
	}

	function interrupt() {
		variables.interrupted.set( true );
		cancelActiveFuture();
		interruptActiveThread();
		return this;
	}

	boolean function isInterrupted() {
		return variables.interrupted.get();
	}

	string function fiberId() {
		return variables.fiberId;
	}

	private function cancelActiveFuture() {
		var currentFuture = variables.activeFuture.get();
		if ( isNull( currentFuture ) || currentFuture.isDone() ) {
			return;
		}

		try {
			currentFuture.cancel( true );
		} catch ( any ignored ) {
			// A BoxFuture implementation may not support cancellation.
		}
	}

	private function interruptActiveThread() {
		var workerThread = variables.activeThread.get();
		if ( isNull( workerThread ) ) {
			return;
		}
		try {
			workerThread.interrupt();
		} catch ( any ignored ) {
			// The worker may have completed between lookup and interruption.
		}
	}

}
