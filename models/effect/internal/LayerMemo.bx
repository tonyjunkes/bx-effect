import bxModules.bxEffect.models.effect.Exit;

/**
 * Runtime-private Layer build coordination shared by a root runtime and its
 * child Fibers. A successful build stays memoized; a failed build is delivered
 * to current waiters and then removed so a later provision can retry.
 */
class {

	variables.outcomes = new java.util.concurrent.ConcurrentHashMap();

	/**
	 * Atomically elects one builder and shares its future with concurrent requests.
	 *
	 * @layerId Stable Layer identity used as the memo key.
	 * @return A struct with owner and outcomeFuture.
	 */
	struct function begin( required string layerId ) {
		var proposedFuture = futureNew();
		// putIfAbsent elects one owner without serializing unrelated Layer builds.
		var existingFuture = variables.outcomes.putIfAbsent( arguments.layerId, proposedFuture );
		return {
			owner : isNull( existingFuture ),
			outcomeFuture : isNull( existingFuture ) ? proposedFuture : existingFuture
		};
	}

	/**
	 * Publishes successful Layer outputs to all waiters and retains the memo entry.
	 *
	 * @outcomeFuture Shared native build future returned by begin.
	 * @value Context containing only explicit Layer outputs, excluding inherited bindings.
	 * @return This memo.
	 */
	LayerMemo function completeSuccess( required any outcomeFuture, required any value ) {
		arguments.outcomeFuture.complete( Exit::success( arguments.value ) );
		return this;
	}

	/**
	 * Removes only this failed attempt so later requests can retry, then notifies existing waiters.
	 *
	 * @layerId Stable Layer identity used as the memo key.
	 * @outcomeFuture Shared native build future returned by begin.
	 * @failureCause Complete Cause to preserve, including composite structure.
	 * @return This memo.
	 */
	LayerMemo function completeFailure(
		required string layerId,
		required any outcomeFuture,
		required any failureCause
	) {
		variables.outcomes.remove( arguments.layerId, arguments.outcomeFuture );
		// Conditional removal cannot erase a newer attempt. Existing waiters still
		// hold the old future and must all receive this attempt's original Cause.
		arguments.outcomeFuture.complete( Exit::failure( arguments.failureCause ) );
		return this;
	}

}
