/**
 * Central policy for JVM conditions that must escape Effect normalization.
 */
class {

	/**
	 * Walks native throwable causes for VM errors, thread death, linkage errors, or InterruptedException.
	 *
	 * @throwableValue Thrown value or native throwable wrapper to inspect.
	 * @return Whether the throwable must escape ordinary defect normalization.
	 */
	static boolean function isFatal( required any throwableValue ) {
		var candidate = arguments.throwableValue;

		while ( !isNull( candidate ) ) {
			if (
				isInstanceOf( candidate, "java.lang.VirtualMachineError" )
				|| isInstanceOf( candidate, "java.lang.ThreadDeath" )
				|| isInstanceOf( candidate, "java.lang.LinkageError" )
				|| isInstanceOf( candidate, "java.lang.InterruptedException" )
			) {
				return true;
			}

			if ( !isInstanceOf( candidate, "java.lang.Throwable" ) ) {
				break;
			}

			candidate = candidate.getCause();
		}

		return false;
	}

	/**
	 * Rethrows the original wrapper if any nested cause is a fatal platform condition.
	 *
	 * @throwableValue Thrown value or native throwable wrapper to inspect.
	 * @return No value for nonfatal inputs.
	 */
	static void function rethrowIfFatal( required any throwableValue ) {
		if ( isFatal( arguments.throwableValue ) ) {
			throw( object: arguments.throwableValue );
		}
	}

}
