/**
 * Central policy for JVM conditions that must escape Effect normalization.
 */
class {

	/**
	 * Walks native throwable causes for VM errors, thread death, linkage errors, or InterruptedException.
	 *
	 * @throwableValue Thrown value or native throwable wrapper to inspect.
	 */
	static boolean function isFatal( required any throwableValue ) {
		var candidate = arguments.throwableValue;

		while ( !isNull( candidate ) ) {
			if (
				isInstanceOf( candidate, "java.lang.VirtualMachineError" )
				|| isInstanceOf( candidate, "java.lang.ThreadDeath" )
				|| isInstanceOf( candidate, "java.lang.LinkageError" )
				|| isInstanceOf( candidate, "java.lang.InterruptedException" )
			) {
				return true;
			}

			if ( !isInstanceOf( candidate, "java.lang.Throwable" ) ) {
				break;
			}

			candidate = candidate.getCause();
		}

		return false;
	}

	/**
	 * Rethrows the original wrapper if any nested cause is a fatal platform condition.
	 *
	 * @throwableValue Thrown value or native throwable wrapper to inspect.
	 */
	static void function rethrowIfFatal( required any throwableValue ) {
		if ( isFatal( arguments.throwableValue ) ) {
			throw( object: arguments.throwableValue );
		}
	}

	/**
	 * Removes native completion/wait wrappers while retaining meaningful operation causes.
	 *
	 * @throwableValue Caught native rejection or factory exception.
	 */
	static any function unwrapCompletion( required any throwableValue ) {
		var candidate = arguments.throwableValue;
		while ( isInstanceOf( candidate, "java.lang.Throwable" ) ) {
			var nested = candidate.getCause();
			if ( isNull( nested ) ) {
				break;
			}
			if ( isInstanceOf( candidate, "java.util.concurrent.ExecutionException" )
				|| isInstanceOf( candidate, "java.util.concurrent.CompletionException" )
				|| ( candidate.getClass().getName() == "ortus.boxlang.runtime.types.exceptions.BoxRuntimeException"
					&& ( isInstanceOf( nested, "java.util.concurrent.ExecutionException" )
						|| isInstanceOf( nested, "java.util.concurrent.CompletionException" )
						|| isInstanceOf( nested, "java.util.concurrent.CancellationException" ) ) ) ) {
				candidate = nested;
			} else {
				break;
			}
		}
		return candidate;
	}

	/**
	 * Recognizes direct native cancellation and its completion/invocation wrappers.
	 *
	 * @throwableValue Thrown value caught at a native wait boundary.
	 */
	static boolean function isCancellation( required any throwableValue ) {
		return isInstanceOf( unwrapCompletion( arguments.throwableValue ), "java.util.concurrent.CancellationException" );
	}

}
