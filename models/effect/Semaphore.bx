import bxModules.bxEffect.models.effect.Effect;

/**
 * An Effect-aware permit source backed by java.util.concurrent.Semaphore.
 *
 * The permit source is intentionally mutable synchronization state. Its public
 * operations remain lazy Effects, and withPermit only releases after acquire
 * has completed successfully.
 */
class {

	variables.permits = null;

	/**
	 * Allocates a fair native semaphore after validating the initial permit count.
	 *
	 * @permits Non-negative whole initial permit count.
	 */
	Semaphore function init( required numeric permits ) {
		validatePermits( arguments.permits );
		variables.permits = new java.util.concurrent.Semaphore( arguments.permits, true );
		return this;
	}

	/**
	 * Creates a mutable permit source with a non-negative whole permit count.
	 *
	 * @permits Non-negative whole initial permit count.
	 */
	static Semaphore function make( required numeric permits ) {
		return new Semaphore( arguments.permits );
	}

	/**
	 * Describes an interruptible wait for one permit; manual acquisition requires matching release.
	 */
	Effect function acquire() {
		return Effect::acquireSemaphoreInstruction( this );
	}

	/**
	 * Describes returning one permit to the source.
	 */
	Effect function release() {
		var permitSource = variables.permits;
		return Effect::sync( () => {
			permitSource.release();
			return null;
		} );
	}

	/**
	 * Acquires one permit and releases it after the program on every outcome.
	 *
	 * @program Effect to execute within this operation's boundary.
	 */
	Effect function withPermit( required Effect program ) {
		var programToRun = arguments.program;
		return Effect::acquireUseRelease( acquire(), ( ignored ) => programToRun, ( ignored ) => release() );
	}

	/**
	 * Reads the current native permit count immediately.
	 */
	numeric function availablePermits() {
		return variables.permits.availablePermits();
	}

	/**
	 * Blocks the interpreter thread until one native permit is acquired.
	 */
	any function acquireNative() {
		variables.permits.acquire();
		return null;
	}

	/**
	 * Rejects negative or fractional permit counts.
	 *
	 * @permits Non-negative whole initial permit count.
	 */
	private static void function validatePermits( required numeric permits ) {
		if ( arguments.permits < 0 || int( arguments.permits ) != arguments.permits ) {
			throw(
				type: "bxeffect.InvalidPermitCountException",
				message: "Semaphore permits must be a non-negative whole number"
			);
		}
	}

}
