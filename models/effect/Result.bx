import ortus.boxlang.runtime.dynamic.Attempt;

/**
 * A pure expected success/failure value.
 *
 * Result does not execute work and deliberately does not model defects,
 * interruption, or service requirements. Those belong to Effect/Exit/Cause.
 */
class {

	variables.resultKind = "";
	variables.resultValue = null;

	/**
	 * Stores a success or expected failure; prefer the named constructors.
	 *
	 * @resultKind Internal Success or Failure discriminator.
	 * @resultValue Success value or expected error payload.
	 * @return This Result.
	 */
	Result function init( required string resultKind, any resultValue ) {
		variables.resultKind = arguments.resultKind;
		if ( structKeyExists( arguments, "resultValue" ) ) {
			variables.resultValue = arguments.resultValue;
		}
		return this;
	}

	/**
	 * Wraps a success value without executing work.
	 *
	 * @value Value carried by this operation; may be null.
	 * @return A successful Result.
	 */
	static Result function success( any value ) {
		return new Result( resultKind: "Success", resultValue: arguments.value );
	}

	/**
	 * Wraps an expected error without a Cause tree.
	 *
	 * @error Expected application error value.
	 * @return A failed Result.
	 */
	static Result function failure( required any error ) {
		return new Result( resultKind: "Failure", resultValue: arguments.error );
	}

	/**
	 * Converts a native Attempt, calling onEmpty immediately only for absence.
	 *
	 * @valueAttempt Native Attempt representing presence or absence.
	 * @onEmpty Zero-argument callback producing the expected error when the Attempt is empty.
	 * @return A success for presence or expected failure for absence.
	 */
	static Result function fromAttempt( required any valueAttempt, required function onEmpty ) {
		return arguments.valueAttempt.isPresent()
			? Result::success( arguments.valueAttempt.get() )
			: Result::failure( arguments.onEmpty() );
	}

	/**
	 * Tests the Result branch.
	 *
	 * @return Whether this Result is successful.
	 */
	boolean function isSuccess() {
		return variables.resultKind == "Success";
	}

	/**
	 * Tests the Result branch.
	 *
	 * @return Whether this Result is an expected failure.
	 */
	boolean function isFailure() {
		return variables.resultKind == "Failure";
	}

	/**
	 * Reads the success branch.
	 *
	 * @return The success value, or null on failure.
	 */
	any function value() {
		return isSuccess() ? variables.resultValue : null;
	}

	/**
	 * Reads the failure branch.
	 *
	 * @return The expected error, or null on success.
	 */
	any function error() {
		return isFailure() ? variables.resultValue : null;
	}

	/**
	 * Transforms success immediately; callback exceptions propagate to the caller.
	 *
	 * @mapper Callback receiving a success value and returning its replacement.
	 * @return A mapped Result, or this failure unchanged.
	 */
	Result function map( required function mapper ) {
		return isFailure()
			? this
			: Result::success( arguments.mapper( variables.resultValue ) );
	}

	/**
	 * Chains a Result-producing callback immediately on success.
	 *
	 * @mapper Callback receiving a success value and returning the next Result.
	 * @return The callback Result, or this failure unchanged.
	 */
	any function flatMap( required function mapper ) {
		return isFailure() ? this : arguments.mapper( variables.resultValue );
	}

	/**
	 * Transforms the expected error immediately; callback exceptions propagate.
	 *
	 * @mapper Callback receiving a single expected error and returning its replacement.
	 * @return A mapped failure, or this success unchanged.
	 */
	Result function mapError( required function mapper ) {
		return isSuccess()
			? this
			: Result::failure( arguments.mapper( variables.resultValue ) );
	}

	/**
	 * Calls exactly one branch handler immediately.
	 *
	 * @onSuccess Callback receiving the success value.
	 * @onFailure Callback receiving the expected error.
	 * @return The selected handler result.
	 */
	any function match( required function onSuccess, required function onFailure ) {
		return isSuccess()
			? arguments.onSuccess( variables.resultValue )
			: arguments.onFailure( variables.resultValue );
	}

	/**
	 * Converts success to native presence and discards failure information.
	 *
	 * @return A native Attempt.
	 */
	Attempt function toAttempt() {
		return isSuccess() ? attempt( variables.resultValue ) : attempt();
	}

}
