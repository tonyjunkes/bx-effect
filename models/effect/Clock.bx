import ortus.boxlang.runtime.async.BoxFuture;
import java.lang.System;

/**
 * Live runtime clock backed by BoxFuture's delayed executor.
 */
class {

	variables.originNanos = System::nanoTime();
	variables.originMillis = System::currentTimeMillis();

	/**
	 * Reads the live Clock time used by runtime recurrence calculations.
	 */
	numeric function now() {
		return variables.originMillis + int( ( System::nanoTime() - variables.originNanos ) / 1000000 );
	}

	/**
	 * Starts a native delayed future immediately; Effect.sleep supplies the lazy boundary.
	 *
	 * @duration Non-negative delay or elapsed amount in the supplied unit.
	 * @unit Time unit; defaults to milliseconds when omitted.
	 */
	BoxFuture function sleep( required numeric duration, string unit = "milliseconds" ) {
		if ( arguments.duration < 0 ) {
			throw( type: "bxeffect.InvalidDurationException", message: "Clock sleep requires a non-negative duration" );
		}
		return BoxFuture::ofFunction(
			getBoxContext(),
			() => null,
			BoxFuture::delayedExecutor( arguments.duration, arguments.unit )
		);
	}

}
