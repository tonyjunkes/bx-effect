import ortus.boxlang.runtime.dynamic.Attempt;
import ortus.boxlang.runtime.async.BoxFuture;
import bxModules.bxEffect.models.effect.Cause;
import bxModules.bxEffect.models.effect.Exit;
import bxModules.bxEffect.models.effect.internal.FiberControl;
import bxModules.bxEffect.models.effect.internal.ThrowablePolicy;

/**
 * A logical handle for a BoxFuture-backed Effect execution.
 *
 * Interruption is best effort: BoxFuture cancellation is delegated to the
 * executor selected by BoxLang and cannot force arbitrary user code to stop.
 */
class {

	variables.future = null;
	variables.fiberId = "";
	variables.control = null;
	variables.terminationFuture = null;

	/**
	 * Attaches a handle to runtime completion, cancellation state, and interpreter termination.
	 *
	 * @future Native BoxFuture currently representing execution or a registered wait.
	 * @fiberId Logical Fiber identifier used in interruption and diagnostics.
	 * @control Runtime-private cancellation state for this Fiber.
	 * @terminationFuture Optional future resolved by interpreter finalization, independently of public cancellation.
	 */
	Fiber function init(
		required any future,
		required string fiberId,
		required FiberControl control,
		any terminationFuture = null
	) {
		variables.future = arguments.future;
		variables.fiberId = arguments.fiberId;
		variables.control = arguments.control;
		variables.terminationFuture = isNull( arguments.terminationFuture )
			? arguments.future.then( ( completedExit ) => completedExit )
			: arguments.terminationFuture;
		return this;
	}

	/**
	 * Blocks on public completion and normalizes nonfatal wait errors into an Exit.
	 */
	any function await() {
		try {
			return variables.future.get();
		} catch ( any error ) {
			ThrowablePolicy::rethrowIfFatal( error );
			return variables.control.isInterrupted()
				? Exit::failure( Cause::interrupt( variables.fiberId ) )
				: Exit::failure( Cause::die( error ) );
		}
	}

	/**
	 * Blocks and unwraps success; failure throws EffectFailureException with the Cause.
	 */
	any function join() {
		var completedExit = this.await();
		if ( completedExit.isSuccess() ) {
			return completedExit.value();
		}

		throw(
			type: "bxeffect.EffectFailureException",
			message: completedExit.cause().pretty(),
			extendedInfo: completedExit.cause()
		);
	}

	/**
	 * Checks public completion immediately without waiting.
	 */
	Attempt function poll() {
		return isDone() ? attempt( await() ) : attempt();
	}

	/**
	 * Requests cancellation of the active wait and outer runtime task without awaiting cleanup.
	 */
	Fiber function interrupt() {
		variables.control.interrupt();
		if ( !isDone() ) {
			try {
				variables.future.cancel( true );
			} catch ( any ignored ) {
				// Some executor implementations may not expose cancellation.
			}
		}
		return this;
	}

	/**
	 * Checks public future completion, which may precede cleanup after cancellation.
	 */
	boolean function isDone() {
		return variables.future.isDone();
	}

	/**
	 * Reads the logical execution identity.
	 */
	string function id() {
		return variables.fiberId;
	}

	/**
	 * Creates a dependent view of public completion for internal concurrency operators.
	 */
	BoxFuture function completionFuture() {
		return variables.future.then( ( completedExit ) => completedExit );
	}

	/**
	 * Creates an internal dependent view of actual interpreter termination.
	 */
	BoxFuture function terminationFuture() {
		return variables.terminationFuture.then( ( completedExit ) => completedExit );
	}

	/**
	 * Blocks until interpreter finalization has finished, even after public cancellation.
	 */
	Fiber function awaitTermination() {
		variables.terminationFuture.get();
		return this;
	}

	/**
	 * Checks whether this Fiber still owns a terminal cleanup failure.
	 */
	boolean function hasCleanupFailure() {
		return variables.control.hasCleanupFailure();
	}

	/**
	 * Claims the terminal cleanup failure once for the owning Scope or operator.
	 */
	any function takeCleanupFailure() {
		return variables.control.takeCleanupFailure();
	}

}
