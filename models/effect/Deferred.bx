import ortus.boxlang.runtime.dynamic.Attempt;
import bxModules.bxEffect.models.effect.Cause;
import bxModules.bxEffect.models.effect.Effect;
import bxModules.bxEffect.models.effect.Exit;

/**
 * A single-assignment coordination value backed by one native BoxFuture.
 *
 * Completion operations are lazy Effects. Each awaiter receives a dependent
 * future so Fiber cancellation cannot cancel this Deferred's shared outcome.
 */
class {

	variables.outcomeFuture = null;

	/**
	 * Allocates one incomplete native BoxFuture for the shared outcome.
	 */
	Deferred function init() {
		variables.outcomeFuture = futureNew();
		return this;
	}

	/**
	 * Creates application-owned one-shot coordination state.
	 */
	static Deferred function make() {
		return new Deferred();
	}

	/**
	 * Lazily waits through a dependent future so canceling one waiter cannot cancel the shared result.
	 */
	Effect function await() {
		var sourceFuture = variables.outcomeFuture;
		// Allocate a new dependent wait on every execution, including reruns of
		// the same await Effect. Cancellation must not poison future awaiters.
		return Effect::fromBoxFuture(
			() => sourceFuture.then( ( outcome ) => outcome )
		).flatMap( ( outcome ) => exitToEffect( outcome ) );
	}

	/**
	 * Lazily attempts the first completion; later attempts leave the outcome unchanged.
	 *
	 * @outcome Exit containing the shared success value or complete Cause.
	 */
	Effect function complete( required any outcome ) {
		var outcomeToComplete = arguments.outcome;
		return Effect::sync( () => {
			validateExit( outcomeToComplete );
			return variables.outcomeFuture.complete( outcomeToComplete );
		} );
	}

	/**
	 * Lazily attempts completion with a success value.
	 *
	 * @value Value carried by this operation; may be null.
	 */
	Effect function succeed( any value ) {
		return complete( Exit::success( arguments.value ) );
	}

	/**
	 * Lazily attempts completion with an expected error.
	 *
	 * @error Expected application error value.
	 */
	Effect function fail( required any error ) {
		return complete( Exit::failure( Cause::fail( arguments.error ) ) );
	}

	/**
	 * Lazily attempts completion with a defect.
	 *
	 * @defect Unexpected failure value retained in the defect channel.
	 */
	Effect function die( required any defect ) {
		return complete( Exit::failure( Cause::die( arguments.defect ) ) );
	}

	/**
	 * Lazily attempts completion with an interruption Cause.
	 *
	 * @fiberId Logical Fiber identifier used in interruption and diagnostics.
	 */
	Effect function interrupt( required any fiberId ) {
		return complete( Exit::failure( Cause::interrupt( arguments.fiberId ) ) );
	}

	/**
	 * Checks completion immediately without waiting.
	 */
	Attempt function poll() {
		return isDone() ? attempt( variables.outcomeFuture.get() ) : attempt();
	}

	/**
	 * Checks the shared future immediately.
	 */
	boolean function isDone() {
		return variables.outcomeFuture.isDone();
	}

	/**
	 * Reconstitutes an Exit without losing its failure channels.
	 *
	 * @outcome Exit containing the shared success value or complete Cause.
	 */
	private static Effect function exitToEffect( required any outcome ) {
		validateExit( arguments.outcome );
		return arguments.outcome.isSuccess()
			? Effect::succeed( arguments.outcome.value() )
			: Effect::haltInstruction( arguments.outcome.cause() );
	}

	/**
	 * Checks the structural Exit contract before accepting an outcome.
	 *
	 * @outcome Exit containing the shared success value or complete Cause.
	 */
	private static void function validateExit( required any outcome ) {
		if (
			!isObject( arguments.outcome )
			|| !structKeyExists( arguments.outcome, "isSuccess" )
			|| !structKeyExists( arguments.outcome, "isFailure" )
		) {
			throw(
				type: "bxeffect.InvalidDeferredOutcomeException",
				message: "Deferred completion requires an Exit"
			);
		}
	}

}
