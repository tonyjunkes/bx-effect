import bxModules.bxEffect.models.effect.Fiber;
import ortus.boxlang.runtime.async.BoxFuture;
import bxModules.bxEffect.models.effect.Cause;
import bxModules.bxEffect.models.effect.EffectRuntime;
import bxModules.bxEffect.models.effect.Exit;
import bxModules.bxEffect.models.effect.Result;
import bxModules.bxEffect.models.effect.context.Context;
import bxModules.bxEffect.models.effect.context.ServiceTag;
import bxModules.bxEffect.models.effect.internal.ErrorTagResolver;
import bxModules.bxEffect.models.effect.Schedule;

/**
 * A lazy description of an effectful computation.
 *
 * Public constructors and operators only build instruction nodes. User code is
 * evaluated exclusively by EffectRuntime at an explicit execution boundary.
 */
class {

	variables.instruction = {};

	/**
	 * Stores an internal instruction node without evaluating it.
	 *
	 * @instruction Internal instruction node consumed by EffectRuntime; treat as read-only.
	 */
	Effect function init( required struct instruction ) {
		variables.instruction = arguments.instruction;
		return this;
	}

	/**
	 * Describes a computation that succeeds with the supplied value.
	 *
	 * @value Value carried by this operation; may be null.
	 */
	static Effect function succeed( any value ) {
		return new Effect( {
			kind : "Succeed",
			value : arguments.value
		} );
	}

	/**
	 * Describes an expected failure, recoverable with catchAll.
	 *
	 * @error Expected application error value.
	 */
	static Effect function fail( required any error ) {
		return new Effect( {
			kind : "Fail",
			error : arguments.error
		} );
	}

	/**
	 * Defers a value-producing callback until execution; thrown exceptions become defects.
	 *
	 * @thunk Zero-argument callback returning a value; executed once per run.
	 */
	static Effect function sync( required function thunk ) {
		return new Effect( {
			kind : "Sync",
			thunk : arguments.thunk
		} );
	}

	/**
	 * Maps exceptions from the supplied callback into expected failures; mapper exceptions are defects.
	 *
	 * @try Zero-argument throwing callback returning the success value.
	 * @catch Exception-to-expected-error mapper; defaults to returning the exception unchanged.
	 */
	static Effect function try( required function try, function catch = ( error ) -> error ) {
		return new Effect( {
			kind : "Try",
			thunk : arguments.try,
			errorMapper : arguments.catch
		} );
	}

	/**
	 * Defers construction of the next Effect until each execution.
	 *
	 * @thunk Zero-argument callback returning the next Effect; executed once per evaluation.
	 */
	static Effect function suspend( required function thunk ) {
		return new Effect( {
			kind : "Suspend",
			thunk : arguments.thunk
		} );
	}

	/**
	 * Converts presence to success and lazily creates an expected error for absence.
	 *
	 * @valueAttempt Native Attempt representing presence or absence.
	 * @onEmpty Zero-argument callback producing the expected error when the Attempt is empty.
	 */
	static Effect function fromAttempt( required any valueAttempt, required function onEmpty ) {
		var sourceAttempt = arguments.valueAttempt;
		var emptyHandler = arguments.onEmpty;
		return Effect::suspend( () => sourceAttempt.isPresent()
			? Effect::succeed( sourceAttempt.get() )
			: Effect::fail( emptyHandler() )
		);
	}

	/**
	 * Lifts a Result into success or expected failure without executing work.
	 *
	 * @outcome Result whose success or expected error is lifted.
	 */
	static Effect function fromResult( required Result outcome ) {
		return arguments.outcome.isSuccess()
			? Effect::succeed( arguments.outcome.value() )
			: Effect::fail( arguments.outcome.error() );
	}

	/**
	 * Lifts a complete Exit without collapsing defects or interruption.
	 *
	 * @outcome Exit whose success or complete failure is lifted.
	 */
	static Effect function fromExit( required any outcome ) {
		return arguments.outcome.isSuccess()
			? Effect::succeed( arguments.outcome.value() )
			: Effect::failCause( arguments.outcome.cause() );
	}

	/**
	 * Describes an existing complete Cause, preserving its identity and structure.
	 *
	 * @failureCause Complete failure tree to re-emit.
	 */
	static Effect function failCause( required Cause failureCause ) {
		return Effect::haltInstruction( arguments.failureCause );
	}

	/**
	 * Describes an explicit defect; catchAll does not recover this channel.
	 *
	 * @defect Unexpected failure value.
	 */
	static Effect function die( required any defect ) {
		return Effect::failCause( Cause::die( arguments.defect ) );
	}

	/**
	 * Looks up a service at execution time; a missing binding is a wiring defect.
	 *
	 * @tag ServiceTag identifying the binding.
	 */
	static Effect function service( required ServiceTag tag ) {
		return new Effect( {
			kind : "AccessService",
			tag : arguments.tag
		} );
	}

	/**
	 * Acquires a resource and registers release in the current Scope before observing pending interruption.
	 *
	 * @acquire Effect producing the resource; failed acquisition does not register release.
	 * @release Callback receiving the acquired resource and returning its cleanup Effect.
	 */
	static Effect function acquireRelease( required Effect acquire, required function release ) {
		return new Effect( {
			kind : "AcquireRelease",
			acquire : arguments.acquire,
			release : arguments.release
		} );
	}

	/**
	 * Creates and awaits a native BoxFuture only when executed; rejected futures become defects unless interrupted.
	 *
	 * @futureFactory Zero-argument factory returning a native BoxFuture at execution time.
	 */
	static Effect function fromBoxFuture( required function futureFactory ) {
		return new Effect( {
			kind : "AsyncFuture",
			futureFactory : arguments.futureFactory
		} );
	}

	/**
	 * Acquires lazily and releases at the use boundary before any following work or recovery.
	 *
	 * @acquire Effect producing the resource; failed acquisition does not register release.
	 * @use Callback receiving the resource and returning the Effect to run before release.
	 * @release Callback receiving the resource and use Exit, returning its cleanup Effect.
	 */
	static Effect function acquireUseRelease(
		required Effect acquire,
		required function use,
		required function release
	) {
		return new Effect( {
			kind : "AcquireUseRelease",
			acquire : arguments.acquire,
			use : arguments.use,
			release : arguments.release
		} );
	}

	/**
	 * Builds a runtime-private interruptible permit acquisition.
	 *
	 * @permitSource Internal Semaphore exposing native interruptible acquisition.
	 */
	static Effect function acquireSemaphoreInstruction( required any permitSource ) {
		return new Effect( {
			kind : "SemaphoreAcquire",
			permitSource : arguments.permitSource
		} );
	}

	/**
	 * Builds a runtime-private interruptible Queue offer.
	 *
	 * @queueSource Application-owned Queue; this operation does not transfer ownership.
	 * @value Value carried by this operation; may be null.
	 */
	static Effect function offerQueueInstruction( required any queueSource, any value ) {
		return new Effect( {
			kind : "QueueOffer",
			queueSource : arguments.queueSource,
			value : arguments.value
		} );
	}

	/**
	 * Builds a runtime-private interruptible Queue take.
	 *
	 * @queueSource Application-owned Queue; this operation does not transfer ownership.
	 */
	static Effect function takeQueueInstruction( required any queueSource ) {
		return new Effect( {
			kind : "QueueTake",
			queueSource : arguments.queueSource
		} );
	}

	/**
	 * Builds a runtime-private interruptible broadcast.
	 *
	 * @pubSubSource Parent PubSub hub coordinating subscription state and waits.
	 * @value Value carried by this operation; may be null.
	 */
	static Effect function publishPubSubInstruction( required any pubSubSource, any value ) {
		return new Effect( {
			kind : "PubSubPublish",
			pubSubSource : arguments.pubSubSource,
			value : arguments.value
		} );
	}

	/**
	 * Builds a runtime-private subscription acquisition.
	 *
	 * @pubSubSource Parent PubSub hub coordinating subscription state and waits.
	 */
	static Effect function subscribePubSubInstruction( required any pubSubSource ) {
		return new Effect( {
			kind : "PubSubSubscribe",
			pubSubSource : arguments.pubSubSource
		} );
	}

	/**
	 * Builds a runtime-private interruptible subscription take.
	 *
	 * @subscriptionSource Subscription whose parent hub coordinates the wait.
	 */
	static Effect function takeSubscriptionInstruction( required any subscriptionSource ) {
		return new Effect( {
			kind : "PubSubTake",
			subscriptionSource : arguments.subscriptionSource
		} );
	}

	/**
	 * Builds runtime-private Layer provisioning with Context restoration.
	 *
	 * @program Effect to execute within this operation's boundary.
	 * @layer Layer recipe participating in runtime-local build sharing.
	 */
	static Effect function provideLayerInstruction( required Effect program, required any layer ) {
		return new Effect( {
			kind : "ProvideLayer",
			effect : arguments.program,
			layer : arguments.layer
		} );
	}

	/**
	 * Builds a runtime-private memoized Layer request.
	 *
	 * @layer Layer recipe participating in runtime-local build sharing.
	 * @baseContext Input service bindings available to the Layer build.
	 */
	static Effect function buildLayerInstruction( required any layer, required Context baseContext ) {
		return new Effect( {
			kind : "BuildLayer",
			layer : arguments.layer,
			baseContext : arguments.baseContext
		} );
	}

	/**
	 * Runs branches with bounded or unbounded concurrency and preserves input order; accumulate mode retains all Causes.
	 *
	 * @effects Input Effects; array order determines result and accumulated Cause order.
	 * @options concurrency: positive integer or unbounded (default); mode: failFast (default) or accumulate.
	 */
	static Effect function all( required array effects, struct options = {} ) {
		return new Effect( {
			kind : "All",
			effects : copyEffects( arguments.effects ),
			options : normalizeAllOptions( arguments.options )
		} );
	}

	/**
	 * Lazily maps values to Effects, sequentially by default, with optional concurrency and result discard.
	 *
	 * @values Input values in encounter order.
	 * @mapper Callback receiving value and one-based index and returning an Effect.
	 * @options concurrency defaults to 1; mode defaults to failFast; discard defaults to false.
	 */
	static Effect function forEach(
		required array values,
		required function mapper,
		struct options = {}
	) {
		var allOptions = { concurrency: 1 };
		var discardResults = false;
		for ( var optionName in arguments.options ) {
			if ( listFindNoCase( "concurrency,discard,mode", optionName ) == 0 ) {
				throw(
					type: "bxeffect.InvalidForEachOptionException",
					message: "Effect.forEach() does not support option [#optionName#]"
				);
			}
		}
		if ( structKeyExists( arguments.options, "concurrency" ) ) {
			allOptions.concurrency = arguments.options.concurrency;
		}
		if ( structKeyExists( arguments.options, "mode" ) ) {
			allOptions.mode = arguments.options.mode;
		}
		if ( structKeyExists( arguments.options, "discard" ) ) {
			if ( !isBoolean( arguments.options.discard ) ) {
				throw(
					type: "bxeffect.InvalidForEachOptionException",
					message: "Effect.forEach() discard must be boolean"
				);
			}
			discardResults = arguments.options.discard;
		}

		var programs = [];
		// Capture each value/index now, but invoke its mapper only inside Suspend.
		// This preserves laziness even when all() later starts branches concurrently.
		for ( var index = 1; index <= arguments.values.len(); index++ ) {
			programs.append( forEachProgram(
				arguments.values[ index ],
				index,
				arguments.mapper
			) );
		}

		var normalizedOptions = normalizeAllOptions( allOptions );
		normalizedOptions.discard = discardResults;
		return new Effect( { kind: "All", effects: programs, options: normalizedOptions } );
	}

	/**
	 * Races a nonempty array for the first completion, then interrupts and awaits remaining children.
	 *
	 * @effects Input Effects; array order determines result and accumulated Cause order.
	 */
	static Effect function race( required array effects ) {
		if ( arguments.effects.len() == 0 ) {
			throw(
				type: "bxeffect.EmptyRaceException",
				message: "Effect.race() requires at least one Effect"
			);
		}
		return new Effect( {
			kind : "Race",
			effects : copyEffects( arguments.effects )
		} );
	}

	/**
	 * Races for the first success; if every branch fails, combines Causes in input order.
	 *
	 * @effects Input Effects; array order determines result and accumulated Cause order.
	 */
	static Effect function firstSuccessOf( required array effects ) {
		if ( arguments.effects.len() == 0 ) {
			throw(
				type: "bxeffect.EmptyFirstSuccessException",
				message: "Effect.firstSuccessOf() requires at least one Effect"
			);
		}
		return new Effect( {
			kind : "FirstSuccess",
			effects : copyEffects( arguments.effects )
		} );
	}

	/**
	 * Describes an interruptible delay using the runtime Clock.
	 *
	 * @duration Non-negative delay or elapsed amount in the supplied unit.
	 * @unit Time unit; defaults to milliseconds when omitted.
	 */
	static Effect function sleep( required numeric duration, string unit = "milliseconds" ) {
		if ( arguments.duration < 0 ) {
			throw( type: "bxeffect.InvalidDurationException", message: "Effect.sleep() requires a non-negative duration" );
		}
		return new Effect( {
			kind : "Sleep",
			duration : arguments.duration,
			unit : arguments.unit
		} );
	}

	/**
	 * Builds an internal failure node without collapsing an existing Cause.
	 *
	 * @failureCause Complete Cause to preserve, including composite structure.
	 */
	static Effect function haltInstruction( required any failureCause ) {
		return new Effect( {
			kind : "Halt",
			cause : arguments.failureCause
		} );
	}

	/**
	 * Transforms a success value lazily; callback exceptions become defects.
	 *
	 * @mapper Callback receiving a success value and returning its replacement.
	 */
	Effect function map( required function mapper ) {
		return new Effect( {
			kind : "Map",
			effect : this,
			mapper : arguments.mapper
		} );
	}

	/**
	 * Sequences a dependent Effect after success without recursive interpretation.
	 *
	 * @mapper Callback receiving a success value and returning the next Effect.
	 */
	Effect function flatMap( required function mapper ) {
		return new Effect( {
			kind : "FlatMap",
			effect : this,
			mapper : arguments.mapper
		} );
	}

	/**
	 * Runs an effectful observer after success and retains the original value if observation
	 * succeeds.
	 *
	 * @observer Callback receiving a success value and returning an observation Effect.
	 */
	Effect function tap( required function observer ) {
		var effectfulObserver = arguments.observer;
		return flatMap( ( value ) => effectfulObserver( value ).as( value ) );
	}

	/**
	 * Observes an expected failure without recovering it.
	 *
	 * @handler Callback receiving the expected error and returning an observation Effect.
	 */
	Effect function tapError( required function handler ) {
		var errorHandler = arguments.handler;
		return catchAll( ( error ) => Effect::suspend( () => errorHandler( error ) )
			.foldCause(
				( handlerCause ) => Effect::haltInstruction(
					Cause::sequential( Cause::fail( error ), handlerCause )
				),
				( ignored ) => Effect::fail( error )
			)
		);
	}

	/**
	 * Observes any failure Cause without recovering it.
	 *
	 * @handler Callback receiving the complete Cause and returning an observation Effect.
	 */
	Effect function tapCause( required function handler ) {
		var causeHandler = arguments.handler;
		return catchCause( ( failureCause ) => Effect::suspend( () => causeHandler( failureCause ) )
			.foldCause(
				( handlerCause ) => Effect::haltInstruction(
					Cause::sequential( failureCause, handlerCause )
				),
				( ignored ) => Effect::haltInstruction( failureCause )
			)
		);
	}

	/**
	 * Captures the program outcome as data at this point in the instruction graph.
	 */
	Effect function exit() {
		return foldCause(
			( failureCause ) => Effect::succeed( Exit::failure( failureCause ) ),
			( value ) => Effect::succeed( Exit::success( value ) )
		);
	}

	/**
	 * Sequences another Effect and pairs the success values.
	 *
	 * @other Value to compose or compare with this instance.
	 */
	Effect function zip( required Effect other ) {
		return zipWith( arguments.other, ( left, right ) => [ left, right ] );
	}

	/**
	 * Sequences another Effect and combines both success values.
	 *
	 * @other Value to compose or compare with this instance.
	 * @combiner Callback receiving left and right success values and returning their combination.
	 */
	Effect function zipWith( required Effect other, required function combiner ) {
		var rightProgram = arguments.other;
		var combineValues = arguments.combiner;
		return flatMap( ( left ) => rightProgram.map(
			( right ) => combineValues( left, right )
		) );
	}

	/**
	 * Replaces only the success value while retaining failures.
	 *
	 * @value Value carried by this operation; may be null.
	 */
	Effect function as( any value ) {
		var replacement = arguments.value;
		return map( ( ignored ) => replacement );
	}

	/**
	 * Discards the success value while retaining failures.
	 */
	Effect function asVoid() {
		return as( null );
	}

	/**
	 * Chooses an effectful continuation for success or the complete Cause.
	 *
	 * @onFailure Callback receiving the complete Cause and returning a recovery Effect.
	 * @onSuccess Callback receiving the success value and returning the next Effect.
	 */
	Effect function foldCause( required function onFailure, required function onSuccess ) {
		return new Effect( {
			kind : "FoldCause",
			effect : this,
			onFailure : arguments.onFailure,
			onSuccess : arguments.onSuccess
		} );
	}

	/**
	 * Recovers explicitly from any Cause, including defects and interruption.
	 *
	 * @handler Callback receiving the complete Cause and returning a recovery Effect.
	 */
	Effect function catchCause( required function handler ) {
		return foldCause(
			arguments.handler,
			( value ) => Effect::succeed( value )
		);
	}

	/**
	 * Recovers only a single Fail Cause; composite Causes, defects, and interruption pass through.
	 *
	 * @handler Callback receiving the single expected error and returning a recovery Effect.
	 */
	Effect function catchAll( required function handler ) {
		var errorHandler = arguments.handler;
		return foldCause(
			( effectCause ) => effectCause.kind() == "Fail"
				? errorHandler( effectCause.error() )
				: Effect::haltInstruction( effectCause ),
			( value ) => Effect::succeed( value )
		);
	}

	/**
	 * Transforms a single expected error; all other Causes pass through.
	 *
	 * @mapper Callback receiving a single expected error and returning its replacement.
	 */
	Effect function mapError( required function mapper ) {
		var errorMapper = arguments.mapper;
		return catchAll( ( error ) => Effect::fail( errorMapper( error ) ) );
	}

	/**
	 * Recovers a single expected error only when its predicate is true.
	 *
	 * @predicate Callback receiving the expected error and returning whether to recover it.
	 * @handler Callback receiving the matching expected error and returning a recovery Effect.
	 */
	Effect function catchIf( required function predicate, required function handler ) {
		var shouldCatch = arguments.predicate;
		var errorHandler = arguments.handler;
		return catchAll( ( error ) => shouldCatch( error )
			? errorHandler( error )
			: Effect::fail( error )
		);
	}

	/**
	 * Recovers a single expected error matching the centralized tag convention.
	 *
	 * @tag Expected error tag matched using ErrorTagResolver.
	 * @handler Callback receiving the matching expected error and returning a recovery Effect.
	 */
	Effect function catchTag( required string tag, required function handler ) {
		var expectedTag = arguments.tag;
		return catchIf(
			( error ) => ErrorTagResolver::resolve( error ) == expectedTag,
			arguments.handler
		);
	}

	/**
	 * Recovers one expected tagged failure through a copied native handler table.
	 *
	 * @handlers Tag-to-recovery callbacks receiving the matching expected error.
	 */
	Effect function catchTags( required struct handlers ) {
		var tagHandlers = arguments.handlers.copy();
		return catchAll( ( error ) => {
			var errorTag = ErrorTagResolver::resolve( error );
			return !isNull( errorTag ) && structKeyExists( tagHandlers, errorTag )
				? tagHandlers[ errorTag ]( error )
				: Effect::fail( error );
		} );
	}

	/**
	 * Runs the fallback only for a single expected failure.
	 *
	 * @fallback Effect executed only after an expected failure.
	 */
	Effect function orElse( required Effect fallback ) {
		var fallbackEffect = arguments.fallback;
		return catchAll( ( ignored ) => fallbackEffect );
	}

	/**
	 * Keeps a success value satisfying the predicate, otherwise creates an expected failure.
	 *
	 * @predicate Callback receiving the success value and returning whether to retain it.
	 * @onFalse Callback receiving a rejected success value and producing an expected error.
	 */
	Effect function filterOrFail( required function predicate, required function onFalse ) {
		var filterPredicate = arguments.predicate;
		var failureFactory = arguments.onFalse;
		return flatMap( ( value ) => filterPredicate( value )
			? Effect::succeed( value )
			: Effect::fail( failureFactory( value ) )
		);
	}

	/**
	 * Runs cleanup after every outcome and appends cleanup failures sequentially to an existing Cause.
	 *
	 * @finalizer Effect to execute as cleanup on every outcome.
	 */
	Effect function ensuring( required Effect finalizer ) {
		var finalizerEffect = arguments.finalizer;
		return onExit( ( ignoredExit ) => finalizerEffect );
	}

	/**
	 * Runs an effectful cleanup handler with the outcome before continuing or recovering outside this boundary.
	 *
	 * @handler Callback receiving the completed Exit and returning a cleanup Effect.
	 */
	Effect function onExit( required function handler ) {
		return new Effect( {
			kind : "Ensuring",
			effect : this,
			handler : arguments.handler
		} );
	}

	/**
	 * Starts a child Fiber when executed, owned by the current runtime Scope.
	 */
	Effect function fork() {
		return new Effect( {
			kind : "Fork",
			effect : this
		} );
	}

	/**
	 * Re-executes only single expected failures according to a Schedule.
	 *
	 * @policy Schedule-compatible object or shorthand struct with a times count.
	 */
	Effect function retry( required any policy ) {
		return new Effect( {
			kind : "Retry",
			effect : this,
			schedule : Schedule::coerce( arguments.policy )
		} );
	}

	/**
	 * Re-executes successful runs according to a Schedule; any failure stops repetition.
	 *
	 * @policy Schedule-compatible object or shorthand struct with a times count.
	 */
	Effect function repeat( required any policy ) {
		return new Effect( {
			kind : "Repeat",
			effect : this,
			schedule : Schedule::coerce( arguments.policy )
		} );
	}

	/**
	 * Races the program against a Clock delay and a tagged TimeoutError; waits for loser cleanup.
	 *
	 * @duration Non-negative delay or elapsed amount in the supplied unit.
	 * @unit Time unit; defaults to milliseconds when omitted.
	 */
	Effect function timeout( required numeric duration, string unit = "milliseconds" ) {
		var sourceProgram = this;
		var timeoutDuration = arguments.duration;
		var timeoutUnit = arguments.unit;
		return Effect::race( [
			sourceProgram,
			Effect::sleep( timeoutDuration, timeoutUnit ).flatMap( () => Effect::fail( {
				_tag : "TimeoutError",
				duration : timeoutDuration,
				unit : timeoutUnit
			} ) )
		] );
	}

	/**
	 * Supplies a Context or Layer for this program and restores the previous Context afterward.
	 *
	 * @provisioning Context or Layer supplying local service bindings.
	 */
	Effect function provide( required any provisioning ) {
		if ( isContext( arguments.provisioning ) ) {
			return provideContext( arguments.provisioning );
		}
		if ( isLayer( arguments.provisioning ) ) {
			return arguments.provisioning.provide( this );
		}

		throw(
			type: "bxeffect.InvalidProvisionException",
			message: "Effect.provide() accepts a Context or Layer"
		);
	}

	/**
	 * Adds or overrides one service for this program only.
	 *
	 * @tag ServiceTag identifying the binding.
	 * @service Service implementation stored by reference.
	 */
	Effect function provideService( required ServiceTag tag, any service ) {
		return provideContext( Context::empty().add( arguments.tag, arguments.service ) );
	}

	/**
	 * Builds an internal Context merge/restoration boundary.
	 *
	 * @providedContext Context merged into the current bindings for the nested program.
	 */
	private Effect function provideContext( required Context providedContext ) {
		return new Effect( {
			kind : "ProvideContext",
			effect : this,
			context : arguments.providedContext
		} );
	}

	/**
	 * Copies the input array while retaining the immutable Effect references.
	 *
	 * @effects Input Effects; array order determines result and accumulated Cause order.
	 */
	private static array function copyEffects( required array effects ) {
		var copiedEffects = [];
		for ( var suppliedEffect in arguments.effects ) {
			copiedEffects.append( suppliedEffect );
		}
		return copiedEffects;
	}

	/**
	 * Validates concurrency and mode and fills the all defaults.
	 *
	 * @options concurrency: positive integer or unbounded (default); mode: failFast (default) or accumulate.
	 */
	private static struct function normalizeAllOptions( required struct options ) {
		var normalized = {
			concurrency : "unbounded",
			mode : "failFast"
		};
		for ( var optionName in arguments.options ) {
			if ( listFindNoCase( "concurrency,mode", optionName ) == 0 ) {
				throw(
					type: "bxeffect.InvalidAllOptionException",
					message: "Effect.all() does not support option [#optionName#]"
				);
			}
		}

		if ( structKeyExists( arguments.options, "concurrency" ) ) {
			var requestedConcurrency = arguments.options.concurrency;
			if ( requestedConcurrency != "unbounded" ) {
				if (
					!isNumeric( requestedConcurrency )
					|| requestedConcurrency <= 0
					|| requestedConcurrency != round( requestedConcurrency )
				) {
					throw(
						type: "bxeffect.InvalidConcurrencyException",
						message: "Effect.all() concurrency must be a positive integer or unbounded"
					);
				}
			}
			normalized.concurrency = requestedConcurrency;
		}

		if ( structKeyExists( arguments.options, "mode" ) ) {
			if ( !listFindNoCase( "failFast,accumulate", arguments.options.mode ) ) {
				throw(
					type: "bxeffect.InvalidAllModeException",
					message: "Effect.all() mode must be failFast or accumulate"
				);
			}
			normalized.mode = arguments.options.mode;
		}

		return normalized;
	}

	/**
	 * Captures one value and index so its mapper runs only during interpretation.
	 *
	 * @value Value carried by this operation; may be null.
	 * @index One-based input position retained across asynchronous completion.
	 * @mapper Callback receiving value and one-based index and returning an Effect.
	 */
	private static Effect function forEachProgram(
		required any value,
		required numeric index,
		required function mapper
	) {
		var valueToMap = arguments.value;
		var indexToMap = arguments.index;
		var mapperToRun = arguments.mapper;
		return Effect::suspend( () => mapperToRun( valueToMap, indexToMap ) );
	}

	/**
	 * Checks the internal structural contract used to recognize Context provisioning.
	 *
	 * @candidate Object checked against the internal structural contract.
	 */
	private static boolean function isContext( required any candidate ) {
		return isObject( arguments.candidate )
			&& structKeyExists( arguments.candidate, "add" )
			&& structKeyExists( arguments.candidate, "merge" )
			&& structKeyExists( arguments.candidate, "get" );
	}

	/**
	 * Checks the internal structural contract used to recognize Layer provisioning.
	 *
	 * @candidate Object checked against the internal structural contract.
	 */
	private static boolean function isLayer( required any candidate ) {
		return isObject( arguments.candidate )
			&& structKeyExists( arguments.candidate, "build" )
			&& structKeyExists( arguments.candidate, "provide" );
	}

	/**
	 * Exposes the instruction to the interpreter; internal callers must treat it as read-only.
	 */
	struct function instructionNode() {
		return variables.instruction;
	}

	/**
	 * Executes immediately with a new runtime and waits for root cleanup.
	 *
	 * @effect Effect to execute at this runtime boundary.
	 */
	static any function runSyncExit( required Effect effect ) {
		return new EffectRuntime().runSyncExit( arguments.effect );
	}

	/**
	 * Starts execution on a new runtime without blocking the caller.
	 *
	 * @effect Effect to execute at this runtime boundary.
	 */
	static BoxFuture function runFuture( required Effect effect ) {
		return new EffectRuntime().runFuture( arguments.effect );
	}

	/**
	 * Starts execution on a new runtime without blocking the caller.
	 *
	 * @effect Effect to execute at this runtime boundary.
	 */
	static BoxFuture function runFutureExit( required Effect effect ) {
		return new EffectRuntime().runFutureExit( arguments.effect );
	}

	/**
	 * Starts an owned root execution on a new runtime.
	 *
	 * @effect Effect to execute at this runtime boundary.
	 */
	static Fiber function runFork( required Effect effect ) {
		return new EffectRuntime().runFork( arguments.effect );
	}

	/**
	 * Executes immediately and unwraps success; a failed Exit throws EffectFailureException.
	 *
	 * @effect Effect to execute at this runtime boundary.
	 */
	static any function runSync( required Effect effect ) {
		return new EffectRuntime().runSync( arguments.effect );
	}

}
