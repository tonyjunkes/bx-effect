<bx:script>
import models.effect.Effect@bxEffect;
import models.effect.context.Context@bxEffect;
import models.effect.context.ServiceTag@bxEffect;
import benchmarks.BenchmarkSupport;

lookupIterations = 100000;
scopeIterations = 10000;
label = ServiceTag::of( "benchmark/Label" );
benchmarkContext = Context::empty().add( label, "value" );

lookupMeasurement = BenchmarkSupport::measure( () => {
	var lookupValue = null;
	for ( var lookupIndex = 1; lookupIndex <= lookupIterations; lookupIndex++ ) {
		lookupValue = benchmarkContext.get( label );
	}
	return lookupValue;
} );

provisionProgram = Effect::service( label ).provideService( label, "value" );
provisionMeasurement = BenchmarkSupport::measure( () => {
	var provisionValue = null;
	for ( var provisionIndex = 1; provisionIndex <= scopeIterations; provisionIndex++ ) {
		provisionValue = Effect::runSync( provisionProgram );
	}
	return provisionValue;
} );

releases = 0;
scopeProgram = Effect::succeed( null );
resourceProgram = Effect::acquireRelease(
	Effect::succeed( "resource" ),
	( ignored ) => Effect::sync( () => releases++ )
).asVoid();
for ( index = 1; index <= scopeIterations; index++ ) {
	scopeProgram = scopeProgram.flatMap( ( ignored ) => resourceProgram );
}

scopeMeasurement = BenchmarkSupport::measure( () => Effect::runSync( scopeProgram ) );

if (
	lookupMeasurement.value != "value"
	|| provisionMeasurement.value != "value"
	|| releases != scopeIterations * 6
) {
	throw(
		type: "BXEffect.BenchmarkFailure",
		message: "Expected Context lookups, provisions, and Scope releases to complete correctly"
	);
}

writeOutput(
	"samples=5 lookupIterations=#lookupIterations# lookupMinMs=#lookupMeasurement.minimumMs# lookupMedianMs=#lookupMeasurement.medianMs# provisionIterations=#scopeIterations# provisionMinMs=#provisionMeasurement.minimumMs# provisionMedianMs=#provisionMeasurement.medianMs# scopeIterations=#scopeIterations# scopeMinMs=#scopeMeasurement.minimumMs# scopeMedianMs=#scopeMeasurement.medianMs#"
);
</bx:script>
