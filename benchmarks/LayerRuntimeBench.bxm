<bx:script>
import models.effect.Effect@bxEffect;
import models.effect.context.Layer@bxEffect;
import models.effect.context.ServiceTag@bxEffect;
import java.util.concurrent.atomic.AtomicInteger;
import benchmarks.BenchmarkSupport;

branches = 128;
repository = ServiceTag::of( "benchmark/Repository" );
builds = new AtomicInteger( 0 );
shared = Layer::effect(
	repository,
	Effect::sync( () => {
		builds.incrementAndGet();
		return "repository";
	} )
);
programs = [];
for ( index = 1; index <= branches; index++ ) {
	programs.append( Effect::service( repository ).provide( shared ) );
}

measurement = BenchmarkSupport::measure( () => Effect::runSync( Effect::all( programs ) ) );
result = measurement.value;

if ( result.len() != branches || builds.get() != 6 ) {
	throw(
		type: "BXEffect.BenchmarkFailure",
		message: "Expected #branches# results and one shared build per run; got #result.len()# results and #builds.get()# builds"
	);
}

writeOutput(
	"executor=io-tasks branches=#branches# runs=6 samples=5 minimumMs=#measurement.minimumMs# medianMs=#measurement.medianMs#"
);
</bx:script>
