<bx:script>
import models.effect.Effect@bxeffect;
import benchmarks.BenchmarkSupport;

iterations = 64;
delayMs = 25;
programs = [];
for ( index = 1; index <= iterations; index++ ) {
	programs.append( Effect::sleep( delayMs ).as( index ) );
}

measurement = BenchmarkSupport::measure( () => Effect::runSync( Effect::all( programs ) ) );
result = measurement.value;

if ( result.len() != iterations || measurement.minimumMs < delayMs - 1 ) {
	throw(
		type: "bxeffect.benchmarks.BenchmarkFailureException",
		message: "Expected #iterations# results after at least #delayMs# ms; received #result.len()# in #measurement.minimumMs# ms"
	);
}

writeOutput(
	"iterations=#iterations# delayMs=#delayMs# samples=5 minimumMs=#measurement.minimumMs# medianMs=#measurement.medianMs#"
);
</bx:script>
