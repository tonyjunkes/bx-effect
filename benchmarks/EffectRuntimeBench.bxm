<bx:script>
import models.effect.Effect@bxeffect;
import benchmarks.BenchmarkSupport;

iterations = 100000;

directMeasurement = BenchmarkSupport::measure( () => {
	var result = 0;
	for ( var directIndex = 1; directIndex <= iterations; directIndex++ ) {
		result++;
	}
	return result;
} );

mapProgram = Effect::succeed( 0 );
for ( index = 1; index <= iterations; index++ ) {
	mapProgram = mapProgram.map( value => value + 1 );
}

mapMeasurement = BenchmarkSupport::measure( () => Effect::runSync( mapProgram ) );

flatMapProgram = Effect::succeed( 0 );
for ( index = 1; index <= iterations; index++ ) {
	flatMapProgram = flatMapProgram.flatMap( value => Effect::succeed( value + 1 ) );
}

flatMapMeasurement = BenchmarkSupport::measure( () => Effect::runSync( flatMapProgram ) );

scopeDepth = 5000;
scopedProgram = Effect::succeed( scopeDepth );
for ( index = 1; index <= scopeDepth; index++ ) {
	scopedProgram = Effect::scoped( scopedProgram );
}
scopeMeasurement = BenchmarkSupport::measure( () => Effect::runSync( scopedProgram ) );

if (
	directMeasurement.value != iterations
	|| mapMeasurement.value != iterations
	|| flatMapMeasurement.value != iterations
	|| scopeMeasurement.value != scopeDepth
) {
	throw(
		type: "bxeffect.benchmarks.BenchmarkFailureException",
		message: "Unexpected direct, map, flatMap, or nested Scope benchmark result"
	);
}

writeOutput(
	"iterations=#iterations# samples=5 directMinMs=#directMeasurement.minimumMs# directMedianMs=#directMeasurement.medianMs# mapMinMs=#mapMeasurement.minimumMs# mapMedianMs=#mapMeasurement.medianMs# flatMapMinMs=#flatMapMeasurement.minimumMs# flatMapMedianMs=#flatMapMeasurement.medianMs# scopeDepth=#scopeDepth# scopeMinMs=#scopeMeasurement.minimumMs# scopeMedianMs=#scopeMeasurement.medianMs#"
);
</bx:script>
