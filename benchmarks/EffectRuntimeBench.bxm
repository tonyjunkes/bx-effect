<bx:script>
import models.effect.Effect@bxEffect;
import java.lang.System;

iterations = 100000;

directStartedAt = System.nanoTime();
directResult = 0;
for ( index = 1; index <= iterations; index++ ) {
	directResult++;
}
directElapsedMs = int( ( System.nanoTime() - directStartedAt ) / 1000000 );

mapProgram = Effect::succeed( 0 );
for ( index = 1; index <= iterations; index++ ) {
	mapProgram = mapProgram.map( value => value + 1 );
}

mapStartedAt = System.nanoTime();
mapResult = Effect::runSync( mapProgram );
mapElapsedMs = int( ( System.nanoTime() - mapStartedAt ) / 1000000 );

flatMapProgram = Effect::succeed( 0 );
for ( index = 1; index <= iterations; index++ ) {
	flatMapProgram = flatMapProgram.flatMap( value => Effect::succeed( value + 1 ) );
}

flatMapStartedAt = System.nanoTime();
flatMapResult = Effect::runSync( flatMapProgram );
flatMapElapsedMs = int( ( System.nanoTime() - flatMapStartedAt ) / 1000000 );

if (
	directResult != iterations
	|| mapResult != iterations
	|| flatMapResult != iterations
) {
	throw(
		type: "BXEffect.BenchmarkFailure",
		message: "Expected direct, map, and flatMap results to equal #iterations#"
	);
}

writeOutput(
	"iterations=#iterations# directMs=#directElapsedMs# mapMs=#mapElapsedMs# flatMapMs=#flatMapElapsedMs#"
);
</bx:script>
