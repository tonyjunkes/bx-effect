<bx:script>
import models.effect.Effect@bxeffect;
import benchmarks.BenchmarkSupport;

values = [];
for ( index = 1; index <= 10000; index++ ) { values.append( index ); }
nativeMeasurement = BenchmarkSupport::measure( () => {
	var total = 0;
	for ( var value in values ) { total += value; }
	return total;
} );
sequentialMeasurement = BenchmarkSupport::measure( () => Effect::runSync(
	Effect::forEach( values, ( value, index ) => Effect::succeed( value ) )
) );
if ( nativeMeasurement.value != 50005000 || sequentialMeasurement.value != values ) {
	throw( type: "bxeffect.benchmarks.BenchmarkFailureException", message: "Sequential collection benchmark changed output" );
}
writeOutput( "items=10000 nativeMedianMs=#nativeMeasurement.medianMs# sequentialMedianMs=#sequentialMeasurement.medianMs# samples=5 " );

// Immediate work exposes completion-selection cost without client I/O variance.
programs = [];
for ( index = 1; index <= 1000; index++ ) { programs.append( Effect::succeed( index ) ); }
for ( limit in [ 1, 8, 32, 128, "unbounded" ] ) {
	measurement = BenchmarkSupport::measure( () => Effect::runSync(
		Effect::all( programs, { concurrency: limit } )
	) );
	if ( measurement.value.len() != 1000 || measurement.value[ 1 ] != 1 || measurement.value[ 1000 ] != 1000 ) {
		throw( type: "bxeffect.benchmarks.BenchmarkFailureException", message: "Concurrent collection benchmark changed output" );
	}
	writeOutput( "items=1000 concurrency=#limit# medianMs=#measurement.medianMs# samples=5 " );
}
</bx:script>
