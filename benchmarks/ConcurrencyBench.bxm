<bx:script>
import models.effect.Effect@bxEffect;
import benchmarks.BenchmarkSupport;

delayMs = 20;
sizes = [ 1, 8, 64, 256 ];

for ( size in sizes ) {
	programs = [];
	for ( index = 1; index <= size; index++ ) {
		programs.append( Effect::sleep( delayMs ).as( index ) );
	}

	measurement = BenchmarkSupport::measure(
		() => Effect::runSync( Effect::all( programs, { concurrency: "unbounded" } ) )
	);
	result = measurement.value;
	if ( result.len() != size ) {
		throw(
			type: "BXEffect.BenchmarkFailure",
			message: "Expected #size# concurrent results but received #result.len()#"
		);
	}
	writeOutput( "size=#size# delayMs=#delayMs# samples=5 minimumMs=#measurement.minimumMs# medianMs=#measurement.medianMs# " );
}
</bx:script>
