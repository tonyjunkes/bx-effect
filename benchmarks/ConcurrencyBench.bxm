<bx:script>
import models.effect.Effect@bxEffect;
import java.lang.System;

delayMs = 20;
sizes = [ 1, 8, 64, 256 ];

for ( size in sizes ) {
	programs = [];
	for ( index = 1; index <= size; index++ ) {
		programs.append( Effect::sleep( delayMs ).as( index ) );
	}

	startedAt = System.nanoTime();
	result = Effect::runSync( Effect::all( programs, { concurrency: "unbounded" } ) );
	elapsedMs = int( ( System.nanoTime() - startedAt ) / 1000000 );
	if ( result.len() != size ) {
		throw(
			type: "BXEffect.BenchmarkFailure",
			message: "Expected #size# concurrent results but received #result.len()#"
		);
	}
	writeOutput( "size=#size# delayMs=#delayMs# elapsedMs=#elapsedMs# " );
}
</bx:script>
