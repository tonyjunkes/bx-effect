{
    "name":"BX Effect",
    "version":"1.0.0",
    "location":"",
    "author":"Tony Junkes",
    "homepage":"https://github.com/tonyjunkes/bx-effect",
    "documentation":"https://github.com/tonyjunkes/bx-effect",
    "bugs": "https://github.com/tonyjunkes/bx-effect/issues",
    "repository":{
        "type":"git",
        "URL":"https://github.com/tonyjunkes/bx-effect"
    },
    "changelog": "https://github.com/tonyjunkes/bx-effect/blob/main/CHANGELOG.md",
    "slug":"bx-effect",
    "shortDescription":"A structured effect system for BoxLang, inspired by Effect.",
    "description": "BX Effect is a BoxLang module for combining operations such as HTTP requests, database queries, and file processing into reusable programs. Define the work, choose how failures should be handled, and run it synchronously or asynchronously.",
    "type":"boxlang-modules",
    "keywords":[
        "boxlang",
        "effects",
        "structured-concurrency",
        "functional-programming"
    ],
    "boxlang":{
        "minimumVersion":"1.16.0",
        "moduleName":"bxeffect"
    },
    "private":false,
    "license":[
        {
            "type":"MIT",
            "URL":"https://opensource.org/licenses/MIT"
        }
    ],
    "scripts":{
        "test":"boxlang cli --bx-home .boxlang/test --bx-config tests/boxlang.json testbox/system/runners/BoxLangRunner.bx --directory=tests.specs --stream --write-report=false --properties-summary=false --stacktrace=short"
    },
    "devDependencies":{
        "testbox":"^7.1.0-snapshot"
    },
    "installPaths":{
        "testbox":"testbox/"
    },
    "ignore":[
        "**/.*",
        "build/**",
        "settings.gradle",
        "gradlew.bat",
        "gradlew",
        "build.gradle",
        "src/**",
        "gradle/**",
        "tests/**",
        "testbox/**",
        "examples/**",
        "benchmarks/**",
        "docs/**",
        "AGENTS.md"
    ]
}
